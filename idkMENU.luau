    FARM.ui.weather = CWTab:Toggle({
        Title = "Auto Weather",
        Desc  = "Starts a radar event whenever it's ready.",
        Icon  = "cloud-lightning",
        Value = FARM.weather,
        Callback = function(on) FARM.weather = on if not on then FARM.status.weather = "Off" end end,
    })
    local WEATHER_BY_LABEL = { ["Best I can afford"] = "Best", ["Harvest Moon (250k)"] = "HarvestMoon", ["Cosmic (35k)"] = "Cosmic" }
    FARM.ui.weatherEvent = CWTab:Dropdown({
        Title  = "Weather Event",
        Values = { "Best I can afford", "Harvest Moon (250k)", "Cosmic (35k)" },
        Value  = "Best I can afford",
        Callback = function(v) if WEATHER_BY_LABEL[v] then FARM.weatherEvent = WEATHER_BY_LABEL[v] end end,
    })
    FARM.ui.weatherReserve = CWTab:Slider({
        Title = "Wood Chip Reserve",
        Value = { Min = 0, Max = 5000000, Default = FARM.weatherReserve },
        Step  = 5000,
