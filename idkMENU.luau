--=========================================================== Carve Wood frenzy
-- Auto Frenzy: fires the LumberShed clock's Gold (20x) or Rainbow (200x)
-- frenzy the moment it is ready, and nothing else - the Alien invasion and
-- other world events are left alone, and a paid (Robux) activation is never
-- reached: this only calls in while the clock says Ready.
--
-- The game's FrenzyClock:ActivateFocusedClock does AskServer("ActivateFrenzyClock",
-- {}) once LocalPlayer FrenzyClockReady is true, FrenzyClockPhase is GoldReady
-- or RainbowReady and no mode is running; the reply is {Success, Mode, Error}.
-- The server wants you within FrenzyConfig.Clock.ActivationMaxDistance (260)
-- of your clock, so if you are further out it takes the mover lock, hops over,
-- fires, and puts you back.
do
FARM.frenzy = false
FARM.status.frenzy = "Off"
FARM.stats.frenzies = 0
local FRENZY = { nextTry = 0 }

if CW.IN then
    local shared = game:GetService("ReplicatedStorage"):FindFirstChild("Shared")
    local ok, fc = pcall(function() return require(shared.FrenzyConfig) end)
    FRENZY.FC = ok and fc or nil
    ok, fc = pcall(function() return require(shared.AlienReactorConfig) end)
    FRENZY.AR = ok and fc or nil
end

function FRENZY.clock()
    local FC = FRENZY.FC
    local tag = FC and FC.Clock and FC.Clock.Tag or "LumberShedClockPresentation"
    local ownerAttr = FC and FC.Clock and FC.Clock.OwnerUserIdAttribute or "LumberShedClockOwnerUserId"
    for _, c in ipairs(CS:GetTagged(tag)) do
        if c:IsDescendantOf(workspace) and tonumber(c:GetAttribute(ownerAttr)) == LP.UserId then return c end
    end
    local ty = CW.tycoon()
    local r = ty and ty:FindFirstChild("TycoonRoot")
    r = r and r:FindFirstChild("LumberShed")
    return r and r:FindFirstChild("Clock") or nil
end

local function frenzyLeft(attr)
    local t = tonumber(LP:GetAttribute(attr)) or 0
    return math.max(0, t - workspace:GetServerTimeNow())
end

local function mmss(s)
    s = math.floor(s)
    if s >= 3600 then return ("%dh %02dm"):format(s // 3600, (s % 3600) // 60) end
    return ("%dm %02ds"):format(s // 60, s % 60)
end

-- "GoldReady" / "RainbowReady" when one can be fired right now, else nil and why.
function FRENZY.ready()
    local mode = LP:GetAttribute("FrenzyActiveMode")
    if FRENZY.FC and FRENZY.FC.GetActiveMode then
        local ok, m = pcall(FRENZY.FC.GetActiveMode, LP)
        if ok then mode = m end
    end
    if mode and mode ~= "None" then
        return nil, ("%s frenzy running, %s left"):format(tostring(mode), mmss(frenzyLeft("FrenzyEndsAt")))
    end
    if FRENZY.AR and FRENZY.AR.IsInvasionActive then
        local ok, on = pcall(FRENZY.AR.IsInvasionActive, LP)
        if ok and on then return nil, "Alien invasion running, waiting" end
    end
    local phase = LP:GetAttribute("FrenzyClockPhase")
    if LP:GetAttribute("FrenzyClockReady") == true and (phase == "GoldReady" or phase == "RainbowReady") then
        return phase
    end
    local next = phase == "RainbowCharging" and "Rainbow" or "Gold"
    return nil, ("%s ready in %s"):format(next, mmss(frenzyLeft("FrenzyClockCountdownEndsAt")))
end

function FRENZY.pass()
    local phase, why = FRENZY.ready()
    if not phase then FARM.status.frenzy = why return end
    if os.clock() < FRENZY.nextTry then return end

    local rem = FARM.remote("ActivateFrenzyClock")
    if not (rem and rem:IsA("RemoteFunction")) then
        FARM.status.frenzy = "Frenzy remote not found"
        FRENZY.nextTry = os.clock() + 10
        return
    end
    local clock = FRENZY.clock()
    local r = root()
    if not (clock and r) then FARM.status.frenzy = "Clock not found" FRENZY.nextTry = os.clock() + 10 return end

    local kind = phase == "RainbowReady" and "Rainbow" or "Gold"
    local at = clock:GetPivot().Position
    local reach = (FRENZY.FC and FRENZY.FC.Clock and tonumber(FRENZY.FC.Clock.ActivationMaxDistance) or 260) - 30
    local far = (r.Position - at).Magnitude > reach
    local home
    if far then
        FARM.frenzyWantsMove = true         -- tells Auto Roll to step aside
        local got = FARM.acquire("frenzy", 3)
        FARM.frenzyWantsMove = false
        if not got then FARM.status.frenzy = kind .. " ready, waiting for the farm" return end
        home = r.CFrame
        local flat = Vector3.new(r.Position.X - at.X, 0, r.Position.Z - at.Z)
        local dir = flat.Magnitude > 0.1 and flat.Unit or Vector3.new(0, 0, 1)
        moveTo(at + dir * 15, at)
        task.wait(0.8)      -- let the server see the new position
    end

    FARM.status.frenzy = "Activating " .. kind .. " frenzy"
    local done, res = FARM.invoke(rem, {})
    if home and mine() then moveTo(home.Position, home.Position + home.LookVector) end
    if far then FARM.release("frenzy") end

    -- believe the attributes, not only the reply
    local t0 = os.clock()
    while (LP:GetAttribute("FrenzyActiveMode") or "None") == "None" and os.clock() - t0 < 2 do task.wait(0.1) end
    local mode = LP:GetAttribute("FrenzyActiveMode")
    if (type(res) == "table" and res.Success == true) or (mode and mode ~= "None") then
        FARM.stats.frenzies += 1
        FARM.status.frenzy = (type(res) == "table" and tostring(res.Mode or kind) or kind) .. " frenzy activated"
        FRENZY.nextTry = os.clock() + 5
        pcall(function()
            WindUI:Notify({ Title = "Auto Frenzy", Content = kind .. " frenzy activated", Duration = 4, Icon = "zap" })
        end)
    else
        local err = type(res) == "table" and res.Error or nil
        FARM.status.frenzy = "Refused" .. (err and (": " .. tostring(err)) or (done and "" or " (no reply)"))
        FRENZY.nextTry = os.clock() + 15
    end
end

if CW.IN then
    task.spawn(function()       -- 1 Hz
        while STATE.alive() and mine() do
            if FARM.frenzy then
                local ok, err = pcall(FRENZY.pass)
                if not ok then
                    FARM.release("frenzy")
                    FARM.status.frenzy = "Error: " .. tostring(err)
                    FRENZY.nextTry = os.clock() + 5
                end
            end
            task.wait(1)
        end
    end)
    STATE.onCleanup(function() FARM.frenzy = false end)
end
end -- frenzy

--=========================================================== target launch
-- Flies YOU into a player you pick, then flings them.
--
-- Two phases, and they want opposite things from collision. The approach is
-- flown non-colliding so walls and floors do not snag it. The fling then needs
-- contact, because contact is the only thing a fling is: momentum transferred
-- through the victim's character assembly. With no contact there is no
-- transfer and nothing lands on their client.
--
-- Why the numbers land on THEM and not only on us: their client owns their
-- character, so their client is the one resolving the overlap, and whatever
-- velocity it computes is what it replicates onward to everyone else. All we
-- have to be is a heavy, fast-spinning object inside them for long enough that
-- a few network snapshots of that state reach them - which is why `contact` is
-- a window in seconds and not a single frame.
local LAUNCH = {
    speed     = 300,
    minSpeed  = 80,
    maxSpeed  = 800,
    arrive    = 4,      -- studs from the target that counts as arrived
    timeout   = 4,      -- seconds before giving up
    maxPix    = 400,    -- how far from screen centre a target may sit
    selectKey = Enum.KeyCode.E,
    cancelKey = Enum.KeyCode.Q,
}

local FLING = {
    power       = 1200,   -- spin on our root during contact, rad/s
    minPower    = 100,
    maxPower    = 6000,
    lift        = 300,    -- upward studs/s we carry into them
    minLift     = 0,
    maxLift     = 900,
    contact     = 0.45,   -- seconds to hold the overlap
    minContact  = 0.1,
    maxContact  = 1.5,
    -- Sit this far under their root. A shove at the legs levers them upward;
    -- the same shove at the chest just skids them along the ground.
    lowOffset   = 1.6,
    -- 100 is the engine's density ceiling. Mass is momentum, so a heavy root
    -- hits harder for nothing.
    density     = 100,
}

