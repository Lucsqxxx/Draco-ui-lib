      Player tab   universal tools: No-clip + Fly, Target Fling.
      Games        one tab per game, built only where it applies:
                   MM2, Guess the Slapper, Jailbreak, Carve Wood, Decay,
                   Knife VS Gun DUELS, Chaos Canyon.
      Settings     binds, UI scale, and per-game presets.

       The menu is Mono's own glass UI, provided by DracoUI.luau; the
       application still talks to it through the historical WindUI-shaped API.

      Z                 show / hide the menu (rebindable in Settings)
      WASD              move (camera-relative)
      Space / LeftCtrl  up / down
      LeftAlt           boost
      E / Q             fling target / cancel (Target Fling on)
]]

local Players    = game:GetService("Players")
local RunService = game:GetService("RunService")
local UIS        = game:GetService("UserInputService")

-- Running from autoexec means this fires during the join, before the DataModel
-- has finished loading: Players.LocalPlayer is still nil and everything below
-- that touches it dies on the first line. Wait it out. Executing from the editor
-- mid-session passes straight through both of these.
if not game:IsLoaded() then game.Loaded:Wait() end

local LP = Players.LocalPlayer
while not LP do
    Players:GetPropertyChangedSignal("LocalPlayer"):Wait()
    LP = Players.LocalPlayer
end

--=========================================================== lifecycle
-- Generation stamp. Teardown is best-effort: if a previous run's connections
-- survive for any reason (it bound to a stale harness, an error skipped its
-- cleanup, the executor lost the reference), those handlers keep firing with
-- their own copy of the state. Two loops then fight over the same rig - one
-- attaches the movers while the other destroys them, which reads as "off but
-- still flying" and "on but falling through the floor". Every handler below
-- checks this, so a superseded run makes itself inert on its next tick instead
-- of needing to be reachable.
local GEN = (getgenv().__MonoGen or 0) + 1
getgenv().__MonoGen = GEN
local function mine() return getgenv().__MonoGen == GEN end

-- This script owns its own lifecycle rather than using the STATE that Real's
-- MCP live-reload injects. That global outlives the run it belonged to: after a
-- reload a stale STATE is still sitting there reporting alive() == true, and
-- binding to it means the next reload of that label disconnects this script's
-- connections out from under it. Rolling our own keeps the editor, autoexec and
-- live-reload paths identical, and the getgenv sentinel means running the file
-- twice tears the first copy down instead of stacking loops and movers.
local STATE
do
    local prev = getgenv().__MonoState
    if prev then pcall(prev.teardown) end

    local conns, cleanups, living = {}, {}, true
    STATE = {
        connect = function(signal, fn)
            local c = signal:Connect(fn)
            table.insert(conns, c)
            return c
        end,
        onCleanup = function(fn) table.insert(cleanups, fn) end,
        alive     = function() return living end,
        teardown  = function()
            living = false
            for _, fn in ipairs(cleanups) do pcall(fn) end
            for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
            table.clear(conns)
            table.clear(cleanups)
        end,
    }
    getgenv().__MonoState = STATE
end

