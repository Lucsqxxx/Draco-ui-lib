-- Decay: same shape as the other game setters. Toggles move through their
-- UI handles (Toggle:Set is reliable); sliders go through moveSlider.
getgenv().Mono.decay = function(t)
    if not DK.IN then return nil end
    t = t or {}
    if type(t.on) == "table" then
        for k, v in pairs(t.on) do
            if DK.on[k] ~= nil and type(v) == "boolean" then
                DK.on[k] = v
                if DK.ui[k] then pcall(function() DK.ui[k]:Set(v) end) end
            end
        end
    end
    if type(t.fov) == "number" then moveSlider(DK.ui.fov, math.clamp(t.fov, 30, 600), function(v) DK.fov = v end) end
    if type(t.smooth) == "number" then moveSlider(DK.ui.smooth, math.clamp(t.smooth, 0, 0.9), function(v) DK.smooth = v end) end
    if type(t.lootDist) == "number" then moveSlider(DK.ui.lootDist, math.clamp(t.lootDist, 50, 1500), function(v) DK.lootDist = v end) end
    if t.aimPart == "Head" or t.aimPart == "Body" then
        DK.aimPart = t.aimPart
        if DK.ui.aimPart then pcall(function() DK.ui.aimPart:Select(t.aimPart) end) end
    end
    local on = {}
    for k, v in pairs(DK.on) do on[k] = v end
    return { on = on, fov = DK.fov, smooth = DK.smooth, aimPart = DK.aimPart, lootDist = DK.lootDist,
             target = (function() local _, m, p = DK.target() return p and p.Name or (m and m:GetFullName()) end)() }
end

--=========================================================== presets
-- Named snapshots of a game tab's settings, saved to the executor's workspace
-- as Mono/presets/<GameId>.json:
--   { presets = { [name] = <config> }, autoload = "<name>" | nil }
-- One file per game, so a preset only ever loads into the game it came from.
-- Each game registers a provider: get() returns a plain table (JSON-safe:
-- strings, numbers, booleans, lists) and set(t) applies one, moving the
-- on-screen controls as well as the settings - the same rule as the Mono API.
-- A preset also records which features were switched on, so loading one puts
-- the menu back exactly as it was saved.
local PRESET = {
    dir       = "Mono/presets",
    providers = {},
    ui        = {},
    name      = "",         -- what is typed in the name box
    pick      = nil,        -- what is picked in the list
}

local function presetPath() return PRESET.dir .. "/" .. tostring(game.GameId) .. ".json" end

function PRESET.read()
    local ok, data = pcall(function()
        if not (isfile and isfile(presetPath())) then return nil end
        return game:GetService("HttpService"):JSONDecode(readfile(presetPath()))
    end)
    if ok and type(data) == "table" then
        data.presets = type(data.presets) == "table" and data.presets or {}
        return data
    end
    return { presets = {} }
end

function PRESET.write(data)
    return pcall(function()
        if makefolder then
            if not (isfolder and isfolder("Mono")) then makefolder("Mono") end
            if not (isfolder and isfolder(PRESET.dir)) then makefolder(PRESET.dir) end
        end
        writefile(presetPath(), game:GetService("HttpService"):JSONEncode(data))
    end)
end

function PRESET.provider() return PRESET.providers[game.GameId] end

function PRESET.names()
    local out = {}
    for n in pairs(PRESET.read().presets) do table.insert(out, n) end
    table.sort(out, function(a, b) return a:lower() < b:lower() end)
    return out
end

local function notify(text, icon)
    pcall(function() WindUI:Notify({ Title = "Presets", Content = text, Duration = 3, Icon = icon or "bookmark" }) end)
end

function PRESET.refreshList(select)
    local names = PRESET.names()
    if select then PRESET.pick = select end
    if PRESET.pick and not table.find(names, PRESET.pick) then PRESET.pick = nil end
    if PRESET.ui.rebuild then pcall(PRESET.ui.rebuild, names) end
    if PRESET.ui.info then
        local auto = PRESET.read().autoload
        pcall(function()
            PRESET.ui.info:SetDesc(("%d saved for this game.%s"):format(#names,
                auto and ("  Loads on start: " .. auto) or ""))
        end)
    end
    return names
end

function PRESET.save(name)
    local prov = PRESET.provider()
    name = tostring(name or ""):gsub("^%s+", ""):gsub("%s+$", "")
    if not prov then return false, "No presets for this game" end
    if name == "" then return false, "Type a name first" end
    local okGet, cfg = pcall(prov.get)
    if not okGet or type(cfg) ~= "table" then return false, "Could not read the settings" end
    local data = PRESET.read()
    data.presets[name] = cfg
    local ok, err = PRESET.write(data)
    if not ok then return false, "Could not write the file: " .. tostring(err) end
    PRESET.refreshList(name)
    return true
end

function PRESET.load(name)
    local prov = PRESET.provider()
    if not prov then return false, "No presets for this game" end
    local cfg = name and PRESET.read().presets[name]
    if type(cfg) ~= "table" then return false, "No preset called " .. tostring(name) end
    local ok, err = pcall(prov.set, cfg)
    if not ok then return false, "Could not apply it: " .. tostring(err) end
    return true
end

function PRESET.delete(name)
    local data = PRESET.read()
    if not (name and data.presets[name]) then return false, "Pick a preset first" end
    data.presets[name] = nil
    if data.autoload == name then data.autoload = nil end
    local ok, err = PRESET.write(data)
    if not ok then return false, "Could not write the file: " .. tostring(err) end
    PRESET.pick = nil
    PRESET.refreshList()
    return true
end

function PRESET.setAutoload(name)
    local data = PRESET.read()
    if name ~= nil and not data.presets[name] then return false, "Pick a preset first" end
    data.autoload = name
    local ok, err = PRESET.write(data)
    if not ok then return false, "Could not write the file: " .. tostring(err) end
    PRESET.refreshList()
    return true
end

--- providers -----------------------------------------------------------------------
local function setToList(set)
    local out = {}
    for k, v in pairs(set) do if v then table.insert(out, k) end end
    table.sort(out)
    return out
end

if CW.IN then
    PRESET.providers[CW_UNIVERSE] = {
        get = function()
            return {
                autoRoll  = CW.on,
                rarities  = setToList(CW.want),
                grabMega  = CW.grabMega,
                grabNew   = CW.grabNew,
                plant     = FARM.plant,
                plantSel  = setToList(FARM.plantSel),
                chop      = FARM.chop,
                swing     = FARM.swing,
                carve     = FARM.carve,
                carveSel  = setToList(FARM.carveSel),
                carveMega = FARM.carveMega,
                carveMut  = FARM.carveMut,
                paint     = FARM.paint,
                handCarve = FARM.handCarve,
                chips     = FARM.chips,
                buySel    = setToList(FARM.buySel),
                buyMax    = FARM.buyMax,
                buyReserve = FARM.buyReserve,
                buyMaxReroll = FARM.buyMaxReroll,
                stock     = FARM.stock,
                weather   = FARM.weather,
                weatherEvent = FARM.weatherEvent,
                weatherReserve = FARM.weatherReserve,
                paintRefill = FARM.paintRefill,
                paintRefillBelow = FARM.paintRefillBelow,
                sprinkler = FARM.sprinkler,
                energy    = FARM.energy,
                collect   = FARM.collect,
                collectRange = FARM.collectRange,
                plantMega = FARM.plantMega,
                frenzy    = FARM.frenzy,
                water     = FARM.water,
                deliver   = FARM.deliver,
                waterSel  = (function() local o = {} for m in pairs(FARM.waterSel) do table.insert(o, m) end table.sort(o) return o end)(),
                upkeep    = FARM.upkeep,
                fert      = FARM.fert,
                fertSel   = setToList(FARM.fertSel),
                canCollect = FARM.canCollect,
                canAt     = FARM.canAt,
                fertCollect = FARM.fertCollect,
                fertAt    = FARM.fertAt,
                shop      = FARM.shop,
                shopReserve = FARM.shopReserve,
                ship      = FARM.ship,
            }
        end,
        set = function(t)
            -- selections and options first, switches last, so nothing starts
            -- running on a half-applied preset
            local want = {}
            for _, r in ipairs(CW.rarities) do want[r] = false end
            for _, r in ipairs(t.rarities or {}) do if want[r] ~= nil then want[r] = true end end
            getgenv().Mono.carve({ want = want, mega = t.grabMega, new = t.grabNew })
            getgenv().Mono.farm({
                plantSel = t.plantSel or {}, carveSel = t.carveSel or {},
                carveMega = t.carveMega, carveMut = t.carveMut,
                plantMega = t.plantMega ~= false,
                waterSel = t.waterSel or {},
                fertSel = t.fertSel or {}, canAt = t.canAt, fertAt = t.fertAt,
            })
            if type(t.swing) == "number" then
                local v = math.clamp(t.swing, 0.45, 1.5)
                if FARM.ui.swing then moveSlider(FARM.ui.swing, v, function(x) FARM.swing = x end) else FARM.swing = v end
            end
            if type(t.shopReserve) == "number" then
                local v = math.clamp(t.shopReserve, 0, 100000)
                if FARM.ui.shopReserve then moveSlider(FARM.ui.shopReserve, v, function(x) FARM.shopReserve = x end) else FARM.shopReserve = v end
            end
            if type(t.collectRange) == "number" then
                local v = math.clamp(t.collectRange, 25, 1000)
                if FARM.ui.collectRange then moveSlider(FARM.ui.collectRange, v, function(x) FARM.collectRange = x end) else FARM.collectRange = v end
            end
            if type(t.weatherReserve) == "number" then
                local v = math.clamp(t.weatherReserve, 0, 5000000)
                if FARM.ui.weatherReserve then moveSlider(FARM.ui.weatherReserve, v, function(x) FARM.weatherReserve = x end) else FARM.weatherReserve = v end
            end
            if type(t.paintRefillBelow) == "number" then
                local v = math.clamp(t.paintRefillBelow, 0.25, 20)
                if FARM.ui.refillBelow then moveSlider(FARM.ui.refillBelow, v * 100, function(x) FARM.paintRefillBelow = x / 100 end) end
                FARM.paintRefillBelow = v
            end
            if type(t.weatherEvent) == "string" then getgenv().Mono.farm({ weatherEvent = t.weatherEvent }) end
            -- Gem Store Auto Buy: picks and limits only; it is never switched on by a preset
            getgenv().Mono.farm({ buySel = type(t.buySel) == "table" and t.buySel or {}, buyMax = type(t.buyMax) == "table" and t.buyMax or nil })
            if type(t.buyMax) == "table" then
                for id, sl in pairs(FARM.ui.buyMaxSlider or {}) do
                    local v = tonumber(t.buyMax[id])
                    if v and v ~= sl.Value then moveSlider(sl, FARM.buyMax[id], function(x) FARM.buyMax[id] = x end) end
                end
            end
            if type(t.buyReserve) == "number" then
                local v = math.clamp(t.buyReserve, 0, 100000)
                if FARM.ui.buyReserve then moveSlider(FARM.ui.buyReserve, v, function(x) FARM.buyReserve = x end) else FARM.buyReserve = v end
            end
            if type(t.buyMaxReroll) == "number" then
                local v = math.clamp(t.buyMaxReroll, 100, 100000)
                if FARM.ui.buyMaxReroll then moveSlider(FARM.ui.buyMaxReroll, v, function(x) FARM.buyMaxReroll = x end) else FARM.buyMaxReroll = v end
            end
            getgenv().Mono.farm({ plant = t.plant == true, chop = t.chop == true, carve = t.carve == true, collect = t.collect == true, frenzy = t.frenzy == true, water = t.water == true, deliver = t.deliver == true,
                -- presets saved before Auto Upkeep existed: their Auto Water still runs
                upkeep = (t.upkeep == nil and t.water == true) or t.upkeep == true,
                fert = t.fert == true, canCollect = t.canCollect == true, fertCollect = t.fertCollect == true,
                -- presets saved before these existed keep the defaults (on)
                shop = t.shop ~= false, ship = t.ship ~= false, paint = t.paint == true, handCarve = t.handCarve == true, stock = t.stock == true,
                weather = t.weather == true, paintRefill = t.paintRefill == true, sprinkler = t.sprinkler == true, energy = t.energy == true,
                chips = t.chips == true })
            getgenv().Mono.carve({ on = t.autoRoll == true })
        end,
    }

    -- Pause All: one key (or the button) turns every Carve Wood automation off
    -- and remembers which were on; the next press turns exactly those back on.
    -- Picks, sliders and other settings are left alone either way. Shop / Ship
    -- are part of Auto Deliver and stop with it, so they are not touched.
    local PAUSE = { paused = false, saved = nil }
    local PAUSE_SWITCHES = { "plant", "chop", "carve", "collect", "frenzy", "water", "deliver", "upkeep",
                             "fert", "canCollect", "fertCollect", "paint", "handCarve", "stock",
                             "weather", "paintRefill", "sprinkler", "energy", "chips", "buy" }

    local function pauseNotify(text, icon)
        pcall(function() WindUI:Notify({ Title = "Carve Wood", Content = text, Duration = 3, Icon = icon }) end)
    end

    function PAUSE.set(paused)
        if paused == PAUSE.paused then return PAUSE.paused end
        if paused then
            local s = { autoRoll = CW.on == true }
            local off = {}
            for _, k in ipairs(PAUSE_SWITCHES) do s[k] = FARM[k] == true off[k] = false end
            PAUSE.saved = s
            getgenv().Mono.farm(off)
            getgenv().Mono.carve({ on = false })
            PAUSE.paused = true
            local n = 0 for _, v in pairs(s) do if v then n += 1 end end
            pauseNotify(("Paused %d automation%s. Press again to resume."):format(n, n == 1 and "" or "s"), "pause")
        else
            local s = PAUSE.saved or {}
            local on = {}
            for _, k in ipairs(PAUSE_SWITCHES) do on[k] = s[k] == true end
            getgenv().Mono.farm(on)
            getgenv().Mono.carve({ on = s.autoRoll == true })
            PAUSE.paused, PAUSE.saved = false, nil
            pauseNotify("Resumed.", "play")
        end
        return PAUSE.paused
    end

    -- the key and button live on the Overview page
    PAUSE.bind = FARM.ui.pauseBind
    FARM.togglePause = function() PAUSE.set(not PAUSE.paused) end

    STATE.connect(UIS.InputBegan, function(input, busy)
        if not mine() or busy or not PAUSE.bind or PAUSE.bind.Picking then return end
        if UIS:GetFocusedTextBox() then return end
        if (Bind and Bind.Picking) or (MenuKeyBind and MenuKeyBind.Picking) then return end
        local want = PAUSE.bind.Value
        if type(want) ~= "string" or want == "" then return end
        local name = input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode.Name or input.UserInputType.Name
        if name == want then PAUSE.set(not PAUSE.paused) end
    end)

    getgenv().Mono.pause = function(p)
        if p ~= nil then PAUSE.set(p == true) end
        return { paused = PAUSE.paused, saved = PAUSE.saved }
    end
end

