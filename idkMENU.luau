--=========================================================== frontend
-- The reusable glass frontend lives in DracoUI.luau. This application keeps
-- its historical WindUI-shaped calls so its feature callbacks remain separate
-- from the library implementation.
--=========================================================== UI library
-- The original application owns game logic below; DracoUI owns the reusable
-- window, navigation, controls, notifications, and lifecycle implementation.
local DracoUI = require(script.Parent:WaitForChild("DracoUI"))
local WindUI = DracoUI

local themeName = "Mono"

--=========================================================== state
local CFG = {
    speed    = 80,
    minSpeed = 10,
    maxSpeed = 400,
    boostMul = 2.5,
    accel    = 12,
    boostKey = Enum.KeyCode.LeftAlt,
    upKey    = Enum.KeyCode.Space,
    downKey  = Enum.KeyCode.LeftControl,
}

-- Two flags, deliberately separate: `wanted` is what the user asked for,
-- `attached` is whether the movers are actually on a rig. Blade Ball cycles
-- characters between rounds, so a request can arrive while there is no rig to
-- attach to. Keeping the intent lets the loop below attach as soon as one
-- exists, instead of silently dropping the request.
local wanted   = false
local attached = false
local speed    = CFG.speed
local bindMode = "Toggle"       -- "Toggle" | "Hold"
local vel      = Vector3.zero
local bv, bg   = nil, nil
local hrp, hum = nil, nil
local collided = {}             -- part -> original CanCollide

--=========================================================== rig
local function grab()
    local c = LP.Character
    if not c then return false end
    hrp = c:FindFirstChild("HumanoidRootPart")
    hum = c:FindFirstChildOfClass("Humanoid")
    return hrp ~= nil and hum ~= nil
end

local function restoreCollision()
    for part, was in pairs(collided) do
        if part and part.Parent then
            pcall(function() part.CanCollide = was end)
        end
    end
    table.clear(collided)
end

local function applyNoclip()
    local c = LP.Character
    if not c then return end
    for _, d in ipairs(c:GetDescendants()) do
        if d:IsA("BasePart") and d.CanCollide then
            if collided[d] == nil then collided[d] = d.CanCollide end
            d.CanCollide = false
        end
    end
end

local function detach()
    if bv then bv:Destroy() bv = nil end
    if bg then bg:Destroy() bg = nil end
    if hum and hum.Parent then hum.PlatformStand = false end
    restoreCollision()
    vel = Vector3.zero
end

local function attach()
    if not grab() then return false end
    detach()

    bv = Instance.new("BodyVelocity")
    bv.Name     = "FlyVelocity"
    bv.MaxForce = Vector3.one * 9e9
    bv.Velocity = Vector3.zero
    bv.Parent   = hrp

    bg = Instance.new("BodyGyro")
    bg.Name      = "FlyGyro"
    bg.MaxTorque = Vector3.one * 9e9
    bg.P         = 9e4
    bg.D         = 500
    bg.CFrame    = hrp.CFrame
    bg.Parent    = hrp

    hum.PlatformStand = true
    return true
end

-- Recover from a messy prior state. An orphaned run can leave its movers on the
-- rig and PlatformStand set, which looks exactly like "I turned it off and I am
-- still flying". Strip anything we recognise as ours before building the UI so a
-- fresh load always starts from a sane rig. CanCollide is deliberately left
-- alone: the original values are not knowable from here, and a respawn restores
-- them anyway.
local function sweepLeftovers()
    local c = LP and LP.Character
    if not c then return end
    for _, d in ipairs(c:GetDescendants()) do
        if (d:IsA("BodyVelocity") and d.Name == "FlyVelocity")
        or (d:IsA("BodyGyro")     and d.Name == "FlyGyro") then
            pcall(function() d:Destroy() end)
        end
    end
    local h = c:FindFirstChildOfClass("Humanoid")
    if h then pcall(function() h.PlatformStand = false end) end
end
sweepLeftovers()

--=========================================================== role ESP (MM2)
-- Murder Mystery 2 keeps roles out of Teams: every player reports TeamColor
-- White all round.
--
-- Reading the roles off the tools - the murderer's Knife, the sheriff's Gun -
-- works, but it is LATE: a holstered tool is not reliably visible to us, so in
-- practice the role only resolves once its owner draws the weapon.
--
-- The round table is the real source. The server replicates one entry per
-- player to every client over Remotes.Gameplay.PlayerDataChanged - Role,
-- UserId, Dead, Perk, and which skins they have equipped - and it arrives when
-- roles are ASSIGNED, before anyone has drawn anything. Remotes.Gameplay
-- .GetCurrentPlayerData returns the same table on demand, which is what primes
-- this when the menu is loaded mid-round.
--
-- Indexed by UserId rather than by the table's own keys: it is keyed by player
-- name, but a live round was observed carrying a junk key ("4378f305828e08935o6")
-- that matched nobody, while every entry's UserId field was sound.
local MM2_UNIVERSE = 66654135

-- Every role MM2 can hand out, not just the Classic three. Special rounds swap
-- the whole role set - Infection runs Survivor/Zombie, FreezeTag runs
-- Freezer/Runner - and the round table reports those names verbatim. Covering
-- only the Classic three meant a lookup miss on a special round, which reached
-- Highlight.FillColor as nil and threw. Colours follow the game's own
-- Game/RoleSelector so the outlines agree with its role card.
local ROLE_COLOR = {
    Murderer = Color3.fromRGB(255,  55,  55),   -- red
    Sheriff  = Color3.fromRGB( 55, 130, 255),   -- blue
    Innocent = Color3.fromRGB( 70, 220, 110),   -- green
    Zombie   = Color3.fromRGB( 25, 172,   0),   -- deep green
    Survivor = Color3.fromRGB( 43, 154, 238),   -- light blue
    Freezer  = Color3.fromRGB(150, 220, 250),   -- ice
    Runner   = Color3.fromRGB(255, 190,  60),   -- amber
}

-- Anything the game adds later still gets an outline rather than an error.
local ROLE_FALLBACK = Color3.fromRGB(200, 200, 205)

local espOn      = false
local highlights = {}       -- player -> Highlight
local espFolder

local roundRole = {}        -- UserId -> "Murderer" | "Sheriff" | "Innocent"
local roundDead = {}        -- UserId -> boolean
local roundSeen = false     -- has a round table ever landed

-- Entries also carry `Killed`, which is NOT used here: in a full round table
-- every player read Killed=false including ones who had made kills, so whether
-- it means "was killed" or "has killed" is unsettled and guessing wrong would
-- grey out live players. `Dead` was unambiguous, and Humanoid.Health backs it up.
local function ingestRoundData(data)
    if type(data) ~= "table" then return false end
    local any = false
    local role, dead = {}, {}
    for _, v in pairs(data) do
        if type(v) == "table" and type(v.UserId) == "number" and type(v.Role) == "string" then
            role[v.UserId] = v.Role
            dead[v.UserId] = v.Dead == true
            any = true
        end
    end
    if not any then return false end
    roundRole, roundDead, roundSeen = role, dead, true
    return true
end

local function hasTool(container, name)
    return container ~= nil and container:FindFirstChild(name) ~= nil
end

local function roleOf(p)
    local known = roundRole[p.UserId]

    -- The tools still get a say, but only ever to UPGRADE an innocent. A gun
    -- dropped by a dead sheriff and picked up by an innocent leaves the round
    -- table saying Innocent while the player is, for every purpose this ESP
    -- exists to serve, armed.
    local bp, c = p:FindFirstChildOfClass("Backpack"), p.Character
    if known == nil or known == "Innocent" then
        if hasTool(bp, "Knife") or hasTool(c, "Knife") then return "Murderer" end
        if hasTool(bp, "Gun")   or hasTool(c, "Gun")   then return "Sheriff"  end
    end

    return known or "Innocent"
end

local function clearESP()
    for p, hl in pairs(highlights) do
        pcall(function() hl:Destroy() end)
        highlights[p] = nil
    end
    if espFolder then pcall(function() espFolder:Destroy() end) espFolder = nil end
end

local function refreshESP()
    if not espOn then return end

    if not (espFolder and espFolder.Parent) then
        espFolder = Instance.new("Folder")
        espFolder.Name = "MonoESP"
        -- gethui keeps it out of the game's own CoreGui sweeps where available
        espFolder.Parent = (gethui and gethui()) or game:GetService("CoreGui")
    end

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP then
            local c  = p.Character
            local hl = highlights[p]

            local hum  = c and c:FindFirstChildOfClass("Humanoid")
            local alive = hum == nil or hum.Health > 0

            if c and c:FindFirstChildWhichIsA("BasePart") then
                if not (hl and hl.Parent) then
                    hl = Instance.new("Highlight")
                    -- AlwaysOnTop is what makes this read through walls
                    hl.DepthMode           = Enum.HighlightDepthMode.AlwaysOnTop
                    hl.OutlineTransparency = 0
                    hl.Parent              = espFolder
                    highlights[p]          = hl
                end
                local col = ROLE_COLOR[roleOf(p)] or ROLE_FALLBACK
                hl.Adornee      = c
                hl.FillColor    = col
                hl.OutlineColor = col
                -- A corpse stays in the map in MM2, so dropping it to a faint
                -- outline is the difference between "the murderer is over there"
                -- and "the murderer died over there".
                if roundDead[p.UserId] or not alive then
                    hl.FillTransparency    = 0.9
                    hl.OutlineTransparency = 0.55
                else
                    hl.FillTransparency    = 0.55
                    hl.OutlineTransparency = 0
                end
                hl.Enabled = true
            elseif hl then
                hl.Enabled = false          -- not spawned yet
            end
        end
    end

    -- drop highlights for anyone who left
    for p, hl in pairs(highlights) do
        if p.Parent == nil then
            pcall(function() hl:Destroy() end)
            highlights[p] = nil
        end
    end
end

local function setESP(on)
    espOn = on
    if on then refreshESP() else clearESP() end
end

-- The point of hooking the remote rather than polling for it: this fires the
-- moment the server assigns roles, so the outlines are already correct when the
-- round starts instead of catching up once weapons come out.
local function hookRoundData()
    local RS       = game:GetService("ReplicatedStorage")
    local remotes  = RS:FindFirstChild("Remotes")
    local gameplay = remotes and remotes:FindFirstChild("Gameplay")
    if not gameplay then return end

    local changed = gameplay:FindFirstChild("PlayerDataChanged")
    if changed and changed:IsA("RemoteEvent") then
        STATE.connect(changed.OnClientEvent, function(data)
            if not mine() then return end
            if ingestRoundData(data) and espOn then pcall(refreshESP) end
        end)
    end

    -- Loaded mid-round, after that event already fired for this round: ask.
    local getter = gameplay:FindFirstChild("GetCurrentPlayerData")
    if getter and getter:IsA("RemoteFunction") then
        task.spawn(function()
            local ok, data = pcall(function() return getter:InvokeServer() end)
            if ok and mine() and ingestRoundData(data) and espOn then
                pcall(refreshESP)
            end
        end)
    end
end

if game.GameId == MM2_UNIVERSE then pcall(hookRoundData) end

-- Backstop for the hook above. The game's own CurrentRoundClient module holds
-- the same table and is fed by the same remote, so reading its cache catches a
-- round whose event we somehow missed - a reload landing mid-assignment, say.
local function pollRoundData()
    if roundSeen then return end
    local RS  = game:GetService("ReplicatedStorage")
    local mods = RS:FindFirstChild("Modules")
    local crc = mods and mods:FindFirstChild("CurrentRoundClient")
    if not crc then return end
    local ok, mod = pcall(require, crc)
    if ok and type(mod) == "table" then pcall(ingestRoundData, mod.PlayerData) end
end

-- Character spawns and deaths still need a sweep; roles no longer do.
task.spawn(function()
    while STATE.alive() and mine() do
        if espOn then
            if game.GameId == MM2_UNIVERSE then pcall(pollRoundData) end
            pcall(refreshESP)
        end
        task.wait(0.25)
    end
    clearESP()
end)

STATE.onCleanup(clearESP)

--=========================================================== auto shoot (MM2)
-- Fires the sheriff's gun at the murderer the instant both are true: the gun is
-- in your hands, and they are actually visible.
--
-- The accuracy comes from what gets sent, not from aiming. The game's own
-- GunClient answers Tool.Activated with
--
--     Gun.Shoot:FireServer(GunRaycastAttachment.WorldCFrame, mouseTargetCFrame)
--
-- where the second argument is a CFrame at the world point the mouse ray landed
-- on. Handing it a CFrame at the murderer's head instead of wherever the cursor
-- happens to be is the whole of it - there is no spread to compensate for.
--
-- Deliberately does NOT equip the gun for you. "If I have the gun out" is the
-- condition, and auto-equipping would announce itself to every other player.
local AUTO = {
    delay    = 0.45,    -- seconds between shots
    minDelay = 0.1,
    maxDelay = 2,
    aimPix   = 400,     -- murderer must be within this many px of screen centre
    minPix   = 60,
    maxPix   = 1400,
    range    = 300,     -- the game's own gun ray is 300 studs; past that it misses
}

local autoOn    = false
local autoDelay = AUTO.delay
local autoPix   = AUTO.aimPix
local lastShot  = 0
local engaged   = nil       -- who we last announced, so it announces once

local function equippedGun()
    local c = LP.Character
    local g = c and c:FindFirstChild("Gun")
    if not (g and g:IsA("Tool")) then return nil end
    local shoot = g:FindFirstChild("Shoot")
    if shoot and shoot:IsA("RemoteEvent") then return g, shoot end
    return nil
end

local function shotOrigin()
    local c    = LP.Character
    local root = c and c:FindFirstChild("HumanoidRootPart")
    if not root then return nil end
    -- the attachment only exists while the gun is equipped; the root is a
    -- close enough origin if it has not been parented yet
    local att = root:FindFirstChild("GunRaycastAttachment")
    return att and att.WorldCFrame or root.CFrame
end

local function murderer()
    for _, pl in ipairs(Players:GetPlayers()) do
        if pl ~= LP and not roundDead[pl.UserId] and roleOf(pl) == "Murderer" then
            return pl
        end
    end
    return nil
end

-- Mirrors the game's own WeaponRaycast, including the part that matters: it
-- skips parts at Transparency 1 and keeps going. MM2 maps are full of invisible
-- volumes, and treating one as cover would mean never taking a shot the server
-- would have honoured.
local function clearLineTo(fromPos, target)
    local params = RaycastParams.new()
    params.IgnoreWater = true
    local ignore = { LP.Character, target.Parent }
    params.FilterDescendantsInstances = ignore

    local delta = target.Position - fromPos
    for _ = 1, 8 do
        local hit = workspace:Raycast(fromPos, delta, params)
        if not hit then return true end
        local inst = hit.Instance
        if not inst or inst.Transparency ~= 1 then return false end
        table.insert(ignore, inst)
        params.FilterDescendantsInstances = ignore
    end
    return false
end

local function inSight(target)
    local cam = workspace.CurrentCamera
    local c   = LP.Character
    local eye = c and (c:FindFirstChild("Head") or c:FindFirstChild("HumanoidRootPart"))
    if not (cam and eye and target and target.Parent) then return false end

    local delta = target.Position - eye.Position
    if delta.Magnitude > AUTO.range then return false end

    local sp, onScreen = cam:WorldToViewportPoint(target.Position)
    if not (onScreen and sp.Z > 0) then return false end
    local centre = cam.ViewportSize / 2
    if (Vector2.new(sp.X, sp.Y) - centre).Magnitude > autoPix then return false end

    return clearLineTo(eye.Position, target)
end

local function tryAutoShoot()
    local _, shoot = equippedGun()
    if not shoot then engaged = nil return end

    local m = murderer()
    if not m then engaged = nil return end

    local c   = m.Character
    local hum = c and c:FindFirstChildOfClass("Humanoid")
    if not (c and hum and hum.Health > 0) then return end

    local aim = c:FindFirstChild("Head") or c:FindFirstChild("HumanoidRootPart")
    if not (aim and inSight(aim)) then return end

    if os.clock() - lastShot < autoDelay then return end
    local origin = shotOrigin()
    if not origin then return end

    lastShot = os.clock()
    if engaged ~= m then
        engaged = m
        WindUI:Notify({
            Title = "Auto Shoot", Content = "Firing on " .. m.DisplayName,
            Duration = 2, Icon = "crosshair",
        })
    end
    pcall(function() shoot:FireServer(origin, CFrame.new(aim.Position)) end)
end

-- 20 Hz to notice them stepping into view; autoDelay is what paces the shots.
task.spawn(function()
    while STATE.alive() and mine() do
        if autoOn then pcall(tryAutoShoot) end
        task.wait(0.05)
    end
end)

--=========================================================== Guess the Slapper
-- One player sits, the rest queue up to slap them. Two moments decide a turn,
-- and the game runs both through one LocalScript (PlayerGui.ScreenGui
-- .LocalScript):
--
--   Sitter   events.DodgePrompt(window) arrives when a slap is incoming. A
--            button shows a random W/A/S/D and pressing it inside `window`
--            (0.25s by default) sends events.Dodge(true). Wrong key or too slow
--            sends Dodge(false).
--
--   Slapper  a power bar sweeps bottom to top over 0.8s and loops. The game
--            starts it from TWO places: events.RunMeter(true), and its
--            CameraChange handler when the camera switches to "slapcam" - and
--            real turns come in through the camera path. So nothing here keys off
--            either event; see the slap watcher below. Clicking sends events.SendSlap(barScale), and
--            the server echoes that straight back as the slap's percentage
--            (events.SlapPercent clamps it to 0..1). Over 0.97 is the game's
--            "perfect" tier; 1 is 100%.
--
-- Both features call the game's OWN handlers rather than firing the remotes
-- beside them. Firing Dodge(true) directly would race the game's timeout, which
-- sends Dodge(false) when the window closes; firing SendSlap(1) directly would
-- leave the game's meter armed, so your next click anywhere sends a second slap
-- at whatever the bar reads. Going through the handlers means the game's own
-- state machine closes the prompt / meter itself. The direct remote is only the
-- fallback if a game update moves the handlers.
--
-- Note `firesignal` is a silent no-op in this executor, so "clicking" the dodge
-- button by firing its signal does nothing. The handler is reached instead via
-- getconnections(dodgebut.Activated), which does expose the game's function.
local SLAPPER_UNIVERSE = 9449993534

local SLAP = {
    reaction    = 0.06,   -- seconds after the prompt before dodging
    minReaction = 0,
    maxReaction = 0.2,
    -- Seconds after the meter arms before releasing. Keyed on time, not bar
    -- height: a player clicking by hand lands around 0.73-0.76s, and a release
    -- waiting for the bar to pass 90% (~0.75s) lost that race. The server does
    -- not check timing either - a release 0.01s after arming was still credited
    -- 100% - so earlier is strictly better.
    release     = 0.3,
    minRelease  = 0.05,
    maxRelease  = 0.7,
    -- What the release reports as the slap's strength, in percent. The server
    -- takes the bar reading as-is (clamped 0..1), and anything over 97% is the
    -- game's "perfect" tier with its own sound and bigger popup.
    power       = 100,
    minPower    = 1,
    maxPower    = 100,
}

local autoDodgeOn   = false
local autoSlapOn    = false
local dodgeReaction = SLAP.reaction
local slapDelay     = SLAP.release
local slapPower     = SLAP.power
local slapFn        = nil      -- cached: the game's meter-release handler
local slapStats = {
    dodges = 0, dodgeWins = 0, lastDodge = nil, dodgeVia = nil,
    slaps  = 0, lastPercent = nil, slapVia = nil,
    guesses = 0, lastGuess = nil, guessFrom = nil, guessVia = nil,
}

-- Auto Guess. The game hides who slapped you only on screen: every client at
-- the table is told outright. SlapPercent(slapper, level, perfect) names the
-- slapper at the moment of the slap, and CameraFocus(cam, player) names them
-- before it lands (the camera cuts to whoever is about to swing). The guess
-- panel arrives as Guess(suspects) - a list of Players, or false to close - and
-- picking one sends Guess(name).
--
-- The slapper is taken from SlapPercent first and CameraFocus second, and only
-- ever from the suspects the panel actually offers: SlapPercent is heard from
-- other tables too, and the suspects list is what scopes it to ours.
local autoGuessOn  = false
-- The panel closes on its own about a second after it opens (0.97s observed),
-- and the slapper is already known ~1.07s before it opens, so there is no
-- reason to wait long - only enough that the pick is not the panel's first frame.
local guessDelay   = 0.3
local recentSlaps  = {}   -- { player, at }, newest last, from SlapPercent
local recentFocus  = {}   -- same, from CameraFocus

local function slapperGui()
    local pg = LP:FindFirstChildOfClass("PlayerGui")
    return pg and pg:FindFirstChild("ScreenGui")
end

local function slapEvent(name)
    local ev = game:GetService("ReplicatedStorage"):FindFirstChild("events")
    return ev and ev:FindFirstChild(name)
end

local function meterBar()
    local gui   = slapperGui()
    local meter = gui and gui:FindFirstChild("meter")
    local color = meter and meter:FindFirstChild("color")
    return color and color:FindFirstChild("bar"), meter
end

--- dodge -----------------------------------------------------------------
-- Resolved fresh on every prompt: ScreenGui can be rebuilt on respawn, and a
-- cached function would belong to the dead copy.
local function gameAttemptDodge()
    local gui = slapperGui()
    local btn = gui and gui:FindFirstChild("dodgebut")
    if not btn then return nil end
    for _, c in ipairs(getconnections(btn.Activated)) do
        if type(c.Function) == "function" then return c.Function end
    end
    return nil
end

local function onDodgePrompt(window)
    if not (autoDodgeOn and mine()) then return end
    window = tonumber(window) or 0.25

    -- Deferred so the game's own DodgePrompt handler runs first: it is what arms
    -- the prompt, and attemptDodge is a no-op until it has.
    task.defer(function()
        -- never let the reaction delay eat the whole window
        local waitFor = math.min(dodgeReaction, window * 0.6)
        if waitFor > 0 then task.wait(waitFor) end
        if not (autoDodgeOn and mine()) then return end

        local fn = gameAttemptDodge()
        if fn and pcall(fn) then
            slapStats.dodgeVia = "handler"
        else
            local d = slapEvent("Dodge")
            if d then pcall(function() d:FireServer(true) end) end
            slapStats.dodgeVia = "direct"
        end
        slapStats.dodges += 1
    end)
end

--- slap ------------------------------------------------------------------
-- The meter-release handler is an InputBegan listener, and those do not come
-- back from getconnections here, so it is found in the GC instead: the one
-- closure holding both the bar Frame and the SendSlap remote as upvalues. The
-- RunMeter handler also holds the bar but not SendSlap, so the pair is unique.
-- One GC sweep, then cached until the bar it points at stops being current.
local lastSweep = 0

local function findSlapFn()
    local bar = meterBar()
    if slapFn then
        local ok, ups = pcall(debug.getupvalues, slapFn)
        if ok and type(ups) == "table" then
            for _, u in pairs(ups) do
                if u == bar then return slapFn, bar end
            end
        end
        slapFn = nil
    end

    local send = slapEvent("SendSlap")
    if not (bar and send) then return nil, bar end

    -- a full GC walk is not free; the watcher asks every frame, so throttle it
    if os.clock() - lastSweep < 2 then return nil, bar end
    lastSweep = os.clock()

    for _, f in ipairs(getgc(false)) do
        if type(f) == "function" and islclosure(f) then
            local ok, ups = pcall(debug.getupvalues, f)
            if ok and type(ups) == "table" then
                local hasBar, hasSend = false, false
                for _, u in pairs(ups) do
                    if u == bar then hasBar = true
                    elseif u == send then hasSend = true end
                end
                if hasBar and hasSend then
                    slapFn = f
                    return f, bar
                end
            end
        end
    end
    return nil, bar
end

local function releaseAtPower()
    local level = math.clamp(slapPower, SLAP.minPower, SLAP.maxPower) / 100
    local fn, bar = findSlapFn()
    if fn and bar then
        -- Park the bar at the chosen level, then hand the game its own click. The
        -- handler pauses the sweep and reads bar.Position.Y.Scale in the same
        -- breath, with no frame in between for the tween to move it, so the
        -- level set here is exactly what it sends.
        bar.Position = UDim2.new(bar.Position.X.Scale, bar.Position.X.Offset,
                                 level, bar.Position.Y.Offset)
        local click = {
            UserInputType = Enum.UserInputType.MouseButton1,
            KeyCode       = Enum.KeyCode.Unknown,
        }
        if pcall(fn, click, false) then return "handler" end
    end
    local send = slapEvent("SendSlap")
    if send and pcall(function() send:FireServer(level) end) then return "direct" end
    return nil
end

-- The watcher keys off the one thing every start path has in common: the
-- click handler's own "meter armed" flag (its first upvalue - the game flips it
-- true when a sweep starts and false when a click is sent). That is exactly the
-- condition the game itself checks before sending a slap, so if it is true, a
-- release will be accepted, however the meter got started. If a game update
-- ever moves that upvalue, it falls back to "meter visible and bar moving".
--
-- Timed from the moment the meter arms, not from where the bar is. Watching
-- the bar's height also meant guessing at wraps, and the guess misfired: a turn
-- that starts with the bar still parked at the top from the last one looks
-- exactly like a wrap, which released 0.01s into the turn.
local prevY     = 0
local armedAt   = nil

local function meterArmed(fn, bar, meter)
    if fn then
        local ok, armed = pcall(debug.getupvalue, fn, 1)
        if ok and type(armed) == "boolean" then return armed end
    end
    -- fallback: visible and actually sweeping
    return meter ~= nil and meter.Visible and bar ~= nil
        and bar.Position.Y.Scale ~= prevY
end

local function slapTick()
    local bar, meter = meterBar()
    if not bar then return end
    local fn = findSlapFn()
    local armed = meterArmed(fn, bar, meter)
    prevY = bar.Position.Y.Scale

    if not armed then
        armedAt = nil
        return
    end
    armedAt = armedAt or os.clock()

    -- One release per turn. The handler path disarms the meter itself, but the
    -- direct-remote fallback cannot, and without this it would fire again.
    if os.clock() - (slapStats.releasedAt or 0) < 1.2 then return end
    if os.clock() - armedAt < slapDelay then return end

    slapStats.releasedAt = os.clock()
    local via = releaseAtPower()
    if via then
        slapStats.slaps  += 1
        slapStats.slapVia = via
    end
    armedAt = nil
end

task.spawn(function()
    while STATE.alive() and mine() do
        if autoSlapOn and game.GameId == SLAPPER_UNIVERSE then pcall(slapTick) end
        RunService.RenderStepped:Wait()
    end
end)

local function remember(list, pl)
    if typeof(pl) ~= "Instance" or not pl:IsA("Player") or pl == LP then return end
    table.insert(list, { player = pl, at = os.clock() })
    if #list > 24 then table.remove(list, 1) end
end

-- newest entry from `list` that is one of the offered suspects, within 20s
local function newestIn(list, offered)
    for i = #list, 1, -1 do
        local e = list[i]
        if os.clock() - e.at > 20 then break end
        if offered[e.player] then return e.player end
    end
    return nil
end

-- The panel's buttons are the game's own: clicking one runs the game's handler,
-- which sends the guess AND closes the panel. Reaching that handler is the same
-- trick as the dodge button - GuiButton listeners come back from getconnections
-- with their Function intact. The direct remote is only the fallback.
--
-- The buttons are NOT there the moment the panel opens: the game builds each
-- one after fetching that player's headshot, a web request per suspect. Firing
-- the remote before they exist does send the right guess, but the game then
-- finishes building and shows the panel again, inviting a second click. So wait
-- for our suspect's button (the panel closes itself ~1s in, so not for long).
local function suspectButton(pl)
    local gui  = slapperGui()
    local list = gui and gui:FindFirstChild("suspects")
    if not list then return nil, nil end
    for _, btn in ipairs(list:GetChildren()) do
        if btn:IsA("ImageButton") then
            local label = btn:FindFirstChild("name")
            if label and label.Text == pl.Name then return btn, list end
        end
    end
    return nil, list
end

-- And wait for the panel itself, not just our button: the game only reveals the
-- panel after building EVERY suspect's button, so pressing the moment ours
-- exists let it finish afterwards and pop the panel back up for a second.
local function pressSuspect(pl, waitUpTo)
    local deadline = os.clock() + (waitUpTo or 0)
    local btn, list = suspectButton(pl)
    while not (btn and list and list.Visible) and os.clock() < deadline do
        task.wait()
        btn, list = suspectButton(pl)
    end
    if btn then
        for _, c in ipairs(getconnections(btn.MouseButton1Click)) do
            if type(c.Function) == "function" and pcall(c.Function) then
                return "handler"
            end
        end
    end
    local g = slapEvent("Guess")
    if g and pcall(function() g:FireServer(pl.Name) end) then
        if list then list.Visible = false end
        return "direct"
    end
    return nil
end

local function onGuessPanel(suspects)
    if not (autoGuessOn and mine()) then return end
    if suspects == false or type(suspects) ~= "table" then return end

    local offered = {}
    for _, pl in pairs(suspects) do
        if typeof(pl) == "Instance" and pl ~= LP then offered[pl] = true end
    end

    local pick, from = newestIn(recentSlaps, offered), "slap"
    if not pick then pick, from = newestIn(recentFocus, offered), "camera" end
    if not pick then
        slapStats.guessFrom = "unknown"     -- leave it to the player
        return
    end

    -- Deferred so the game's own handler has built the buttons first, then held
    -- for guessDelay so the pick does not land in the same frame the panel opens.
    task.delay(guessDelay, function()
        if not (autoGuessOn and mine()) then return end
        local via = pressSuspect(pick, 0.5)
        if via then
            slapStats.guesses  += 1
            slapStats.lastGuess = pick.Name
            slapStats.guessFrom = from
            slapStats.guessVia  = via
        end
    end)
end

local function hookSlapper()
    local prompt = slapEvent("DodgePrompt")
    if prompt then
        STATE.connect(prompt.OnClientEvent, function(window) onDodgePrompt(window) end)
    end

    local result = slapEvent("DodgeResult")
    if result then
        STATE.connect(result.OnClientEvent, function(ok)
            if not mine() then return end
            slapStats.lastDodge = ok and true or false
            if ok then slapStats.dodgeWins += 1 end
        end)
    end

    -- the server's own verdict on the percentage, for the status readout, and
    -- the slapper's name for Auto Guess
    local pct = slapEvent("SlapPercent")
    if pct then
        STATE.connect(pct.OnClientEvent, function(who, value)
            if not mine() then return end
            remember(recentSlaps, who)
            if os.clock() - (slapStats.releasedAt or 0) < 3 then
                slapStats.lastPercent = math.floor((tonumber(value) or 0) * 100 + 0.5)
            end
        end)
    end

    local focus = slapEvent("CameraFocus")
    if focus then
        STATE.connect(focus.OnClientEvent, function(_, who)
            if mine() then remember(recentFocus, who) end
        end)
    end

    local guess = slapEvent("Guess")
    if guess then
        STATE.connect(guess.OnClientEvent, function(suspects) onGuessPanel(suspects) end)
    end

    -- warm the handler cache now so the first release does not pay for the sweep
    task.spawn(function() pcall(findSlapFn) end)
end

if game.GameId == SLAPPER_UNIVERSE then pcall(hookSlapper) end

--=========================================================== Jailbreak
-- Jailbreak (Badimo). Its anti-cheat runs on the SERVER - there are no client
-- hooks to see, only an admin "anticheat" command that toggles it - so what it
-- checks is invisible from here. That is what the RISKY tags in its tab mean:
-- those features send actions or movement the server gets to judge. Everything
-- untagged only reads what the game already sends this client.
--
-- The game's actions all go through one shared remote keyed by an obfuscated
-- string built at runtime ("gbkwuums" for an arrest on this build), and those
-- keys change with updates. So nothing here sends to that remote directly: the
-- arrest calls the game's own UseHandcuffs (found by name in the GC), which
-- checks you are Police and holding cuffs before it fires anything, and the
-- quest rescue calls the quest's own circle-action callbacks.
--
-- All state lives in the one JB table: the main chunk is close to Luau's local
-- register limit, and a feature this size would push it over.
local JB_UNIVERSE = 245662005
local RISKY_TAG   = '<font color="#ff4545"><b>RISKY</b></font>'

local JB = {
    IN = game.GameId == JB_UNIVERSE,
    RS = game:GetService("ReplicatedStorage"),

    -- the game's own handcuff reach (ItemConfig.Handcuffs): 10 across, 14 up or
    -- down, both halved when the arrest is contested
    ARREST_H = 10, ARREST_V = 14,
    -- auto-arrest keeps a margin inside that: the server measures the distance
    -- itself, and an attempt from out of range is the kind of thing it notices
    AUTO_H = 9, AUTO_V = 12,
    ARREST_HOLD = 0.55,   -- the game's arrest is a 0.5s hold
    RESCUE_HOLD = 5.2,    -- the quest rescue is a 5s hold (R20Consts.RESCUE_HOLD_DURATION)
    RESCUE_DIST = 7,      -- R20Consts.RESCUE_DIST is 8

    COLOR_CRIM  = Color3.fromRGB(255,  70,  70),
    COLOR_GOLD  = Color3.fromRGB(255, 200,  60),
    COLOR_REACH = Color3.fromRGB( 80, 255, 120),
    COLOR_QUEST = Color3.fromRGB( 90, 200, 255),
    COLOR_POLICE   = Color3.fromRGB( 60, 140, 255),
    COLOR_PRISONER = Color3.fromRGB(255, 150,  50),   -- the game's own prisoner orange

    -- menu name -> workspace model. Only robberies that stay put: the trains,
    -- the ship, the plane and the money truck move, so they have no fixed spot.
    PLACES = {
        { "Bank", "Banks" }, { "Jewelry Store", "Jewelrys" }, { "Museum", "Museum" },
        { "Power Plant", "PowerPlant" }, { "Tomb", "RobberyTomb" },
        { "Crown Jewel", "CrownCity" }, { "Mansion", "MansionDetails" },
        { "Oil Rig", "OilRig" }, { "Donut Store", "DonutShop" },
        { "Gas Station", "GasStations" }, { "Police HQ", "PoliceHQ" },
    },

    on = {
        alerts = false, team = false, esp = false, bounty = false, range = false, quest = false,
        rescue = false, arrest = false, afk = false, speed = false,
        markers = false, rob = false, farm = false,
    },
    speed     = 24,
    tpTarget  = "Bank",
    robStatus = {},        -- robbery id -> 1 open, 2 being robbed, 3 closed
    bounties  = {},        -- player name -> bounty
    bountyList = {},       -- sorted, highest first
    marks     = {},        -- key (Player or Instance) -> { hl, bb, label }
    fn        = {},        -- cached game functions, by name
    fnSweep   = {},
    lastText  = {},
    toggles   = {},
    ui        = {},
    stats     = { arrests = 0, lastArrest = nil, rescues = 0, afkSaves = 0, robs = 0 },
}

function JB.commas(n)
    local s = tostring(math.floor(n))
    return (s:reverse():gsub("(%d%d%d)", "%1,"):reverse():gsub("^,", ""))
end

--- lookups ---------------------------------------------------------------
function JB.consts()
    if JB._rc == nil then
        local ok, rc = pcall(require, JB.RS.Robbery.RobberyConsts)
        JB._rc = ok and rc or false
    end
    return JB._rc or nil
end

function JB.robberyName(id)
    local rc = JB.consts()
    local pretty = rc and rc.PRETTY_NAME
    return (pretty and (pretty[id] or pretty[tostring(id)])) or ("Robbery " .. tostring(id))
end

-- Team, not TeamValue: criminals AND jailed prisoners both carry
-- TeamValue = "Prisoner", and arresting a jailed prisoner costs $25.
function JB.isCriminal(p) return p.Team ~= nil and p.Team.Name == "Criminal" end
function JB.isPolice()   return LP.Team ~= nil and LP.Team.Name == "Police" end

function JB.teamColor(p)
    local t = p.Team and p.Team.Name
    if t == "Criminal" then return JB.COLOR_CRIM end
    if t == "Police"   then return JB.COLOR_POLICE end
    return JB.COLOR_PRISONER
end

function JB.rootOf(p)
    local c = p.Character
    return c and (c.PrimaryPart or c:FindFirstChild("HumanoidRootPart"))
end
function JB.myRoot() return JB.rootOf(LP) end

function JB.alive(p)
    local c = p.Character
    local h = c and c:FindFirstChildOfClass("Humanoid")
    return h ~= nil and h.Health > 0
end

-- horizontal, vertical, straight-line - the game checks the first two separately
function JB.gap(p)
    local a, b = JB.myRoot(), JB.rootOf(p)
    if not (a and b) then return math.huge, math.huge, math.huge end
    local d = b.Position - a.Position
    return Vector3.new(d.X, 0, d.Z).Magnitude, math.abs(d.Y), d.Magnitude
end

-- A game function by its debug name, found once in the GC and cached. Sweeps
-- are throttled so a missing function does not cost a GC walk every tick.
function JB.findFn(name)
    local f = JB.fn[name]
    if f then return f end
    if os.clock() - (JB.fnSweep[name] or 0) < 3 then return nil end
    JB.fnSweep[name] = os.clock()
    for _, g in ipairs(getgc(false)) do
        if type(g) == "function" and islclosure(g) then
            local ok, n = pcall(debug.info, g, "n")
            if ok and n == name then
                JB.fn[name] = g
                return g
            end
        end
    end
    return nil
end

--- robberies -------------------------------------------------------------
function JB.robberyText()
    local groups = { [1] = {}, [2] = {}, [3] = {} }
    for id, st in pairs(JB.robStatus) do
        table.insert(groups[st] or groups[3], JB.robberyName(id))
    end
    for _, g in pairs(groups) do table.sort(g) end
    local lines = {}
    if #groups[2] > 0 then table.insert(lines, "Being robbed: " .. table.concat(groups[2], ", ")) end
    table.insert(lines, "Open: " .. (#groups[1] > 0 and table.concat(groups[1], ", ") or "none"))
    table.insert(lines, ("Closed: %d"):format(#groups[3]))
    return table.concat(lines, "\n")
end

function JB.hookRobberies()
    local folder = JB.RS:FindFirstChild("RobberyState")
    if not folder then return end
    local function watch(v)
        if not v:IsA("IntValue") then return end
        local id = tonumber(v.Name)
        if not id then return end
        JB.robStatus[id] = v.Value
        STATE.connect(v.Changed, function(new)
            if not mine() then return end
            local old = JB.robStatus[id]
            JB.robStatus[id] = new
            if JB.on.alerts and new ~= old and (new == 1 or new == 2) then
                WindUI:Notify({
                    Title    = JB.robberyName(id),
                    Content  = new == 2 and "Being robbed right now" or "Now open",
                    Duration = 6,
                    Icon     = new == 2 and "siren" or "bell",
                })
            end
        end)
    end
    for _, v in ipairs(folder:GetChildren()) do watch(v) end
    STATE.connect(folder.ChildAdded, function(v) if mine() then watch(v) end end)
end

--- bounties --------------------------------------------------------------
-- ReplicatedStorage.BountyData is a JSON list of {Bounty, Name, UserId}.
function JB.readBounties()
    local v = JB.RS:FindFirstChild("BountyData")
    local list = {}
    if v and v:IsA("StringValue") then
        local http = game:GetService("HttpService")
        local ok, data = pcall(http.JSONDecode, http, v.Value)
        if ok and type(data) == "table" then
            for _, e in ipairs(data) do
                if type(e) == "table" and e.Name and tonumber(e.Bounty) then
                    table.insert(list, { name = e.Name, amount = tonumber(e.Bounty) })
                end
            end
        end
    end
    table.sort(list, function(a, b) return a.amount > b.amount end)
    JB.bountyList = list
    JB.bounties = {}
    for _, e in ipairs(list) do JB.bounties[e.name] = e.amount end
end

function JB.bountyText()
    if #JB.bountyList == 0 then return "No bounties right now." end
    local lines = {}
    for i = 1, math.min(5, #JB.bountyList) do
        local e = JB.bountyList[i]
        local p = Players:FindFirstChild(e.name)
        local d = math.huge
        if p then
            local _, _, dd = JB.gap(p)
            d = dd
        end
        table.insert(lines, ("%d. %s  $%s%s"):format(i, e.name, JB.commas(e.amount),
            (d and d < math.huge) and ("  ·  %dm"):format(d) or ""))
    end
    return table.concat(lines, "\n")
end

--- quest -----------------------------------------------------------------
function JB.questState()
    local done   = LP:GetAttribute("R20QuestCompleted") == true
    local active = LP:GetAttribute("R20QuestActive") == true
    local n = 0
    for i = 1, 5 do if LP:GetAttribute("R20Rescued_NPC" .. i) == true then n += 1 end end
    return active, done, n
end

function JB.questText()
    local active, done, n = JB.questState()
    if done then return "Complete. Prizes and badge earned." end
    if not active then return "Not started. Talk to the quest NPC at the Museum to begin." end
    return ("In progress: %d of 5 rescued."):format(n)
end

-- Every quest NPC's circle action (Talk, then a timed Rescue) is a spec table
-- held as an upvalue by R20QuestService's closures. Rescanned every few
-- seconds, since the NPCs only exist once the quest is running.
function JB.questSpecs()
    if JB._specsAt and os.clock() - JB._specsAt < 3 then return JB._specs end
    JB._specsAt = os.clock()
    local specs = {}
    for _, f in ipairs(getgc(false)) do
        if type(f) == "function" and islclosure(f) then
            local ok, src = pcall(debug.info, f, "s")
            if ok and src and src:find("R20QuestService", 1, true) then
                local ok2, ups = pcall(debug.getupvalues, f)
                if ok2 and type(ups) == "table" then
                    for _, u in pairs(ups) do
                        if type(u) == "table" and type(rawget(u, "Callback")) == "function"
                            and typeof(rawget(u, "Part")) == "Instance" and rawget(u, "Dist") then
                            specs[u] = true
                        end
                    end
                end
            end
        end
    end
    JB._specs = specs
    return specs
end

--- contracts -------------------------------------------------------------
-- "ArrestXCriminal" -> "Arrest 12 Criminal", "NoDieXMins" -> "No Die 7 Mins"
function JB.prettyContract(raw, goal)
    local s = raw:gsub("(%l)(%u)", "%1 %2"):gsub("(%u)(%u%l)", "%1 %2")
    s = s:gsub("%f[%w]X%f[%W]", tostring(goal))
    return s
end

function JB.contractsText()
    local all  = JB.RS:FindFirstChild("PlayerContracts")
    local mineF = all and all:FindFirstChild(tostring(LP.UserId))
    if not mineF then return "No contracts found." end
    -- Each contract IS a BoolValue named for its type (true once done), with
    -- Progress, Goal, State and ReqSeasonPass parented underneath it.
    local lines = {}
    for _, c in ipairs(mineF:GetChildren()) do
        local key = c:IsA("BoolValue") and c or nil
        if key then
            local prog  = c:FindFirstChild("Progress")
            local goal  = c:FindFirstChild("Goal")
            local state = c:FindFirstChild("State")
            local pass  = c:FindFirstChild("ReqSeasonPass")
            local g = goal and goal.Value or 0
            local tail
            if key.Value or (prog and g > 0 and prog.Value >= g) then
                tail = "done"
            elseif pass and pass.Value and state and state.Value == 1 then
                tail = "needs season pass"
            else
                tail = ("%d/%d"):format(prog and prog.Value or 0, g)
            end
            table.insert(lines, JB.prettyContract(key.Name, g) .. "  ·  " .. tail)
        end
    end
    return #lines > 0 and table.concat(lines, "\n") or "No contracts found."
end

--- markers ---------------------------------------------------------------
function JB.folder()
    if not (JB._folder and JB._folder.Parent) then
        JB._folder = Instance.new("Folder")
        JB._folder.Name = "MonoJB"
        JB._folder.Parent = (gethui and gethui()) or game:GetService("CoreGui")
    end
    return JB._folder
end

function JB.unmark(key)
    local m = JB.marks[key]
    if m then
        pcall(function() m.hl:Destroy() end)
        pcall(function() m.bb:Destroy() end)
        JB.marks[key] = nil
    end
end

-- key: a Player or an Instance. target: the Model or BasePart to outline.
function JB.mark(key, target, color, text)
    local m = JB.marks[key]
    if not (m and m.hl.Parent and m.bb.Parent) then
        JB.unmark(key)
        local hl = Instance.new("Highlight")
        hl.DepthMode           = Enum.HighlightDepthMode.AlwaysOnTop
        hl.FillTransparency    = 0.6
        hl.OutlineTransparency = 0
        hl.Parent              = JB.folder()

        local bb = Instance.new("BillboardGui")
        bb.AlwaysOnTop   = true
        bb.Size          = UDim2.fromOffset(240, 18)
        bb.StudsOffset   = Vector3.new(0, 3.6, 0)
        bb.LightInfluence = 0
        bb.Parent        = JB.folder()

        local tl = Instance.new("TextLabel")
        tl.BackgroundTransparency = 1
        tl.Size                   = UDim2.fromScale(1, 1)
        tl.Font                   = Enum.Font.GothamBold
        tl.TextSize               = 13
        tl.TextStrokeTransparency = 0.35
        tl.Parent                 = bb

        m = { hl = hl, bb = bb, label = tl }
        JB.marks[key] = m
    end
    local part = target
    if target:IsA("Model") then
        part = target:FindFirstChild("Head") or target.PrimaryPart
            or target:FindFirstChildWhichIsA("BasePart", true)
    end
    m.hl.Adornee      = target
    m.hl.FillColor    = color
    m.hl.OutlineColor = color
    m.bb.Adornee      = part
    m.label.Text       = text
    m.label.TextColor3 = color
end

function JB.distTo(part)
    local r = JB.myRoot()
    return (r and part) and (part.Position - r.Position).Magnitude or math.huge
end

--- arrest-range readout ----------------------------------------------------
function JB.rangeHud(list)
    if #list == 0 then
        if JB._hud then JB._hud.Enabled = false end
        return
    end
    if not (JB._hud and JB._hud.Parent) then
        local sg = Instance.new("ScreenGui")
        sg.Name = "MonoJBRange"
        sg.ResetOnSpawn = false
        sg.IgnoreGuiInset = true
        sg.DisplayOrder = 10000
        sg.Parent = (gethui and gethui()) or game:GetService("CoreGui")
        local tl = Instance.new("TextLabel")
        tl.AnchorPoint = Vector2.new(0.5, 0)
        tl.Position = UDim2.new(0.5, 0, 0, 70)
        tl.Size = UDim2.fromOffset(420, 28)
        tl.BackgroundColor3 = MONO.ElementBackground
        tl.BackgroundTransparency = 0.1
        tl.Font = Enum.Font.GothamBold
        tl.TextSize = 15
        tl.TextColor3 = JB.COLOR_REACH
        tl.Parent = sg
        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(0, 10)
        corner.Parent = tl
        JB._hud, JB._hudLabel = sg, tl
    end
    local names = {}
    for _, p in ipairs(list) do table.insert(names, p.DisplayName) end
    JB._hudLabel.Text = "IN ARREST RANGE:  " .. table.concat(names, ", ")
    JB._hud.Enabled = true
end

--- the 5 Hz pass: criminal ESP, bounty marker, arrest range, quest locator --
function JB.tick()
    local top = JB.bountyList[1] and JB.bountyList[1].name
    local keep, inReach = {}, {}

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP and p.Character and JB.alive(p) and JB.isCriminal(p) then
            local h, v, d = JB.gap(p)
            local reach = h <= JB.ARREST_H and v <= JB.ARREST_V
            if reach then table.insert(inReach, p) end
            local isTop = JB.on.bounty and p.Name == top
            if JB.on.esp or isTop or (JB.on.range and reach) then
                local color = JB.COLOR_CRIM
                if isTop then color = JB.COLOR_GOLD end
                if JB.on.range and reach then color = JB.COLOR_REACH end
                local bounty = JB.bounties[p.Name]
                local text = p.DisplayName .. ("  ·  %dm"):format(d)
                if JB.on.bounty and bounty then text ..= "  ·  $" .. JB.commas(bounty) end
                if isTop then text = "TOP BOUNTY  " .. text end
                JB.mark(p, p.Character, color, text)
                keep[p] = true
            end
        end
    end

    -- Team ESP: everyone the criminal pass above did not already claim. It runs
    -- second on purpose, so a criminal who is the top bounty or in arrest reach
    -- keeps that gold or green instead of being repainted plain red.
    if JB.on.team then
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LP and not keep[p] and p.Character and JB.alive(p) then
                local _, _, d = JB.gap(p)
                JB.mark(p, p.Character, JB.teamColor(p), p.DisplayName .. ("  ·  %dm"):format(d))
                keep[p] = true
            end
        end
    end

    if JB.on.quest then
        local active, done = JB.questState()
        if not active and not done then
            for _, inst in ipairs(game:GetService("CollectionService"):GetTagged("R20StartPrompt")) do
                local part = inst:IsA("BasePart") and inst or inst:FindFirstChildWhichIsA("BasePart", true)
                if part then
                    JB.mark(inst, inst, JB.COLOR_GOLD, ("QUEST START  ·  %dm"):format(JB.distTo(part)))
                    keep[inst] = true
                end
            end
        elseif active and not done then
            local npcs = workspace:FindFirstChild("R20Npcs")
            if npcs then
                for _, npc in ipairs(npcs:GetChildren()) do
                    if LP:GetAttribute("R20Rescued_" .. npc.Name) ~= true then
                        local part = npc:IsA("BasePart") and npc or npc:FindFirstChildWhichIsA("BasePart", true)
                        if part then
                            JB.mark(npc, npc, JB.COLOR_QUEST, ("RESCUE %s  ·  %dm"):format(npc.Name, JB.distTo(part)))
                            keep[npc] = true
                        end
                    end
                end
            end
        end
    end

    if JB.on.markers then pcall(JB.markRobberies, keep) end

    for key in pairs(JB.marks) do
        if not keep[key] then JB.unmark(key) end
    end
    JB.rangeHud(JB.on.range and inReach or {})
end

--- auto arrest ---------------------------------------------------------------
-- Mirrors the game's own arrest: a 0.5s hold in reach, then UseHandcuffs, which
-- does nothing unless you are Police and actually holding cuffs.
function JB.arrestTick()
    if not JB.isPolice() then JB._arresting = nil return end
    local best, bestD
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP and JB.isCriminal(p) and JB.alive(p) then
            local h, v, d = JB.gap(p)
            if h <= JB.AUTO_H and v <= JB.AUTO_V and (not bestD or d < bestD) then
                best, bestD = p, d
            end
        end
    end
    if not best then JB._arresting = nil return end
    if not (JB._arresting and JB._arresting.player == best) then
        JB._arresting = { player = best, since = os.clock() }
        return
    end
    if os.clock() - JB._arresting.since < JB.ARREST_HOLD then return end
    if os.clock() - (JB._lastArrestAt or 0) < 1 then return end

    local useCuffs = JB.findFn("UseHandcuffs")
    if not useCuffs then return end
    JB._lastArrestAt = os.clock()
    local ok, fired = pcall(useCuffs, { PlayerName = best.Name })
    if not ok then
        JB.fn.UseHandcuffs = nil      -- stale copy; find it again next time
    elseif fired then
        JB.stats.arrests  += 1
        JB.stats.lastArrest = best.Name
        JB._arresting = nil
    end
end

--- quest auto-rescue -----------------------------------------------------------
-- The game calls a spec's Callback(spec, false) when a hold starts and
-- Callback(spec, true) when it completes; Talk is instant. This runs the same
-- sequence with the real 5 seconds in between, and lets go if you walk off.
function JB.rescueTick()
    if JB._holding then return end
    local root = JB.myRoot()
    if not root then return end
    for spec in pairs(JB.questSpecs()) do
        local part = rawget(spec, "Part")
        if part and part.Parent and spec.Enabled then
            local d = (part.Position - root.Position).Magnitude
            if spec.Name == "Talk" and d <= (spec.Dist or 18) - 2 then
                pcall(spec.Callback, spec, true)
                return
            elseif spec.Name == "Rescue" and d <= JB.RESCUE_DIST then
                JB._holding = true
                task.spawn(function()
                    pcall(spec.Callback, spec, false)
                    local t0 = os.clock()
                    while os.clock() - t0 < JB.RESCUE_HOLD do
                        local r = JB.myRoot()
                        if not (JB.on.rescue and mine() and r and part.Parent
                            and (part.Position - r.Position).Magnitude <= JB.RESCUE_DIST + 1) then
                            if type(rawget(spec, "ReleaseCallback")) == "function" then
                                pcall(spec.ReleaseCallback, spec)
                            end
                            JB._holding = false
                            return
                        end
                        task.wait(0.1)
                    end
                    if pcall(spec.Callback, spec, true) then JB.stats.rescues += 1 end
                    JB._holding = false
                end)
                return
            end
        end
    end
end

--- teleport --------------------------------------------------------------------
function JB.teleport(cf)
    local c = LP.Character
    if not (c and JB.myRoot()) then return false end
    c:PivotTo(cf)
    return true
end

-- Drop onto whatever is at the middle of the building's footprint, from above,
-- so it lands on a surface instead of inside a wall.
function JB.placeCFrame(modelName)
    local m = workspace:FindFirstChild(modelName)
    if not m then return nil end
    local ok, cf, size = pcall(function() return m:GetBoundingBox() end)
    if not ok then return nil end
    local params = RaycastParams.new()
    params.FilterDescendantsInstances = { LP.Character }
    local from = cf.Position + Vector3.new(0, size.Y / 2 + 50, 0)
    local hit = workspace:Raycast(from, Vector3.new(0, -(size.Y + 500), 0), params)
    local at = hit and hit.Position or cf.Position
    return CFrame.new(at + Vector3.new(0, 4, 0))
end

function JB.tpPlace()
    for _, e in ipairs(JB.PLACES) do
        if e[1] == JB.tpTarget then
            local cf = JB.placeCFrame(e[2])
            if cf and JB.teleport(cf) then return true end
            WindUI:Notify({ Title = "Teleport", Content = "Could not find " .. e[1], Duration = 3, Icon = "map" })
            return false
        end
    end
    return false
end

function JB.tpPlayer(p)
    local r = p and JB.rootOf(p)
    if not r then
        WindUI:Notify({ Title = "Teleport", Content = "Nobody to go to", Duration = 3, Icon = "map" })
        return false
    end
    return JB.teleport(r.CFrame * CFrame.new(0, 0, 4))   -- just behind them
end

function JB.nearestCriminal()
    local best, bestD
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP and JB.isCriminal(p) and JB.alive(p) then
            local _, _, d = JB.gap(p)
            if not bestD or d < bestD then best, bestD = p, d end
        end
    end
    return best
end

--- panels ------------------------------------------------------------------------
function JB.setText(el, text)
    if el and JB.lastText[el] ~= text then
        JB.lastText[el] = text
        pcall(function() el:SetDesc(text) end)
    end
end

function JB.refreshPanels()
    JB.setText(JB.ui.robberies, JB.robberyText())
    JB.setText(JB.ui.bounty,    JB.bountyText())
    JB.setText(JB.ui.quest,     JB.questText())
    JB.setText(JB.ui.contracts, JB.contractsText())
    JB.setText(JB.ui.money,     JB.moneyText())
end

function JB.clearAll()
    for key in pairs(JB.marks) do JB.unmark(key) end
    if JB._folder then pcall(function() JB._folder:Destroy() end) JB._folder = nil end
    if JB._hud then pcall(function() JB._hud:Destroy() end) JB._hud = nil end
end

function JB.restoreSpeed()
    local c = LP.Character
    local h = c and c:FindFirstChildOfClass("Humanoid")
    if h then pcall(function() h.WalkSpeed = JB._baseSpeed or 16 end) end
end

--- money: store robbery ---------------------------------------------------------
-- The three small stores (Gas, Donut, Grocery) are models tagged "SmallStore",
-- each with a Prompt part, a RobRemote and a RobberyStatus attribute. Robbing
-- one is the game's circle-action hold: Callback(spec, false) sends
-- RobRemote(true) and plays the threat animation, 10 seconds later
-- Callback(spec, true) sends RobRemote("Rob") for $750, and letting go sends
-- RobRemote(false). The spec is only Enabled while the store is not closed and
-- you are not Police. Everything below runs that same sequence with the real 10
-- seconds, and lets go if you leave the counter.
JB.STORE_HOLD = 10.4
JB.STORE_DIST = 6.5          -- the game offers the hold within 8
JB.farmSpeed  = 120
JB.farmStatus = "Off"
JB.cashStart  = LP:GetAttribute("Cash")

-- Big robberies by the name RobberyConsts gives them -> their workspace model.
JB.BIG = {
    ["Bank"] = "Banks", ["Jewelry Store"] = "Jewelrys", ["Museum"] = "Museum",
    ["Power Plant"] = "PowerPlant", ["Tomb"] = "RobberyTomb", ["Crown Jewel"] = "CrownCity",
    ["Mansion"] = "MansionDetails", ["Oil Rig"] = "OilRig",
}

function JB.storeSpecs()
    if JB._storeSpecsAt and os.clock() - JB._storeSpecsAt < 5 then return JB._storeSpecs end
    JB._storeSpecsAt = os.clock()
    local specs = {}
    for _, f in ipairs(getgc(false)) do
        if type(f) == "function" and islclosure(f) then
            local ok, src = pcall(debug.info, f, "s")
            if ok and src and src:find("SmallStore", 1, true) then
                local ok2, ups = pcall(debug.getupvalues, f)
                if ok2 and type(ups) == "table" then
                    for _, u in pairs(ups) do
                        if type(u) == "table" and rawget(u, "Name") == "Rob"
                            and type(rawget(u, "Callback")) == "function"
                            and typeof(rawget(u, "Part")) == "Instance" then
                            specs[u] = true
                        end
                    end
                end
            end
        end
    end
    JB._storeSpecs = specs
    return specs
end

function JB.storeName(part)
    local model = part and part.Parent
    local id = model and model.Name
    local names = { STORE_GAS = "Gas Station", STORE_DONUT = "Donut Store", STORE_GROCERY = "Grocery Store" }
    return names[id] or (id or "Store")
end

function JB.storeOpen(spec)
    local part = rawget(spec, "Part")
    local model = part and part.Parent
    if not (model and part.Parent) then return false end
    local st = model:GetAttribute("RobberyStatus")
    return spec.Enabled ~= false and st ~= 3
end

-- Blocking: runs one hold start to finish. False if it had to let go.
function JB.holdNow(spec, part, duration, maxDist)
    if JB._holding then return false end
    JB._holding = true
    pcall(spec.Callback, spec, false)
    local t0 = os.clock()
    while os.clock() - t0 < duration do
        local r = JB.myRoot()
        if not ((JB.on.rob or JB.on.farm) and mine() and r and part.Parent
            and (part.Position - r.Position).Magnitude <= maxDist) then
            if type(rawget(spec, "ReleaseCallback")) == "function" then
                pcall(spec.ReleaseCallback, spec)
            end
            JB._holding = false
            return false
        end
        task.wait(0.1)
    end
    local ok = pcall(spec.Callback, spec, true)
    JB._holding = false
    return ok
end

-- Auto Rob: you get yourself to the counter, it does the holding.
function JB.robTick()
    if JB._holding or JB.on.farm then return end
    local root = JB.myRoot()
    if not root then return end
    for spec in pairs(JB.storeSpecs()) do
        local part = rawget(spec, "Part")
        if part and JB.storeOpen(spec) and (part.Position - root.Position).Magnitude <= JB.STORE_DIST then
            task.spawn(function()
                if JB.holdNow(spec, part, JB.STORE_HOLD, 8) then JB.stats.robs += 1 end
            end)
            return
        end
    end
end

--- money: store farm -------------------------------------------------------------
-- Where to stand for a store: whatever surface is under its Prompt.
function JB.standPoint(part)
    local params = RaycastParams.new()
    params.FilterDescendantsInstances = { LP.Character, part }
    local hit = workspace:Raycast(part.Position + Vector3.new(0, 6, 0), Vector3.new(0, -30, 0), params)
    return (hit and hit.Position or part.Position) + Vector3.new(0, 3, 0)
end

function JB.endTravel(hum)
    JB._travelling = false
    if hum and hum.Parent and not wanted then hum.PlatformStand = false end
    if not wanted then restoreCollision() end
    local r = JB.myRoot()
    if r then r.AssemblyLinearVelocity = Vector3.zero end
end

-- Timed flight, not a teleport: straight up to above the rooftops, across, then
-- down, at farmSpeed studs a second. Still movement the server gets to judge -
-- that is what the RISKY tag is for - but it is a path, not a 5 km jump.
function JB.travel(dest, speed)
    local c = LP.Character
    local root = JB.myRoot()
    local hum = c and c:FindFirstChildOfClass("Humanoid")
    if not (root and hum) then return false end
    if hum.Sit then hum.Sit = false task.wait(0.2) end

    JB._travelling = true
    hum.PlatformStand = true
    local cruise = math.max(root.Position.Y, dest.Y) + 120
    local legs = {
        Vector3.new(root.Position.X, cruise, root.Position.Z),
        Vector3.new(dest.X, cruise, dest.Z),
        dest,
    }
    for _, goal in ipairs(legs) do
        while true do
            if not (JB.on.farm and mine() and root.Parent and hum.Parent and hum.Health > 0) then
                JB.endTravel(hum)
                return false
            end
            local dt = RunService.Heartbeat:Wait()
            applyNoclip()
            local pos = root.Position
            local delta = goal - pos
            local step = speed * dt
            if delta.Magnitude <= step then
                root.CFrame = CFrame.new(goal) * root.CFrame.Rotation
                root.AssemblyLinearVelocity = Vector3.zero
                break
            end
            root.CFrame = CFrame.new(pos + delta.Unit * step) * root.CFrame.Rotation
            root.AssemblyLinearVelocity = Vector3.zero
        end
    end
    JB.endTravel(hum)
    return true
end

function JB.nextStore()
    local root = JB.myRoot()
    if not root then return nil end
    local best, bestD
    for spec in pairs(JB.storeSpecs()) do
        local part = rawget(spec, "Part")
        if part and JB.storeOpen(spec) then
            local d = (part.Position - root.Position).Magnitude
            if not bestD or d < bestD then best, bestD = spec, d end
        end
    end
    return best
end

function JB.farmLoop()
    while JB.on.farm and mine() and STATE.alive() do
        if not (LP.Team and LP.Team.Name == "Criminal") then
            -- a jailed prisoner flying out of jail is the last thing to automate
            JB.farmStatus = "Paused: you need to be on the Criminal team"
            task.wait(2)
        else
            local spec = JB.nextStore()
            if not spec then
                JB.farmStatus = "Waiting for a store to reopen"
                task.wait(3)
            else
                local part = rawget(spec, "Part")
                local name = JB.storeName(part)
                JB.farmStatus = "Flying to " .. name
                if JB.travel(JB.standPoint(part), JB.farmSpeed) and JB.on.farm then
                    task.wait(0.4)
                    JB.farmStatus = "Robbing " .. name
                    if JB.holdNow(spec, part, JB.STORE_HOLD, 8) then
                        JB.stats.robs += 1
                    end
                    task.wait(1.5)
                end
            end
        end
    end
    JB.farmStatus = "Off"
end

function JB.startFarm()
    if JB._farmRunning then return end
    if wanted then
        WindUI:Notify({
            Title = "Store Farm", Content = "Turn off No-clip + Fly first.",
            Duration = 4, Icon = "triangle-alert",
        })
        JB.on.farm = false
        if JB.toggles.farm then
            task.defer(function() pcall(function() JB.toggles.farm:Set(false) end) end)
        end
        return
    end
    JB._farmRunning = true
    task.spawn(function()
        pcall(JB.farmLoop)
        JB._farmRunning = false
    end)
end

function JB.moneyText()
    local now = LP:GetAttribute("Cash")
    local lines = {}
    if type(now) == "number" and type(JB.cashStart) == "number" then
        local diff = now - JB.cashStart
        table.insert(lines, ("Cash: $%s  (%s$%s since the menu loaded)"):format(
            JB.commas(now), diff >= 0 and "+" or "-", JB.commas(math.abs(diff))))
    end
    table.insert(lines, ("Stores robbed by the script: %d"):format(JB.stats.robs or 0))
    table.insert(lines, "Farm: " .. JB.farmStatus)
    return table.concat(lines, "\n")
end

--- money: robbery markers ------------------------------------------------------------
function JB.markPoint(key, pos, color, text)
    local m = JB.marks[key]
    if not (m and m.hl and m.hl.Parent and m.bb.Parent) then
        JB.unmark(key)
        local att = Instance.new("Attachment")
        att.Parent = workspace.Terrain
        att.WorldPosition = pos

        local bb = Instance.new("BillboardGui")
        bb.AlwaysOnTop    = true
        bb.Size           = UDim2.fromOffset(260, 18)
        bb.LightInfluence = 0
        bb.Adornee        = att
        bb.Parent         = JB.folder()

        local tl = Instance.new("TextLabel")
        tl.BackgroundTransparency = 1
        tl.Size                   = UDim2.fromScale(1, 1)
        tl.Font                   = Enum.Font.GothamBold
        tl.TextSize               = 13
        tl.TextStrokeTransparency = 0.35
        tl.Parent                 = bb

        -- stored in the hl slot so unmark() destroys it with everything else
        m = { hl = att, bb = bb, label = tl }
        JB.marks[key] = m
    end
    m.label.Text       = text
    m.label.TextColor3 = color
end

function JB.markRobberies(keep)
    local root = JB.myRoot()
    local function dist(p) return root and (p - root.Position).Magnitude or 0 end

    for spec in pairs(JB.storeSpecs()) do
        local part = rawget(spec, "Part")
        if part and JB.storeOpen(spec) then
            local st = part.Parent:GetAttribute("RobberyStatus")
            JB.markPoint(part, part.Position + Vector3.new(0, 4, 0), JB.COLOR_REACH,
                ("%s  ·  %s  ·  %dm"):format(JB.storeName(part), st == 2 and "BEING ROBBED" or "OPEN",
                    dist(part.Position)))
            keep[part] = true
        end
    end

    for id, st in pairs(JB.robStatus) do
        local modelName = JB.BIG[JB.robberyName(id)]
        local model = modelName and workspace:FindFirstChild(modelName)
        if model and st ~= 3 then
            local ok, cf, size = pcall(function() return model:GetBoundingBox() end)
            if ok then
                local pos = cf.Position + Vector3.new(0, size.Y / 2 + 10, 0)
                JB.markPoint(model, pos, JB.COLOR_GOLD,
                    ("%s  ·  %s  ·  %dm"):format(JB.robberyName(id),
                        st == 2 and "BEING ROBBED" or "OPEN", dist(pos)))
                keep[model] = true
            end
        end
    end
end

--- wiring ------------------------------------------------------------------------
if JB.IN then
    pcall(JB.hookRobberies)
    pcall(JB.readBounties)
    local bd = JB.RS:FindFirstChild("BountyData")
    if bd then
        STATE.connect(bd.Changed, function() if mine() then pcall(JB.readBounties) end end)
    end

    -- Roblox's idle kick: nudging VirtualUser when Idled fires resets the timer
    STATE.connect(LP.Idled, function()
        if not (JB.on.afk and mine()) then return end
        pcall(function()
            local vu = game:GetService("VirtualUser")
            vu:CaptureController()
            vu:ClickButton2(Vector2.new())
        end)
        JB.stats.afkSaves += 1
    end)

    STATE.connect(RunService.Heartbeat, function()
        if not (JB.on.speed and mine()) then return end
        local c = LP.Character
        local h = c and c:FindFirstChildOfClass("Humanoid")
        if h and h.WalkSpeed ~= JB.speed then
            JB._baseSpeed = JB._baseSpeed or h.WalkSpeed
            h.WalkSpeed = JB.speed
        end
    end)

    task.spawn(function()       -- 5 Hz: markers and the range readout
        while STATE.alive() and mine() do
            pcall(JB.tick)
            task.wait(0.2)
        end
        JB.clearAll()
    end)

    task.spawn(function()       -- 10 Hz: auto arrest, auto rescue
        while STATE.alive() and mine() do
            if JB.on.arrest then pcall(JB.arrestTick) end
            if JB.on.rescue then pcall(JB.rescueTick) end
            if JB.on.rob then pcall(JB.robTick) end
            task.wait(0.1)
        end
    end)

    task.spawn(function()       -- 1 Hz: the text panels
        while STATE.alive() and mine() do
            pcall(JB.refreshPanels)
            task.wait(1)
        end
    end)

    STATE.onCleanup(function()
        JB.on.farm, JB.on.rob = false, false
        JB.clearAll()
        if JB.on.speed then JB.restoreSpeed() end
    end)
end

--=========================================================== Carve Wood
-- Seed reroller. A pull of the lever (ProximityPrompt under TycoonRoot.Reroll
-- .Lever) makes the server roll one seed per pedestal into the tycoon's
-- GeneratedSeeds folder; each seed model carries a GrabSeedPrompt that the
-- server handles on its own, so collecting is just firing that prompt. No
-- distance check was seen: a grab from 14 studs out (prompt range 10) landed.
--
-- The seed models say only which TREE they are (GeneratedTreeType); the rarity
-- comes from the game's own WoodEconomy.GetWoodRarity, so the table here can
-- never drift from what the game shows. The model names (GeneratedSeed_1..N)
-- are reused across rolls, so what to collect is decided from the roll result
-- itself: RollResult lists every seed (SeedInstanceName, SeedName, Rarity,
-- IsMega, IsNew), and the loop waits for exactly those to appear before it
-- grabs. Reading the pedestals after a fixed delay is NOT safe - on a client
-- running at a few fps the new models replicate late, the old ones are still
-- there, and a Legendary was rolled over that way in testing.
--
-- The server announces each roll with RollStarted then RollResult, both to
-- every client, carrying TycoonName and TriggeredByUserId - filtered on both.
-- RollStarted's Cooldown (3.25s at tier 13) is the real gap between pulls.
--
-- Rolling replaces whatever is still on the pedestals. Rare-and-up seeds are
-- meant to raise a ConfirmationRequired first, but a live pull at tier 13 went
-- straight through over an uncollected Legendary and Epic - so this never
-- relies on that guard: it will not pull while anything it wants is still
-- sitting there.
local CW_UNIVERSE = 10404519332

local CW = {
    IN       = game.GameId == CW_UNIVERSE,
    on       = false,
    want     = {},          -- rarity -> true
    grabMega = true,        -- Mega seeds (1 in 5000) regardless of rarity
    grabNew  = true,        -- seeds not yet in the player's index
    appear   = 8,           -- s to wait for a rolled seed to replicate in
    toggles  = {},          -- rarity -> WindUI toggle
    ui       = {},
    rarities = {},
    stats    = { rolls = 0, claimed = 0, byRarity = {}, last = {}, fails = 0 },
    status   = "Off",
    resultN  = 0,           -- bumps on every RollResult of ours
    expect   = {},          -- wanted entries from the last RollResult, not yet collected
    nextRoll = 0,
    pulledAt = 0,
    stuck    = 0,
}

if CW.IN then
    local shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared", 10)
    CW.WE = shared and require(shared:WaitForChild("WoodEconomy"))
    CW.MS = shared and shared:FindFirstChild("MegaSeeds") and require(shared.MegaSeeds)
    CW.remotes = game:GetService("ReplicatedStorage"):WaitForChild("Remotes", 10)
    CW.remotes = CW.remotes and CW.remotes:WaitForChild("SeedReroll", 10)

    -- The game's own list, minus CRAFTED (never rolled; the game's
    -- SeedAutoCollect drops it too).
    for _, r in ipairs(CW.WE and CW.WE.RarityOrder or {}) do
        if r ~= "CRAFTED" then table.insert(CW.rarities, r) end
    end
    -- Default pick: Legendary and up. Everything is one click to change.
    local from = table.find(CW.rarities, "Legendary") or 1
    for i, r in ipairs(CW.rarities) do CW.want[r] = i >= from end
end

function CW.tycoon()
    local root = workspace:FindFirstChild("Tycoons")
    if not root then return nil end
    for _, t in ipairs(root:GetChildren()) do
        if t:GetAttribute("OwnerUserId") == LP.UserId then return t end
    end
    return nil
end

function CW.lever(ty)
    local r = ty:FindFirstChild("TycoonRoot")
    r = r and r:FindFirstChild("Reroll")
    local lev = r and r:FindFirstChild("Lever")
    return lev and lev:FindFirstChild("ProximityPrompt", true)
end

function CW.rarityOf(seed)
    local tree = seed:GetAttribute("GeneratedTreeType")
    if not tree or not CW.WE then return nil end
    local ok, r = pcall(CW.WE.GetWoodRarity, tree)
    return ok and r or nil
end

function CW.isMega(seed)
    if CW.MS then
        local ok, r = pcall(CW.MS.IsMega, seed)
        if ok and r == true then return true end
        if type(CW.MS.Attributes) == "table" then
            for _, a in pairs(CW.MS.Attributes) do
                if type(a) == "string" and seed:GetAttribute(a) == true then return true end
            end
        end
    end
    return seed.Name:find("Mega") ~= nil
end

-- Auto Deliver (further down) plugs in here: CW.extraWant(treeType) says a
-- delivery needs that seed, CW.forceRoll() keeps rolling for one even while the
-- Auto Roll toggle is off.
function CW.wanted(seed)
    if CW.extraWant and CW.extraWant(seed:GetAttribute("GeneratedTreeType")) then return true end
    if CW.grabMega and CW.isMega(seed) then return true end
    if CW.grabNew and seed:GetAttribute("SeedIndexNew") == true then return true end
    local r = CW.rarityOf(seed)
    return r ~= nil and CW.want[r] == true
end

function CW.wantedEntry(e)
    if CW.extraWant and e.IsMega ~= true and CW.extraWant(e.SeedName) then return true end
    if CW.grabMega and e.IsMega == true then return true end
    if CW.grabNew and e.IsNew == true then return true end
    return type(e.Rarity) == "string" and CW.want[e.Rarity] == true
end

-- A seed's grab prompt. Normal seeds carry their own; a Mega seed has none -
-- its prompt is the pedestal's (TycoonRoot.SeedPedestals.SeedPedestalN
-- .SeedHere.GrabSeedPrompt, N = the seed's SeedPedestalIndex). That prompt
-- stays on after the seed is taken, so `pedestal` tells CW.grab to judge by
-- the model instead.
function CW.promptOf(ty, seed)
    local pp = seed:FindFirstChild("GrabSeedPrompt", true)
    if pp and pp:IsA("ProximityPrompt") then return pp, false end
    local idx = seed:GetAttribute("SeedPedestalIndex")
    local peds = idx and ty:FindFirstChild("TycoonRoot")
    peds = peds and peds:FindFirstChild("SeedPedestals")
    local ped = peds and peds:FindFirstChild("SeedPedestal" .. tostring(idx))
    pp = ped and ped:FindFirstChild("GrabSeedPrompt", true)
    if pp and pp:IsA("ProximityPrompt") then return pp, true end
    return nil
end

-- Mid-transformation (the grow-to-4x animation) a Mega seed is not ready.
function CW.seedReady(seed, pp)
    return pp.Enabled and seed:GetAttribute("MegaSeedTransforming") ~= true
end

-- Seeds currently sitting on the pedestals, each with its grab prompt.
function CW.seeds(ty)
    local out = {}
    local f = ty:FindFirstChild("GeneratedSeeds")
    if not f then return out end
    for _, s in ipairs(f:GetChildren()) do
        local pp, onPed = CW.promptOf(ty, s)
        if pp and CW.seedReady(s, pp) then
            table.insert(out, { model = s, prompt = pp, pedestal = onPed })
        end
    end
    return out
end

function CW.note(tree, rarity, mega)
    CW.stats.claimed += 1
    CW.stats.byRarity[rarity] = (CW.stats.byRarity[rarity] or 0) + 1
    table.insert(CW.stats.last, 1, (mega and "MEGA " or "") .. tree .. " (" .. rarity .. ")")
    if #CW.stats.last > 6 then table.remove(CW.stats.last) end
end

-- Fire every grab in `list` at once ({model, prompt, tree, rarity, mega}),
-- then wait for the server to take them. Returns how many are STILL there.
function CW.grab(list)
    if #list == 0 then return 0 end
    for _, s in ipairs(list) do pcall(fireproximityprompt, s.prompt) end
    local t0, left = os.clock(), 0
    repeat
        task.wait(0.1)
        left = 0
        for _, s in ipairs(list) do
            if not s.done then
                local taken = s.model.Parent == nil
                if not s.pedestal then taken = taken or not s.prompt.Parent or not s.prompt.Enabled end
                if taken then
                    s.done = true
                    CW.note(s.tree, s.rarity, s.mega)
                else
                    left += 1
                end
            end
        end
    until left == 0 or os.clock() - t0 > 2 or not mine()
    return left
end

-- The rolled seed an entry describes, once it has actually replicated in:
-- right model name, right tree on it, grab prompt live.
function CW.find(ty, e)
    local f = ty:FindFirstChild("GeneratedSeeds")
    local m = f and type(e.SeedInstanceName) == "string" and f:FindFirstChild(e.SeedInstanceName)
    if not m or m:GetAttribute("GeneratedTreeType") ~= e.SeedName then return nil end
    local pp, onPed = CW.promptOf(ty, m)
    if not (pp and CW.seedReady(m, pp)) then return nil end
    return { model = m, prompt = pp, pedestal = onPed, tree = e.SeedName, rarity = e.Rarity or "?", mega = e.IsMega == true }
end

-- Collect what the last roll said we want. Returns how many are still owed:
-- one that never showed up, or showed up and would not go, is kept in
-- CW.expect so the loop holds off pulling over it.
function CW.claimExpected(ty)
    if #CW.expect == 0 then return 0 end
    CW.status = "Revealing"
    -- a Mega seed plays its grow animation first (MegaSeeds.TransformationDuration)
    local limit = CW.appear
    for _, e in ipairs(CW.expect) do
        if e.IsMega == true then
            limit = CW.appear + (CW.MS and tonumber(CW.MS.TransformationDuration) or 3.25) + 4
            CW.status = "Revealing a Mega seed"
            break
        end
    end
    local t0, hits = os.clock(), {}
    repeat
        local n = 0
        for i, e in ipairs(CW.expect) do
            hits[i] = hits[i] or CW.find(ty, e)
            if hits[i] then n += 1 end
        end
        if n < #CW.expect then task.wait(0.1) end
    until n == #CW.expect or os.clock() - t0 > limit or not mine()

    CW.status = "Collecting"
    local list = {}
    for i in ipairs(CW.expect) do
        if hits[i] then table.insert(list, hits[i]) end
    end
    CW.grab(list)

    local still = {}
    for i, e in ipairs(CW.expect) do
        if not (hits[i] and hits[i].done) then table.insert(still, e) end
    end
    CW.expect = still
    return #still
end

-- Anything wanted already sitting on the pedestals (e.g. when Auto Roll is
-- switched on over an old roll). Read from the models, which is fine here:
-- no roll is in flight, so what is there is what is there.
function CW.claimStanding(ty)
    local list = {}
    for _, s in ipairs(CW.seeds(ty)) do
        if CW.wanted(s.model) then
            s.rarity = CW.rarityOf(s.model) or "?"
            s.tree   = s.model:GetAttribute("GeneratedTreeType") or s.model.Name
            s.mega   = CW.isMega(s.model)
            table.insert(list, s)
        end
    end
    return CW.grab(list)
end

function CW.stop(reason)
    CW.on = false
    if CW.ui.toggle then pcall(function() CW.ui.toggle:Set(false) end) end
    -- after the Set: its callback writes "Off" over the reason
    CW.status = reason or "Off"
end

-- Where to stand so both the lever (12 studs) and every pedestal (10) are in
-- reach: ~5 studs out from the lever toward the pedestals. The prompts only
-- work from there - a live run with the farm holding you 50 studs away got one
-- roll in three minutes. The centre of the pedestals is remembered, because
-- right after a full collect there is no seed left to measure from.
CW.pedCentre = nil
function CW.station(ty, lever)
    local lp = lever.Parent
    local at = (lp:IsA("Attachment") and lp.WorldPosition) or (lp:IsA("BasePart") and lp.Position) or nil
    if not at then return nil end
    local f = ty:FindFirstChild("GeneratedSeeds")
    if f then
        local sum, n = Vector3.zero, 0
        for _, sd in ipairs(f:GetChildren()) do
            local ok, cf = pcall(sd.GetPivot, sd)
            if ok then sum += cf.Position n += 1 end
        end
        if n > 0 then CW.pedCentre = sum / n end
    end
    local toward = CW.pedCentre and Vector3.new(CW.pedCentre.X - at.X, 0, CW.pedCentre.Z - at.Z) or Vector3.zero
    local dir = toward.Magnitude > 0.1 and toward.Unit or Vector3.new(0, 0, 1)
    local stand = at + dir * math.min(5, toward.Magnitude * 0.4) + Vector3.new(0, 0.5, 0)
    return stand, (CW.pedCentre or at)
end

function CW.step()
    local ty = CW.tycoon()
    if not ty then CW.status = "No tycoon of yours found" task.wait(1) return end

    -- Auto Roll comes after chopping, replanting, carving and collecting: it
    -- only takes the character while none of them needs it, and gives it back
    -- after every pull. CW.mover is filled in by the farm section further down.
    local M = CW.mover
    if M then
        if M.othersWant() or not M.acquire("roll", 0) then
            CW.status = "Waiting: farm first"
            task.wait(0.3)
            return
        end
        local lever = CW.lever(ty)
        local stand, look = lever and CW.station(ty, lever)
        if stand then M.moveTo(stand, look) task.wait(0.15) end
    end
    local ok, err = pcall(CW.stepAtStation, ty)
    if M then M.release("roll") end
    if not ok then error(err, 0) end
end

function CW.stepAtStation(ty)
    -- 1. never pull over something we want: claim first, and hold if it won't go
    local left = CW.claimExpected(ty)
    if left == 0 then left = CW.claimStanding(ty) end
    if left > 0 then
        CW.stuck += 1
        CW.stats.fails += 1
        CW.status = ("Could not collect %d seed(s), retrying"):format(left)
        if CW.stuck >= 3 then
            CW.expect = {}
            CW.stop("Stopped: a wanted seed would not collect (inventory full?)")
            pcall(function()
                WindUI:Notify({ Title = "Auto Roll", Content = "Stopped: a seed you want would not collect.", Duration = 5, Icon = "alert-triangle" })
            end)
        end
        task.wait(0.5)
        return
    end
    CW.stuck = 0

    -- 2. roll
    local lever = CW.lever(ty)
    if not (lever and lever.Enabled) then CW.status = "Waiting for the lever" task.wait(0.25) return end
    local wait = CW.nextRoll - os.clock()
    if wait > 0 then CW.status = "Cooldown" task.wait(math.min(wait, 0.25)) return end

    local n0 = CW.resultN
    CW.pulledAt = os.clock()
    CW.status = "Rolling"
    pcall(fireproximityprompt, lever)

    local t0 = os.clock()
    while CW.resultN == n0 and os.clock() - t0 < 3 and mine() do task.wait(0.05) end
    if CW.resultN == n0 then
        CW.status = "Roll did not go through, retrying"
        CW.nextRoll = os.clock() + 1
        return
    end
    CW.stats.rolls += 1
    -- 3. the next step collects CW.expect, waiting for each seed to replicate
end

function CW.statusText()
    local parts = {}
    for _, r in ipairs(CW.rarities) do
        local n = CW.stats.byRarity[r]
        if n then table.insert(parts, r .. " " .. n) end
    end
    local s = ("%s\nRolls: %d   Collected: %d"):format(CW.status, CW.stats.rolls, CW.stats.claimed)
    if #parts > 0 then s ..= "\n" .. table.concat(parts, ", ") end
    if #CW.stats.last > 0 then s ..= "\nLast: " .. table.concat(CW.stats.last, ", ") end
    return s
end

if CW.IN and CW.remotes then
    local function ours(p)
        if type(p) ~= "table" or p.TriggeredByUserId ~= LP.UserId then return false end
        local ty = CW.tycoon()
        return ty ~= nil and p.TycoonName == ty.Name
    end

    local started = CW.remotes:FindFirstChild("RollStarted")
    if started then
        STATE.connect(started.OnClientEvent, function(p)
            if not (mine() and ours(p)) then return end
            local cd = tonumber(p.Cooldown) or 3.25
            CW.nextRoll = os.clock() + cd + 0.05
        end)
    end

    local result = CW.remotes:FindFirstChild("RollResult")
    if result then
        STATE.connect(result.OnClientEvent, function(p)
            if not (mine() and ours(p)) then return end
            local want = {}
            if type(p.Results) == "table" then
                for _, e in ipairs(p.Results) do
                    if type(e) == "table" and CW.wantedEntry(e) then table.insert(want, e) end
                end
            end
            CW.expect = want
            CW.resultN += 1
        end)
    end

    -- Should the server ever ask "are you sure?", it is only over seeds the
    -- loop already decided to pass on - but confirm only if that is still
    -- true, and only for a pull we made in the last few seconds.
    local ask, confirm = CW.remotes:FindFirstChild("ConfirmationRequired"), CW.remotes:FindFirstChild("ConfirmReroll")
    if ask and confirm then
        STATE.connect(ask.OnClientEvent, function(p)
            if not (mine() and (CW.on or (CW.forceRoll and CW.forceRoll()))) or type(p) ~= "table" then return end
            local ty = CW.tycoon()
            if not ty or p.TycoonName ~= ty.Name or os.clock() - CW.pulledAt > 4 then return end
            if #CW.expect > 0 then return end
            for _, s in ipairs(CW.seeds(ty)) do
                if CW.wanted(s.model) then return end
            end
            pcall(function() confirm:FireServer({ TycoonName = p.TycoonName, Token = p.Token }) end)
        end)
    end

    task.spawn(function()
        while STATE.alive() and mine() do
            local forced = not CW.on and CW.forceRoll and CW.forceRoll()
            if CW.on or forced then
                local ok, err = pcall(CW.step)
                if not ok then CW.status = "Error: " .. tostring(err) task.wait(1) end
            else
                task.wait(0.25)
            end
        end
    end)

    task.spawn(function()       -- 2 Hz: the status panel
        while STATE.alive() and mine() do
            if CW.ui.status then pcall(function() CW.ui.status:SetDesc(CW.statusText()) end) end
            task.wait(0.5)
        end
    end)

    STATE.onCleanup(function() CW.on = false end)
end

--=========================================================== Carve Wood farm
-- Auto Plant, Auto Chop, Auto Carve, Auto Collect.
--
-- Remotes: the game's own Client:TellServer / AskServer / CreateKeyHash are
-- TRAPS - called from an executor they fire ReplicatedStorage.HAX (they look
-- for writefile in getfenv and for a [C] caller). So none of them is ever
-- called here. The name -> remote mapping is recomputed instead: the key is
-- xor(name, LocalPlayer.Name .. PlaceVersion .. "xdd"), looked up in the
-- already-populated Client.CachedRemotes, which gives the GUID of the remote
-- under ReplicatedStorage.REM. The GUIDs change per session, so they are
-- resolved every time, never stored in this file.
--
-- Plant: PlantSeedFromInventory (RemoteFunction) {PlanterIndex, TreeType,
--   TycoonName} - the inventory UI path; needs no tool and no walking. An empty
--   planter is a Model with TreePlanter=true, TreePlanterStatus "Empty", not
--   constructing, visible. The GIGA planter (MegaPlanter=true) only takes Mega
--   seeds, which this path refuses, so it is skipped.
-- Chop: AxeHit (RemoteEvent) {SwingIndex = 1|2, AxeId}. It names no tree - the
--   server picks the one you stand at - so the character is moved beside each
--   mature tree (planter TreePlanterStatus "Mature", tree tagged ChoppableTree)
--   with an axe equipped. The game's AxeController sends AxeEquip itself on
--   the equip. Chips home in and are collected by the game's own pickup code;
--   logs only collect after you leave their 8.5 stud radius and come back.
-- Carve: the robot lathe's LogWoodStack takes a log through StoreRawWoodPrompt,
--   which the game enables only while a raw-wood tool is EQUIPPED, you are in
--   your own tycoon and the stack is not full (20). So: stand at the stack,
--   equip the log, wait for the prompt to come on, fire it.
local FARM = {
    plant     = false,
    chop      = false,
    carve     = false,
    plantSel  = {},         -- TreeType -> true
    carveSel  = {},         -- TreeType -> true (logs matched through RawWoodId)
    carveMega = false,      -- also feed Mega logs of a selected wood
    carveMut  = true,       -- also feed mutated logs (Harvestblessed, Electrified...)
    plantBackoff = setmetatable({}, { __mode = "k" }),  -- planter -> retry after (os.clock)
    plantMega = true,       -- best Mega seed into the GIGA planter when it is empty
    swing     = 0.8,        -- s between axe hits, before the axe's own speed
    status    = { plant = "Off", chop = "Off", carve = "Off" },
    stats     = { planted = 0, chopped = 0, stored = 0 },
    ui        = {},
    options   = {},         -- "Doom (Mythical)" labels, rarest last
    labelType = {},         -- label -> TreeType
    typeLabel = {},         -- TreeType -> label
}

local CS = game:GetService("CollectionService")

-- What Auto Deliver currently needs, rebuilt on every delivery pass and read by
-- plant / chop / carve / water / roll (see the deliver section). Empty = no say.
FARM.deliver = false
FARM.D = { plantFirst = {}, noPlant = {}, roll = {}, chop = {}, water = {}, carveBlock = {}, getFert = {}, getCan = {}, keepFert = {}, keepCans = {} }

-- The seed list for the two pickers, straight from the game's own tables.
if CW.IN and CW.WE and type(CW.WE.TreeTypesByRarity) == "table" then
    -- The Fall Update's Halloween seeds (Shared.HalloweenSeeds, mostly from the
    -- Halloween Box) are missing from TreeTypesByRarity - only
    -- WoodEconomy.GetWoodRarity knows them - so file those under their rarity too.
    local extra = {}
    pcall(function()
        local hs = require(game:GetService("ReplicatedStorage").Shared:FindFirstChild("HalloweenSeeds"))
        local listed = {}
        for _, list in pairs(CW.WE.TreeTypesByRarity) do
            for _, t in ipairs(list) do listed[t] = true end
        end
        for _, t in ipairs(hs.TreeTypes or {}) do
            local r = not listed[t] and CW.WE.GetWoodRarity(t)
            if type(r) == "string" then
                extra[r] = extra[r] or {}
                table.insert(extra[r], t)
            end
        end
    end)
    for _, r in ipairs(CW.rarities) do
        local list = type(CW.WE.TreeTypesByRarity[r]) == "table" and table.clone(CW.WE.TreeTypesByRarity[r]) or {}
        for _, t in ipairs(extra[r] or {}) do table.insert(list, t) end
        if #list > 0 then
            for _, t in ipairs(list) do
                local label = ("%s (%s)"):format(tostring(t), r)
                table.insert(FARM.options, label)
                FARM.labelType[label] = tostring(t)
                FARM.typeLabel[tostring(t)] = label
            end
        end
    end
end

--- remotes -----------------------------------------------------------------------
local function xorKey(s, k)
    local out = table.create(#s)
    for i = 1, #s do
        out[i] = string.char(bit32.bxor(s:byte(i), k:byte((i - 1) % #k + 1)))
    end
    return table.concat(out)
end

function FARM.remote(name)
    local ok, client = pcall(require, game:GetService("ReplicatedFirst"):FindFirstChild("Client"))
    if not ok or type(client) ~= "table" or type(client.CachedRemotes) ~= "table" then return nil end
    local guid = client.CachedRemotes[xorKey(name, LP.Name .. game.PlaceVersion .. "xdd")]
    local rem = guid and game:GetService("ReplicatedStorage"):FindFirstChild("REM")
    return rem and rem:FindFirstChild(tostring(guid)) or nil
end

-- InvokeServer can hang forever; never let it take the loop with it.
function FARM.invoke(rem, payload, timeout)
    local done, res = false, nil
    task.spawn(function()
        local ok, r = pcall(rem.InvokeServer, rem, payload)
        res = ok and r or nil
        done = true
    end)
    local t0 = os.clock()
    while not done and os.clock() - t0 < (timeout or 6) do task.wait(0.05) end
    return done, res
end

--- character -------------------------------------------------------------------
local function root()
    local c = LP.Character
    local h = c and c:FindFirstChildOfClass("Humanoid")
    local r = c and c:FindFirstChild("HumanoidRootPart")
    if h and r and h.Health > 0 then return r, h end
    return nil
end

local function moveTo(pos, lookAt)
    local r = root()
    if not r then return false end
    local look = lookAt and Vector3.new(lookAt.X, pos.Y, lookAt.Z) or pos + r.CFrame.LookVector
    if (look - pos).Magnitude < 0.05 then look = pos + Vector3.new(0, 0, -1) end
    r.AssemblyLinearVelocity = Vector3.zero
    r.CFrame = CFrame.lookAt(pos, look)
    return true
end

local function tools()
    local out = {}
    local bp = LP:FindFirstChildOfClass("Backpack")
    for _, holder in ipairs({ bp, LP.Character }) do
        if holder then
            for _, t in ipairs(holder:GetChildren()) do
                if t:IsA("Tool") then table.insert(out, t) end
            end
        end
    end
    return out
end

-- Swapping straight from one tool to another does not stick: EquipTool(seed)
-- while an axe is out puts the axe away and the seed never arrives - the
-- game's own unequip handling for the old tool cancels the new one. So clear
-- the hands first, wait until they really are empty, then equip, and check the
-- tool is still in hand a moment later before calling it done.
local function equip(tool)
    local function held()
        local c = LP.Character
        return c and c:FindFirstChildOfClass("Tool")
    end
    local _, h = root()
    if not h or not tool or not tool.Parent then return false end
    if tool.Parent == LP.Character then return true end

    if held() then
        pcall(function() h:UnequipTools() end)
        local t0 = os.clock()
        while held() and os.clock() - t0 < 1 do task.wait(0.05) end
        task.wait(0.1)
    end

    for _ = 1, 3 do
        if not tool.Parent then return false end
        pcall(function() h:EquipTool(tool) end)
        local t0 = os.clock()
        while tool.Parent ~= LP.Character and os.clock() - t0 < 0.5 do task.wait(0.05) end
        if tool.Parent == LP.Character then
            task.wait(0.2)
            if tool.Parent == LP.Character then return true end
        end
    end
    return tool.Parent == LP.Character
end

--- plant -------------------------------------------------------------------------
function FARM.emptyPlanters(ty)
    local out = {}
    local folder = ty:FindFirstChild("TycoonRoot")
    folder = folder and folder:FindFirstChild("Planters")
    if not folder then return out end
    for _, m in ipairs(folder:GetChildren()) do
        if m:GetAttribute("TreePlanter") == true
        and m:GetAttribute("TreePlanterStatus") == "Empty"
        and m:GetAttribute("TreePlanterVisible") ~= false
        and m:GetAttribute("TreePlanterConstructing") ~= true
        and m:GetAttribute("MegaPlanter") ~= true
        and tonumber(m:GetAttribute("PlanterIndex"))
        and not (FARM.sprinkler and m:GetAttribute("PlanterIndex") == FARM.sprinklerIdx)   -- Auto Sprinkler's Bubble planter
        and (FARM.plantBackoff[m] or 0) < os.clock() then
            table.insert(out, m)
        end
    end
    table.sort(out, function(a, b) return a:GetAttribute("PlanterIndex") < b:GetAttribute("PlanterIndex") end)
    return out
end

-- Selected seeds on hand, most valuable first. A seed tool is TreeSeed=true;
-- Mega seeds are left out (only the GIGA planter takes them).
-- Auto Deliver bends this: a tree a delivery needs logs of is planted first
-- (even with Auto Plant off or the seed unticked), and a seed a delivery needs
-- AS a seed is kept back.
function FARM.plantableSeeds()
    local out = {}
    local D = FARM.D
    for _, t in ipairs(tools()) do
        local tree = t:GetAttribute("TreeType")
        if t:GetAttribute("TreeSeed") == true and tree
        and (D.plantFirst[tree] or (FARM.plant and FARM.plantSel[tree] and not D.noPlant[tree]))
        and t:GetAttribute("MegaSeedId") == nil and not CW.isMega(t) then
            table.insert(out, t)
        end
    end
    table.sort(out, function(a, b)
        local da, db = D.plantFirst[a:GetAttribute("TreeType")] and 1 or 0, D.plantFirst[b:GetAttribute("TreeType")] and 1 or 0
        if da ~= db then return da > db end
        return (tonumber(a:GetAttribute("SeedExpectedBaseValue")) or 0) > (tonumber(b:GetAttribute("SeedExpectedBaseValue")) or 0)
    end)
    return out
end

-- The server wants you AT the planter ("Move closer to the planter"), so each
-- one is walked to first. Returns true if the character was moved.
function FARM.plantPass(ty)
    local planters = FARM.emptyPlanters(ty)
    if #planters == 0 then FARM.status.plant = "All planters busy" return false end
    if next(FARM.plantSel) == nil and next(FARM.D.plantFirst) == nil then FARM.status.plant = "No seeds selected" return false end
    if #FARM.plantableSeeds() == 0 then FARM.status.plant = "No selected seeds on hand" return false end
    local rem = FARM.remote("PlantSeedFromInventory")
    if not (rem and rem:IsA("RemoteFunction")) then FARM.status.plant = "Plant remote not found" return false end

    local moved = false
    for _, planter in ipairs(planters) do
        if not ((FARM.plant or FARM.deliver) and mine()) then return moved end
        local seeds = FARM.plantableSeeds()
        if #seeds == 0 then FARM.status.plant = "No selected seeds on hand" return moved end
        local tree = seeds[1]:GetAttribute("TreeType")

        local r = root()
        if not r then return moved end
        local at = planter:GetPivot().Position
        local flat = Vector3.new(r.Position.X - at.X, 0, r.Position.Z - at.Z)
        local dir = flat.Magnitude > 0.1 and flat.Unit or Vector3.new(0, 0, 1)
        local far = (r.Position - at).Magnitude
        moveTo(at + dir * 6 + Vector3.new(0, 3, 0), at)
        moved = true
        -- after a long hop the server still has us at the old spot for a moment
        -- (a 250 stud jump was refused twice at 0.2s)
        task.wait(far > 60 and 0.8 or 0.2)

        FARM.status.plant = ("Planting %s in planter %d"):format(tree, planter:GetAttribute("PlanterIndex"))
        local done, res = FARM.invoke(rem, {
            PlanterIndex = planter:GetAttribute("PlanterIndex"),
            TreeType     = tree,
            TycoonName   = ty.Name,
        })
        local okRes = done and (res == true or (type(res) == "table" and res.Success ~= false))
        -- believe the planter, not the reply
        local t0 = os.clock()
        while planter:GetAttribute("TreePlanterStatus") == "Empty" and os.clock() - t0 < 2 do task.wait(0.1) end
        if planter:GetAttribute("TreePlanterStatus") ~= "Empty" then
            FARM.stats.planted += 1
        else
            local why = type(res) == "table" and (res.Message or res.Error) or nil
            FARM.status.plant = "Plant refused" .. (why and (": " .. tostring(why)) or (okRes and "" or " (no reply)"))
            -- leave this one alone for a bit rather than asking every second
            FARM.plantBackoff[planter] = os.clock() + 20
        end
        task.wait(0.2)
    end
    if FARM.status.plant:find("^Planting") then FARM.status.plant = "Planted" end
    return moved
end

-- The GIGA planter takes Mega seeds only, and not through the inventory path
-- (PlantSeedFromInventory refuses them). The game plants one the way a player
-- throws it: the Mega seed tool in hand, standing at the planter, then
-- PlantEquippedSeed {PlanterIndex, DirectlyTargeted, TargetedInstance,
-- TycoonName}. The client plays a ~0.6s throw first, so this waits as long.
-- Found once and cached: a full GetDescendants of the tycoon is far too heavy
-- to run from the priority checks several times a second.
local gigaCache = { ty = nil, model = nil, at = 0 }
function FARM.gigaPlanter(ty)
    local c = gigaCache
    if c.ty == ty and c.model and c.model.Parent and c.model:IsDescendantOf(ty) then return c.model end
    if c.ty == ty and not c.model and os.clock() - c.at < 30 then return nil end
    c.ty, c.model, c.at = ty, nil, os.clock()
    for _, m in ipairs(ty:GetDescendants()) do
        if m:IsA("Model") and m:GetAttribute("MegaPlanter") == true and m:GetAttribute("TreePlanter") == true then
            c.model = m
            break
        end
    end
    return c.model
end

function FARM.megaSeeds()
    local out = {}
    for _, t in ipairs(tools()) do
        if t:GetAttribute("TreeSeed") == true and t:GetAttribute("MegaSeedId") ~= nil then table.insert(out, t) end
    end
    table.sort(out, function(a, b)
        return (tonumber(a:GetAttribute("SeedExpectedBaseValue")) or 0) > (tonumber(b:GetAttribute("SeedExpectedBaseValue")) or 0)
    end)
    return out
end

function FARM.gigaReady(ty)
    local g = FARM.gigaPlanter(ty)
    if not g then return nil end
    if g:GetAttribute("TreePlanterStatus") ~= "Empty" or g:GetAttribute("GigaPlanterUnlocked") == false
    or g:GetAttribute("TreePlanterConstructing") == true or g:GetAttribute("TreePlanterVisible") == false
    or (FARM.plantBackoff[g] or 0) >= os.clock() then
        return nil
    end
    return g
end

-- Returns true if the character was moved.
function FARM.megaPass(ty)
    if not FARM.plantMega then return false end
    local g = FARM.gigaReady(ty)
    if not g then return false end
    local seeds = FARM.megaSeeds()
    if #seeds == 0 then FARM.status.plant = "GIGA planter empty, no Mega seeds on hand" return false end
    local rem = FARM.remote("PlantEquippedSeed")
    if not (rem and rem:IsA("RemoteFunction")) then FARM.status.plant = "Mega plant remote not found" return false end

    local seed = seeds[1]
    local r = root()
    if not r then return false end
    local at = g:GetPivot().Position
    local far = (r.Position - at).Magnitude
    local flat = Vector3.new(r.Position.X - at.X, 0, r.Position.Z - at.Z)
    local dir = flat.Magnitude > 0.1 and flat.Unit or Vector3.new(0, 0, 1)
    moveTo(at + dir * 10 + Vector3.new(0, 4, 0), at)
    task.wait(far > 60 and 0.8 or 0.2)

    FARM.status.plant = "Planting " .. seed.Name .. " in the GIGA planter"
    if not equip(seed) then FARM.status.plant = "Could not hold " .. seed.Name return true end
    task.wait(0.6)
    local done, res = FARM.invoke(rem, {
        PlanterIndex     = tonumber(g:GetAttribute("PlanterIndex")) or 0,
        DirectlyTargeted = false,
        TargetedInstance = nil,
        TycoonName       = ty.Name,
    })
    local t0 = os.clock()
    while g:GetAttribute("TreePlanterStatus") == "Empty" and os.clock() - t0 < 3 do task.wait(0.1) end
    if g:GetAttribute("TreePlanterStatus") ~= "Empty" then
        FARM.stats.planted += 1
        FARM.status.plant = "Planted " .. seed.Name .. " in the GIGA planter"
    else
        local why = type(res) == "table" and (res.Message or res.Error) or nil
        FARM.status.plant = "GIGA planter refused" .. (why and (": " .. tostring(why)) or (done and "" or " (no reply)"))
        FARM.plantBackoff[g] = os.clock() + 60
    end
    pcall(function() local _, h = root() if h then h:UnequipTools() end end)
    return true
end

--- chop --------------------------------------------------------------------------
function FARM.readyTrees(ty)
    local out = {}
    local folder = ty:FindFirstChild("TycoonRoot")
    folder = folder and folder:FindFirstChild("Planters")
    if not folder then return out end
    for _, planter in ipairs(folder:GetChildren()) do
        if planter:GetAttribute("TreePlanterStatus") == "Mature" then
            for _, d in ipairs(planter:GetChildren()) do
                if d:IsA("Model") and CS:HasTag(d, "ChoppableTree") and d:GetAttribute("TreeFelling") ~= true then
                    table.insert(out, { planter = planter, tree = d })
                    break
                end
            end
        end
    end
    return out
end

-- Best axe on hand by damage.
function FARM.bestAxe()
    local best, bestDmg
    for _, t in ipairs(tools()) do
        if t:GetAttribute("AxeTool") == true then
            local d = tonumber(t:GetAttribute("AxeDamage")) or 0
            if not best or d > bestDmg then best, bestDmg = t, d end
        end
    end
    return best
end

function FARM.chopOne(ty, entry, hitRem)
    local tree = entry.tree
    local base = tree:GetPivot().Position
    local r = root()
    if not r then return false end

    -- stand 4 studs off the trunk on whichever side we are already on
    local flat = Vector3.new(r.Position.X - base.X, 0, r.Position.Z - base.Z)
    local dir = flat.Magnitude > 0.1 and flat.Unit or Vector3.new(0, 0, 1)
    local stand = base + dir * 4 + Vector3.new(0, 3, 0)
    moveTo(stand, base)
    task.wait(0.15)

    local axe = FARM.bestAxe()
    if not axe then FARM.status.chop = "No axe" return false end
    if not equip(axe) then FARM.status.chop = "Could not equip the axe" return false end
    task.wait(0.2)       -- let the game's AxeController see the equip and tell the server

    local speed = tonumber(axe:GetAttribute("AxeAttackSpeed")) or 1
    local gap = math.max(0.45, FARM.swing / math.max(speed, 0.1))
    local swingIndex, t0 = 1, os.clock()
    local name = tree.Name
    -- Stay put while hits land. Only when TreeChopHits stops climbing for a
    -- few swings (knocked off, slid away, server lost us) is the character
    -- put back beside the trunk.
    local function hits() return tonumber(tree:GetAttribute("TreeChopHits")) or 0 end
    local lastHits, dry = hits(), 0
    while (FARM.chop or FARM.deliver or FARM.forceChop) and mine() and tree.Parent and tree:GetAttribute("TreeFelling") ~= true
    and CS:HasTag(tree, "ChoppableTree") and os.clock() - t0 < 30 do
        -- Auto Roll grabbing a seed puts the seed in hand; take the axe back
        if axe.Parent ~= LP.Character then equip(axe) task.wait(0.15) end
        if dry >= 3 then
            FARM.status.chop = ("Hits not landing on %s, moving back"):format(name)
            moveTo(stand, base)
            task.wait(0.2)
            dry = 0
        end
        FARM.status.chop = ("Chopping %s (%s/%s)"):format(name,
            tostring(tree:GetAttribute("TreeChopHits") or "?"), tostring(tree:GetAttribute("TreeChopHitsRequired") or "?"))
        pcall(function()
            hitRem:FireServer({ SwingIndex = swingIndex, AxeId = tostring(axe:GetAttribute("AxeId") or "") })
        end)
        swingIndex = swingIndex == 1 and 2 or 1
        task.wait(gap)
        local now = hits()
        if now > lastHits then lastHits, dry = now, 0 else dry += 1 end
    end

    local felled = tree:GetAttribute("TreeFelling") == true or not tree.Parent or not CS:HasTag(tree, "ChoppableTree")
    if not felled then FARM.status.chop = "Tree did not fall" return false end

    -- Logs land ~1.6s after the fall and only collect once you have left
    -- their radius and come back.
    FARM.status.chop = "Collecting drops"
    task.wait(2.2)
    moveTo(stand + dir * 12, base)
    task.wait(0.4)
    moveTo(base + dir * 2 + Vector3.new(0, 3, 0), base)
    task.wait(1.5)
    FARM.stats.chopped += 1
    return true
end

function FARM.chopPass(ty)
    local trees = FARM.readyTrees(ty)
    if not FARM.chop then
        -- only here for a delivery: fell just the trees it needs logs from
        local only = {}
        for _, e in ipairs(trees) do
            if FARM.D.chop[e.planter:GetAttribute("TreeType") or ""] then table.insert(only, e) end
        end
        trees = only
    end
    if #trees == 0 then FARM.status.chop = "No trees ready" return false end
    local hitRem = FARM.remote("AxeHit")
    if not (hitRem and hitRem:IsA("RemoteEvent")) then FARM.status.chop = "Axe remote not found" return false end
    for _, e in ipairs(trees) do
        if not ((FARM.chop or FARM.deliver) and mine()) then break end
        FARM.chopOne(ty, e, hitRem)
    end
    FARM.status.chop = "Done, waiting for trees"
    return true
end

--- water -------------------------------------------------------------------------
-- Auto Water: keeps a watering-can boost on the growing tree with the MOST time
-- left, using only the can tiers picked in the list (strongest first).
--
-- The game's TreePlanters:TryWaterHoveredPlanter does it with the can EQUIPPED,
-- standing within WaterTowerConfig.FutureWatering.MaxInteractionDistance (35)
-- of the planter: AskServer("WaterPlanterWithEquippedCan", {PlanterIndex,
-- ItemId = the can's WateringCanItemId, DirectlyTargeted = false,
-- TargetedInstance = nil, TycoonName}), reply {Success, Message}. A can is a
-- Tool with ManagedWateringCanTool=true and WateringEnabled=true; one tool per
-- tier, stacked (WateringCanCount), tier in WateringCanMultiplier (1x-256x).
-- A watered planter carries TreeWateringBoostMultiplier and
-- TreeWateringBoostEndsAt (server time); one that is still boosted is skipped,
-- so no can is spent on top of a running boost. Cans do nothing on the Mega
-- planter, which is left out.
FARM.water     = false
FARM.waterSel  = {}         -- multiplier (number) -> true
FARM.status.water = "Off"
FARM.stats.watered = 0
FARM.WATER_TIERS = { 1, 2, 4, 8, 16, 32, 64, 128, 256 }
FARM.waterBackoff = setmetatable({}, { __mode = "k" })  -- planter -> retry after

-- Selected cans on hand, strongest first.
function FARM.waterCans()
    local out = {}
    for _, t in ipairs(tools()) do
        local mult = tonumber(t:GetAttribute("WateringCanMultiplier"))
        if t:GetAttribute("ManagedWateringCanTool") == true and t:GetAttribute("WateringEnabled") == true
        and mult and FARM.waterSel[mult] and (tonumber(t:GetAttribute("WateringCanCount")) or 1) > 0
        and not (FARM.deliver and FARM.D.keepCans and FARM.D.keepCans[mult])
        and type(t:GetAttribute("WateringCanItemId")) == "string" then
            table.insert(out, t)
        end
    end
    table.sort(out, function(a, b)
        return (tonumber(a:GetAttribute("WateringCanMultiplier")) or 0) > (tonumber(b:GetAttribute("WateringCanMultiplier")) or 0)
    end)
    return out
end

-- Seconds until a growing planter's tree is ready, read the way the planter's
-- own display reads it.
function FARM.growthLeft(p, now)
    local ends = tonumber(p:GetAttribute("TreeGrowthEndsAt"))
    if ends and ends > 1e9 then return math.max(0, ends - now) end
    local rem = tonumber(p:GetAttribute("TreeGrowthRemainingSeconds"))
    if rem then return math.max(0, rem) end
    local dur = tonumber(p:GetAttribute("TreeGrowthDuration")) or 0
    return dur * (1 - math.clamp(tonumber(p:GetAttribute("TreeGrowthProgress")) or 0, 0, 1))
end

-- The growing planter with the most time left, if it is not boosted already.
-- Returns planter, secondsLeft - or nil and why.
function FARM.waterTarget(ty)
    local folder = ty:FindFirstChild("TycoonRoot")
    folder = folder and folder:FindFirstChild("Planters")
    if not folder then return nil, "No planters" end
    local now = workspace:GetServerTimeNow()
    local best, bestLeft
    local urgent, urgentLeft      -- a tree a delivery is waiting on: soonest first
    for _, p in ipairs(folder:GetChildren()) do
        if p:GetAttribute("TreePlanter") == true and p:GetAttribute("TreePlanterStatus") == "Growing"
        and p:GetAttribute("TreePlanterVisible") ~= false and p:GetAttribute("TreePlanterConstructing") ~= true
        and p:GetAttribute("MegaPlanter") ~= true and tonumber(p:GetAttribute("PlanterIndex")) then
            local left = FARM.growthLeft(p, now)
            if not best or left > bestLeft then best, bestLeft = p, left end
            if FARM.D.water[p:GetAttribute("TreeType") or ""]
            and (tonumber(p:GetAttribute("TreeWateringBoostEndsAt")) or 0) <= now
            and (FARM.waterBackoff[p] or 0) <= os.clock()
            and (not urgent or left < urgentLeft) then
                urgent, urgentLeft = p, left
            end
        end
    end
    if urgent then return urgent, urgentLeft end
    if not best then return nil, "No trees growing" end
    local boostEnds = tonumber(best:GetAttribute("TreeWateringBoostEndsAt")) or 0
    if boostEnds > now then
        return nil, ("%s boosted %dx, %ds left"):format(best.Name,
            tonumber(best:GetAttribute("TreeWateringBoostMultiplier")) or 0, math.floor(boostEnds - now))
    end
    if (FARM.waterBackoff[best] or 0) > os.clock() then return nil, "Waiting to retry " .. best.Name end
    return best, bestLeft
end

function FARM.waterWants(ty)
    if not (FARM.up("water") and next(FARM.waterSel) ~= nil) then return false end
    if #FARM.waterCans() == 0 then return false end
    return FARM.waterTarget(ty) ~= nil
end

function FARM.hms(s)
    s = math.floor(s)
    return ("%dh %02dm"):format(s // 3600, (s % 3600) // 60)
end

-- Returns true if the character was moved.
function FARM.waterPass(ty)
    if next(FARM.waterSel) == nil then FARM.status.water = "No cans selected" return false end
    local cans = FARM.waterCans()
    if #cans == 0 then FARM.status.water = "No selected cans on hand" return false end
    local planter, left = FARM.waterTarget(ty)
    if not planter then FARM.status.water = "Idle: " .. tostring(left) return false end
    local rem = FARM.remote("WaterPlanterWithEquippedCan")
    if not (rem and rem:IsA("RemoteFunction")) then FARM.status.water = "Water remote not found" return false end

    local r = root()
    if not r then return false end
    local at = planter:GetPivot().Position
    local far = (r.Position - at).Magnitude
    local flat = Vector3.new(r.Position.X - at.X, 0, r.Position.Z - at.Z)
    local dir = flat.Magnitude > 0.1 and flat.Unit or Vector3.new(0, 0, 1)
    moveTo(at + dir * 6 + Vector3.new(0, 3, 0), at)
    task.wait(far > 60 and 0.8 or 0.2)

    local can = cans[1]
    local mult = tonumber(can:GetAttribute("WateringCanMultiplier")) or 0
    FARM.status.water = ("Watering %s (%s left) with %dx"):format(planter.Name, FARM.hms(left), mult)
    if not equip(can) then FARM.status.water = "Could not hold the can" return true end
    task.wait(0.3)
    local done, res = FARM.invoke(rem, {
        PlanterIndex     = tonumber(planter:GetAttribute("PlanterIndex")),
        ItemId           = can:GetAttribute("WateringCanItemId"),
        DirectlyTargeted = false,
        TargetedInstance = nil,
        TycoonName       = ty.Name,
    })
    -- believe the planter, not the reply
    local t0 = os.clock()
    local function boosted() return (tonumber(planter:GetAttribute("TreeWateringBoostEndsAt")) or 0) > workspace:GetServerTimeNow() end
    while not boosted() and os.clock() - t0 < 2 do task.wait(0.1) end
    if boosted() then
        FARM.stats.watered += 1
        FARM.status.water = ("Watered %s with %dx"):format(planter.Name, mult)
    else
        local why = type(res) == "table" and (res.Message or res.Error) or nil
        FARM.status.water = "Water refused" .. (why and (": " .. tostring(why)) or (done and "" or " (no reply)"))
        FARM.waterBackoff[planter] = os.clock() + 20
    end
    pcall(function() local _, h = root() if h then h:UnequipTools() end end)
    return true
end

--- upkeep ------------------------------------------------------------------------
-- Auto Upkeep groups everything that keeps the planters boosted and restocked,
-- under one master switch (FARM.upkeep):
--   Use Watering Cans   the Auto Water above (FARM.water / FARM.waterSel)
--   Use Fertilizer      FARM.fert / FARM.fertSel
--   Collect Cans        FARM.canCollect at FARM.canAt (multiplier) or better
--   Collect Fertilizer  FARM.fertCollect at FARM.fertAt (stage) or better
--
-- Fertilizer (Shared.FertilizerConfig, TreePlanters:TryFertilizeHoveredPlanter):
-- hold the fertilizer Tool (ManagedFertilizerTool, FertilizerId,
-- FertilizerMultiplier, stack in InventoryItemCount), stand within 35 studs,
-- InvokeServer "FertilizePlanter" {PlanterIndex, ItemId = FertilizerId,
-- DirectlyTargeted = false, TargetedInstance = nil, TycoonName}. It sits on the
-- planter, not the tree, for 12-72h: TreeFertilizerId / TreeFertilizerMultiplier
-- / TreeFertilizerEndsAt (os.time). Any Empty / Growing / Mature tree planter
-- takes it except the Mega one. Only planters with nothing active are
-- fertilized, so none is ever spent on top of a running one.
--
-- Collecting (Shared.WaterTowerConfig / CompostBinConfig): each Water Tower
-- slot is a WateringCan tagged WaterTowerLiveWateringCan that climbs 1x -> 256x
-- (WateringCanMultiplier, WateringCanReady); the Compost Bin (tagged
-- CompostBinFertilizerProducer) climbs Fertilizer -> Magma -> Golden -> Diamond
-- (CompostBinFertilizerStageIndex 1-4) and hands out 3 at a time. Both are
-- taken with their hold-E prompt (12 studs), both restart from the bottom once
-- taken - which is why these wait for the stage you pick. Ownership is the
-- *OwnerUserId attribute; the StageRevision attribute moves when one is taken.
FARM.upkeep      = false
FARM.fert        = false
FARM.fertSel     = {}           -- FertilizerId -> true
FARM.canCollect  = false
FARM.canAt       = 64           -- collect cans at this multiplier or better
FARM.fertCollect = false
FARM.fertAt      = 4            -- compost stage: 1 Fertilizer .. 4 Diamond
FARM.status.fert, FARM.status.gather = "Off", "Off"
FARM.stats.fertilized, FARM.stats.gathered = 0, 0
FARM.FERT_TYPES = {             -- id, label, stage in the compost bin
    { "Fertilizer",        "Fertilizer (1.25x)",        1 },
    { "MagmaFertilizer",   "Magma Fertilizer (1.5x)",   2 },
    { "GoldenFertilizer",  "Golden Fertilizer (2x)",    3 },
    { "DiamondFertilizer", "Diamond Fertilizer (4x)",   4 },
    { "GalacticFertilizer","Galactic Fertilizer (16x)", nil },
    { "SinisterFertilizer","Sinister Fertilizer (16x)", nil },   -- Fall Update (v1476), 166h
}
FARM.fertBackoff = setmetatable({}, { __mode = "k" })

-- A sub-switch only counts while the master is on.
function FARM.up(key) return FARM.upkeep and FARM[key] == true end

-- Selected fertilizer on hand, strongest first.
function FARM.fertTools()
    local out = {}
    for _, t in ipairs(tools()) do
        local id = t:GetAttribute("FertilizerId")
        if t:GetAttribute("ManagedFertilizerTool") == true and type(id) == "string" and FARM.fertSel[id]
        and not (FARM.deliver and FARM.D.keepFert and FARM.D.keepFert[id])
        and (tonumber(t:GetAttribute("InventoryItemCount")) or 1) > 0 then
            table.insert(out, t)
        end
    end
    table.sort(out, function(a, b)
        return (tonumber(a:GetAttribute("FertilizerMultiplier")) or 0) > (tonumber(b:GetAttribute("FertilizerMultiplier")) or 0)
    end)
    return out
end

-- Planters with no fertilizer running, the ones growing first.
function FARM.fertTargets(ty)
    local folder = ty:FindFirstChild("TycoonRoot")
    folder = folder and folder:FindFirstChild("Planters")
    local out = {}
    if not folder then return out end
    local now = os.time()
    for _, p in ipairs(folder:GetChildren()) do
        local st = p:GetAttribute("TreePlanterStatus")
        if p:GetAttribute("TreePlanter") == true and p:GetAttribute("TreePlanterVisible") ~= false
        and p:GetAttribute("TreePlanterConstructing") ~= true and p:GetAttribute("TutorialTree") ~= true
        and p:GetAttribute("MegaPlanter") ~= true and tonumber(p:GetAttribute("PlanterIndex"))
        and (st == "Empty" or st == "Growing" or st == "Mature")
        and (tonumber(p:GetAttribute("TreeFertilizerEndsAt")) or 0) <= now
        and (FARM.fertBackoff[p] or 0) <= os.clock() then
            table.insert(out, p)
        end
    end
    table.sort(out, function(a, b)
        return (a:GetAttribute("TreePlanterStatus") == "Growing" and 0 or 1) < (b:GetAttribute("TreePlanterStatus") == "Growing" and 0 or 1)
    end)
    return out
end

-- Our own Water Tower cans / Compost Bin, if the tower or bin is built.
function FARM.producers(tag, ownerAttr)
    local out = {}
    for _, m in ipairs(CS:GetTagged(tag)) do
        if m:GetAttribute(ownerAttr) == LP.UserId and m:IsDescendantOf(workspace) then table.insert(out, m) end
    end
    return out
end

-- What is ready to take at the picked stage: { inst, prompt, label }.
function FARM.gatherTargets()
    local out = {}
    if FARM.up("canCollect") then
        for _, c in ipairs(FARM.producers("WaterTowerLiveWateringCan", "WateringCanOwnerUserId")) do
            local mult = tonumber(c:GetAttribute("WateringCanMultiplier")) or 0
            local pp = c:FindFirstChild("CollectWateringCanPrompt", true)
            if c:GetAttribute("WateringCanReady") == true and mult >= FARM.canAt and pp and pp.Enabled
            and (FARM.skip[c] or 0) < os.clock() then
                table.insert(out, { inst = c, prompt = pp, label = mult .. "x watering can", rev = "WateringCanStageRevision" })
            end
        end
    end
    if FARM.up("fertCollect") then
        for _, b in ipairs(FARM.producers("CompostBinFertilizerProducer", "CompostBinFertilizerOwnerUserId")) do
            local stage = tonumber(b:GetAttribute("CompostBinFertilizerStageIndex")) or 0
            local pp = b:FindFirstChild("CollectCompostFertilizerPrompt", true)
            if b:GetAttribute("CompostBinFertilizerReady") == true and stage >= FARM.fertAt and pp and pp.Enabled
            and (FARM.skip[b] or 0) < os.clock() then
                table.insert(out, { inst = b, prompt = pp, rev = "CompostBinFertilizerStageRevision",
                    label = "3x " .. tostring(b:GetAttribute("CompostBinFertilizerItemId") or "fertilizer") })
            end
        end
    end
    return out
end

function FARM.upkeepWants(ty)
    if not FARM.upkeep then return false end
    if FARM.fert and next(FARM.fertSel) ~= nil and #FARM.fertTools() > 0 and #FARM.fertTargets(ty) > 0 then return true end
    return #FARM.gatherTargets() > 0
end

-- Stand next to something and face it. Returns how far we came.
function FARM.goTo(at, dist)
    local r = root()
    if not r then return nil end
    local far = (r.Position - at).Magnitude
    local flat = Vector3.new(r.Position.X - at.X, 0, r.Position.Z - at.Z)
    local dir = flat.Magnitude > 0.1 and flat.Unit or Vector3.new(0, 0, 1)
    moveTo(at + dir * dist + Vector3.new(0, 3, 0), at)
    task.wait(far > 60 and 0.8 or 0.25)
    return far
end

-- Bulk fertilizing (Fall Update, TreePlanters:BeginBulkFertilizer): holding the
-- fertilizer, GetBulkFertilizerState {TycoonName, PlanterIndex, ItemId} ->
-- {Success, MaxQuantity}, then ApplyBulkFertilizer {..., Quantity} puts one on
-- each of Quantity eligible planters near you, starting with PlanterIndex. The
-- server's "eligible" is the game's rule - nothing running OR a weaker one
-- running - so it could cut a weaker fertilizer short, which fertPass never
-- does. It is only used while no planter has a weaker one running; otherwise
-- (or if it does nothing) fertPass carries on one planter at a time.
-- Returns how many of `targets` it fertilized.
function FARM.fertBulk(ty, planter, tool, targets)
    local stateRem, applyRem = FARM.remote("GetBulkFertilizerState"), FARM.remote("ApplyBulkFertilizer")
    if not (stateRem and applyRem and stateRem:IsA("RemoteFunction") and applyRem:IsA("RemoteFunction")) then return 0 end
    local id = tool:GetAttribute("FertilizerId")
    local mult = tonumber(tool:GetAttribute("FertilizerMultiplier")) or 0
    local function running(p) return (tonumber(p:GetAttribute("TreeFertilizerEndsAt")) or 0) > os.time() end
    local pending = {}
    for _, p in ipairs(targets) do
        if not running(p) then table.insert(pending, p) end
    end
    if #pending < 2 then return 0 end
    local folder = ty:FindFirstChild("TycoonRoot")
    folder = folder and folder:FindFirstChild("Planters")
    for _, p in ipairs(folder and folder:GetChildren() or {}) do
        if p:GetAttribute("MegaPlanter") ~= true and running(p) and p:GetAttribute("TreeFertilizerId") ~= id
        and (tonumber(p:GetAttribute("TreeFertilizerMultiplier")) or 0) < mult then
            return 0
        end
    end
    local base = { TycoonName = ty.Name, PlanterIndex = tonumber(planter:GetAttribute("PlanterIndex")), ItemId = id }
    local done, st = FARM.invoke(stateRem, base, 6)
    local max = done and type(st) == "table" and st.Success == true and math.floor(tonumber(st.MaxQuantity) or 0) or 0
    local qty = math.min(max, #pending, tonumber(tool:GetAttribute("InventoryItemCount")) or 1)
    if qty < 2 then return 0 end
    FARM.status.fert = ("Fertilizing %d planters with %s"):format(qty, tool.Name)
    local payload = table.clone(base)
    payload.Quantity = qty
    FARM.invoke(applyRem, payload, 10)
    -- believe the planters, not the reply
    local t0, n = os.clock(), 0
    repeat
        task.wait(0.2)
        n = 0
        for _, p in ipairs(pending) do
            if running(p) then n += 1 end
        end
    until n >= qty or os.clock() - t0 > 3
    if n > 0 then
        FARM.stats.fertilized += n
        FARM.status.fert = ("Fertilized %d planters with %s"):format(n, tool.Name)
    end
    return n
end

-- Returns true if the character was moved.
function FARM.fertPass(ty)
    if next(FARM.fertSel) == nil then FARM.status.fert = "No fertilizer selected" return false end
    local ferts = FARM.fertTools()
    if #ferts == 0 then FARM.status.fert = "No selected fertilizer on hand" return false end
    local targets = FARM.fertTargets(ty)
    if #targets == 0 then FARM.status.fert = "Idle: every planter is fertilized" return false end
    local rem = FARM.remote("FertilizePlanter")
    if not (rem and rem:IsA("RemoteFunction")) then FARM.status.fert = "Fertilize remote not found" return false end

    local moved = false
    local bulkTried = {}        -- FertilizerId -> true: one bulk attempt per pass each
    for _, planter in ipairs(targets) do
        if not (FARM.up("fert") and mine()) then break end
        -- already covered by a bulk call earlier in this pass
        if (tonumber(planter:GetAttribute("TreeFertilizerEndsAt")) or 0) > os.time() then continue end
        local tool = FARM.fertTools()[1]
        if not tool then FARM.status.fert = "Out of selected fertilizer" break end
        local id = tool:GetAttribute("FertilizerId")
        FARM.goTo(planter:GetPivot().Position, 6)
        moved = true
        FARM.status.fert = ("Fertilizing %s with %s"):format(planter.Name, tool.Name)
        if not equip(tool) then FARM.status.fert = "Could not hold " .. tool.Name break end
        task.wait(0.3)
        if not bulkTried[id] then
            bulkTried[id] = true
            local ok, n = pcall(FARM.fertBulk, ty, planter, tool, targets)
            if ok and n > 0 and (tonumber(planter:GetAttribute("TreeFertilizerEndsAt")) or 0) > os.time() then continue end
        end
        local done, res = FARM.invoke(rem, {
            PlanterIndex     = tonumber(planter:GetAttribute("PlanterIndex")),
            ItemId           = id,
            DirectlyTargeted = false,
            TargetedInstance = nil,
            TycoonName       = ty.Name,
        })
        -- believe the planter, not the reply
        local t0 = os.clock()
        local function active() return (tonumber(planter:GetAttribute("TreeFertilizerEndsAt")) or 0) > os.time() end
        while not active() and os.clock() - t0 < 2 do task.wait(0.1) end
        if active() then
            FARM.stats.fertilized += 1
            FARM.status.fert = ("Fertilized %s with %s"):format(planter.Name, tool.Name)
        else
            local why = type(res) == "table" and (res.Message or res.Code) or nil
            FARM.status.fert = "Fertilizer refused" .. (why and (": " .. tostring(why)) or (done and "" or " (no reply)"))
            FARM.fertBackoff[planter] = os.clock() + 60
        end
    end
    pcall(function() local _, h = root() if h then h:UnequipTools() end end)
    return moved
end

function FARM.gatherPass()
    local list = FARM.gatherTargets()
    if #list == 0 then
        local parts = {}
        if FARM.up("canCollect") then table.insert(parts, ("cans at %dx+"):format(FARM.canAt)) end
        if FARM.up("fertCollect") then
            for _, f in ipairs(FARM.FERT_TYPES) do
                if f[3] == FARM.fertAt then table.insert(parts, f[2]:match("^(.-) %(") .. "+") end
            end
        end
        FARM.status.gather = "Idle: waiting for " .. table.concat(parts, ", ")
        return false
    end
    for _, t in ipairs(list) do
        if not mine() then break end
        local rev = t.inst:GetAttribute(t.rev)
        local anchor = t.prompt.Parent
        local at = (anchor:IsA("Attachment") and anchor.WorldPosition) or (anchor:IsA("BasePart") and anchor.Position) or t.inst:GetPivot().Position
        FARM.status.gather = "Collecting " .. t.label
        FARM.goTo(at, 4)
        pcall(fireproximityprompt, t.prompt)
        local t0 = os.clock()
        while t.inst:GetAttribute(t.rev) == rev and os.clock() - t0 < 3 do task.wait(0.1) end
        if t.inst:GetAttribute(t.rev) ~= rev then
            FARM.stats.gathered += 1
            FARM.status.gather = "Collected " .. t.label
        else
            FARM.status.gather = "Could not collect " .. t.label .. " (inventory full?)"
            FARM.skip[t.inst] = os.clock() + 60
        end
    end
    return true
end

--- deliver -----------------------------------------------------------------------
-- Auto Deliver: fills the Packaging Machine's request, then the next one, for
-- as long as the items can be had.
--
-- The machine is TycoonRoot.TycoonExpansion2.Factory.Delivery.PackagingMachine
-- (PackagingMachineUnlocked=true). Its request is JSON in the machine's
-- PackagingRequestState attribute: {Requirements = {{Kind, Id, Required,
-- Submitted, DisplayName, Rarity}, x3}, Revision}. Kind is Wood (a raw log or a
-- carved piece, by wood id), Seed (non-Mega, by TreeType), WateringCan (by
-- stage) or Fertilizer (by id). The game's PackagingMachines:TryInsert holds the
-- item and sends AskServer("InsertPackagingMachineItem", {Machine, Input, Tool})
-- from within 26 studs of the Input part; one call puts in one item. Which tool
-- fits which requirement is asked of the game's own GetMatchingRequirement
-- (read-only, it only reads attributes), so this hands in exactly what the
-- machine would accept by hand.
--
-- Never handed in: Mega logs and carved pieces (both worth far more than the
-- request). Plain logs go before mutated ones.
--
-- What is missing gets sourced, overriding Auto Roll / Plant / Chop and their
-- picks, through FARM.D (read by those passes):
--   Wood X  grown tree of X -> chop it; growing -> wait (Auto Water tends it
--           first); seed of X on hand -> plant it; none -> roll for one.
--   Seed X  roll for it, and keep those seeds out of planting.
--   Cans / fertilizer cannot be made: it waits for you to get them.
-- A log a delivery still needs is kept away from Auto Carve.
do
FARM.status.deliver = "Off"
FARM.stats.delivered = 0
FARM.stats.requests = 0
FARM.deliverInfo = "No request read yet"

function FARM.packMachine(ty)
    local r = ty:FindFirstChild("TycoonRoot")
    local d = r and r:FindFirstChild("TycoonExpansion2")
    d = d and d:FindFirstChild("Factory")
    d = d and d:FindFirstChild("Delivery")
    local m = d and d:FindFirstChild("PackagingMachine")
    local inp = m and m:FindFirstChild("Input")
    if not (m and inp and inp:IsA("BasePart")) or m:GetAttribute("PackagingMachineUnlocked") ~= true then return nil end
    return m, inp
end

function FARM.request(m)
    local raw = m and m:GetAttribute("PackagingRequestState")
    if type(raw) ~= "string" or raw == "" then return nil end
    local ok, t = pcall(function() return game:GetService("HttpService"):JSONDecode(raw) end)
    return ok and type(t) == "table" and type(t.Requirements) == "table" and t or nil
end

local function gameModule2(name)
    local ok, C = pcall(require, game:GetService("ReplicatedFirst"):FindFirstChild("Client"))
    local mods = ok and type(C) == "table" and C.ActiveModules
    return type(mods) == "table" and mods[name] or nil
end

-- TreeType for a request id ("glow" -> "Glow", "WitheredRose" -> "WitheredRose").
function FARM.treeOf(id)
    local low = tostring(id or ""):lower()
    for tree in pairs(FARM.typeLabel) do
        if tree:lower() == low then return tree end
    end
    return nil
end

local function logCount(t) return tonumber(t:GetAttribute("RawWoodCount")) or 1 end

-- Tools we are willing to hand in, each with the requirement it fills.
function FARM.deliverables(req)
    local PM = gameModule2("PackagingMachines")
    if not (PM and type(PM.GetMatchingRequirement) == "function") then return {} end
    local out = {}
    for _, t in ipairs(tools()) do
        if t:GetAttribute("MegaLog") ~= true and t:GetAttribute("CarvedWoodTool") ~= true then
            local ok, q = pcall(PM.GetMatchingRequirement, PM, req, t)
            if ok and type(q) == "table" then table.insert(out, { tool = t, req = q }) end
        end
    end
    table.sort(out, function(a, b)
        local ma = (a.tool:GetAttribute("RawWoodMutation") or "") ~= "" and 1 or 0
        local mb = (b.tool:GetAttribute("RawWoodMutation") or "") ~= "" and 1 or 0
        return ma < mb      -- plain logs first
    end)
    return out
end

-- How many of `tree` are standing in the planters, mature and growing, plus
-- the soonest one's time left.
local function standing(ty, tree)
    local folder = ty:FindFirstChild("TycoonRoot")
    folder = folder and folder:FindFirstChild("Planters")
    local mature, growing, soonest = 0, 0, nil
    if not folder then return 0, 0 end
    local now = workspace:GetServerTimeNow()
    for _, p in ipairs(folder:GetChildren()) do
        if p:GetAttribute("TreeType") == tree and p:GetAttribute("MegaPlanter") ~= true then
            local st = p:GetAttribute("TreePlanterStatus")
            if st == "Mature" then mature += 1
            elseif st == "Growing" then
                growing += 1
                local left = FARM.growthLeft(p, now)
                if not soonest or left < soonest then soonest = left end
            end
        end
    end
    return mature, growing, soonest
end

local function seedsOf(tree)
    local n = 0
    for _, t in ipairs(tools()) do
        if t:GetAttribute("TreeSeed") == true and t:GetAttribute("TreeType") == tree
        and t:GetAttribute("MegaSeedId") == nil and not CW.isMega(t) then n += 1 end
    end
    return n
end

local function plainLogsOf(id)
    local low, n = tostring(id):lower(), 0
    for _, t in ipairs(tools()) do
        if t:GetAttribute("RawWoodTool") == true and t:GetAttribute("MegaLog") ~= true
        and tostring(t:GetAttribute("RawWoodId") or ""):lower() == low then n += logCount(t) end
    end
    return n
end

-- Works out what each open requirement still needs and fills FARM.D. Returns
-- one status line per requirement.
function FARM.planDelivery(ty, req)
    local D = { plantFirst = {}, noPlant = {}, roll = {}, chop = {}, water = {}, carveBlock = {}, getFert = {}, getCan = {}, keepFert = {}, keepCans = {} }
    local lines = {}
    local seedNeed = {}
    for _, q in ipairs(req.Requirements) do
        local left = (tonumber(q.Required) or 0) - (tonumber(q.Submitted) or 0)
        if q.Kind == "Seed" and left > 0 then
            local tree = FARM.treeOf(q.Id)
            if tree then seedNeed[tree] = (seedNeed[tree] or 0) + left end
        end
    end
    for _, q in ipairs(req.Requirements) do
        local got, need = tonumber(q.Submitted) or 0, tonumber(q.Required) or 0
        local left = need - got
        local name = tostring(q.DisplayName or q.Id)
        local line = ("%s  %d/%d"):format(name, got, need)
        if left <= 0 then
            line ..= "  done"
        else
            local tree = FARM.treeOf(q.Id)
            if q.Kind == "Wood" then
                D.carveBlock[tostring(q.Id):lower()] = true
                local have = plainLogsOf(q.Id)
                if not tree then
                    line ..= have > 0 and ("  have %d"):format(have) or "  unknown wood, cannot source"
                else
                    local mature, growing, soonest = standing(ty, tree)
                    local free = seedsOf(tree) - (seedNeed[tree] or 0)
                    local short = left - have - mature - growing
                    local bits = {}
                    if have > 0 then table.insert(bits, ("have %d"):format(have)) end
                    if mature > 0 then D.chop[tree] = true table.insert(bits, ("%d to chop"):format(mature)) end
                    if growing > 0 then
                        D.water[tree] = true
                        table.insert(bits, ("%d growing (%s)"):format(growing, FARM.hms(soonest or 0)))
                    end
                    if short > 0 then
                        if free > 0 then
                            D.plantFirst[tree] = true
                            table.insert(bits, ("planting %d"):format(math.min(short, free)))
                            if free < short then D.roll[tree] = true table.insert(bits, "rolling for seeds") end
                        else
                            D.roll[tree] = true
                            table.insert(bits, "rolling for a seed")
                        end
                    end
                    line ..= "  " .. table.concat(bits, ", ")
                end
            elseif q.Kind == "Seed" then
                if tree then
                    D.noPlant[tree] = true
                    local have = seedsOf(tree)
                    if have < left then D.roll[tree] = true end
                    line ..= have > 0 and ("  have %d"):format(have) or "  rolling for it"
                else
                    line ..= "  unknown seed"
                end
            elseif q.Kind == "Fertilizer" then
                local id = tostring(q.Id)
                D.keepFert[id] = true
                local have = FARM.fertCount(id)
                if have >= left then
                    line ..= ("  have %d"):format(have)
                else
                    D.getFert[id] = left - have
                    line ..= ("  have %d, getting %d"):format(have, left - have)
                end
            elseif q.Kind == "WateringCan" then
                local mult = FARM.WATER_TIERS[tonumber(q.Id) or 0]
                if mult then
                    D.keepCans[mult] = true
                    local have = FARM.canCount(mult)
                    if have >= left then
                        line ..= ("  have %d"):format(have)
                    else
                        D.getCan[tonumber(q.Id)] = left - have
                        line ..= ("  have %d, getting %d"):format(have, left - have)
                    end
                else
                    line ..= "  unknown watering can"
                end
            else
                line ..= "  unknown kind " .. tostring(q.Kind)
            end
        end
        table.insert(lines, line)
    end
    FARM.D = D
    return lines
end

function FARM.clearDelivery()
    FARM.D = { plantFirst = {}, noPlant = {}, roll = {}, chop = {}, water = {}, carveBlock = {}, getFert = {}, getCan = {}, keepFert = {}, keepCans = {} }
end

-- Something to do right now: an item to hand in, or a delivery tree to chop /
-- plant. (Rolling is driven separately, through CW.forceRoll.)
function FARM.deliverWants(ty)
    if not FARM.deliver then return false end
    local m = FARM.packMachine(ty)
    local req = m and FARM.request(m)
    if not req then return false end
    if #FARM.deliverables(req) > 0 then return true end
    for _, e in ipairs(FARM.readyTrees(ty)) do
        if FARM.D.chop[e.planter:GetAttribute("TreeType") or ""] then return true end
    end
    if next(FARM.D.plantFirst) ~= nil and #FARM.emptyPlanters(ty) > 0 and #FARM.plantableSeeds() > 0 then return true end
    return false
end

-- Returns true if the character was moved.
function FARM.deliverPass(ty)
    local m, inp = FARM.packMachine(ty)
    if not m then FARM.clearDelivery() FARM.status.deliver = "Packaging Machine not unlocked" return false end
    local req = FARM.request(m)
    if not req then FARM.clearDelivery() FARM.status.deliver = "No request on the machine" return false end
    FARM.deliverInfo = table.concat(FARM.planDelivery(ty, req), "\n")

    if #FARM.deliverables(req) == 0 then FARM.status.deliver = "Sourcing items" return false end
    local rem = FARM.remote("InsertPackagingMachineItem")
    if not (rem and rem:IsA("RemoteFunction")) then FARM.status.deliver = "Insert remote not found" return false end

    local r = root()
    if not r then return false end
    local at = inp.Position
    local far = (r.Position - at).Magnitude
    local flat = Vector3.new(r.Position.X - at.X, 0, r.Position.Z - at.Z)
    local dir = flat.Magnitude > 0.1 and flat.Unit or Vector3.new(0, 0, 1)
    moveTo(at + dir * 7 + Vector3.new(0, 2, 0), at)
    task.wait(far > 60 and 0.8 or 0.25)

    local misses = 0
    for _ = 1, 15 do
        if not (FARM.deliver and mine()) then break end
        req = FARM.request(m)
        if not req then break end
        local c = FARM.deliverables(req)[1]
        if not c then break end
        local rev = req.Revision
        FARM.status.deliver = "Handing in " .. tostring(c.req.DisplayName or c.tool.Name)
        if not equip(c.tool) then misses += 1 if misses >= 3 then break end continue end
        task.wait(0.35)
        local done, res = FARM.invoke(rem, { Machine = m, Input = inp, Tool = c.tool })
        -- believe the machine: the request's revision moves on every accepted item
        local t0 = os.clock()
        while os.clock() - t0 < 2 do
            local now = FARM.request(m)
            if not now or now.Revision ~= rev then break end
            task.wait(0.1)
        end
        local after = FARM.request(m)
        if type(res) == "table" and res.Completed == true then
            FARM.stats.requests += 1
            FARM.stats.delivered += 1
            pcall(function()
                WindUI:Notify({ Title = "Auto Deliver", Content = "Delivery complete - next request loaded", Duration = 4, Icon = "package-check" })
            end)
            misses = 0
        elseif after and after.Revision ~= rev then
            FARM.stats.delivered += 1
            misses = 0
        else
            misses += 1
            local why = type(res) == "table" and (res.Message or res.Error) or nil
            FARM.status.deliver = "Machine refused" .. (why and (": " .. tostring(why)) or (done and "" or " (no reply)"))
            if misses >= 3 then break end
            task.wait(0.4)
        end
    end
    pcall(function() local _, h = root() if h then h:UnequipTools() end end)
    req = FARM.request(m)
    if req then FARM.deliverInfo = table.concat(FARM.planDelivery(ty, req), "\n") end
    if FARM.status.deliver:find("^Handing in") then FARM.status.deliver = "Handed in what we had" end
    return true
end

--- delivery sourcing: fertilizer + watering cans ------------------------------------
-- A request can also ask for Fertilizer (by id, e.g. GoldenFertilizer) or a
-- WateringCan (by Water Tower stage, 4 and up = 8x+). planDelivery puts what is
-- still missing in FARM.D.getFert[id] / FARM.D.getCan[stage]; this sources it:
--   1. the Compost Bin / a Water Tower slot sitting at exactly that stage - one
--      take (the bin always gives 3, a tower slot 1). A bin within 15 minutes of
--      the stage is waited for.
--   2. the diamond shop (Shared.GemStoreStockConfig: Golden / Diamond
--      fertilizer, 16x / 64x cans), buying only the missing count; if it is not
--      in stock, a reroll. Nothing is spent that would take the balance under
--      FARM.shopReserve.
-- The shop is TycoonExpansion1.GemStore: four DailyStockDisplay pedestals
-- (GemStoreStockItemId / Slot / Remaining / Period). Buying is the CachedRemotes
-- RF "PurchaseGemStoreStock" {Slot, ItemId, PeriodIndex} within 20 studs of the
-- pedestal; a reroll is "RefreshGemStoreStockWithGems" {PeriodIndex, RollIndex,
-- ExpectedCost} within 22 studs of RerollStockButton.RedPart, costing
-- 100 * 1.25^GemStorePaidRefreshCount (GemStoreStockConfig.GetRefreshCosts).
FARM.shop        = true
FARM.shopReserve = 1000
FARM.status.source = "Nothing to source"
FARM.stats.bought, FARM.stats.rerolls = 0, 0
FARM.FERT_WAIT = { 900, 5400, 21600, 100800 }     -- seconds each compost stage takes to reach

local function sharedModule(name)
    local ok, m = pcall(require, game:GetService("ReplicatedStorage").Shared:FindFirstChild(name))
    return ok and type(m) == "table" and m or nil
end

function FARM.diamonds()
    local ls = LP:FindFirstChild("leaderstats")
    local d = ls and ls:FindFirstChild("Diamonds")
    return d and tonumber(d.Value) or 0
end

function FARM.fertStage(id)
    for _, f in ipairs(FARM.FERT_TYPES) do if f[1] == id then return f[3] end end
    return nil
end

function FARM.fertCount(id)
    local n = 0
    for _, t in ipairs(tools()) do
        if t:GetAttribute("ManagedFertilizerTool") == true and t:GetAttribute("FertilizerId") == id then
            n += tonumber(t:GetAttribute("InventoryItemCount")) or 1
        end
    end
    return n
end

function FARM.canCount(mult)
    local n = 0
    for _, t in ipairs(tools()) do
        if t:GetAttribute("ManagedWateringCanTool") == true and tonumber(t:GetAttribute("WateringCanMultiplier")) == mult then
            n += tonumber(t:GetAttribute("WateringCanCount")) or 1
        end
    end
    return n
end

function FARM.gemStore(ty)
    local r = ty:FindFirstChild("TycoonRoot")
    local e = r and r:FindFirstChild("TycoonExpansion1")
    local s = e and e:FindFirstChild("GemStore")
    if s and tonumber(s:GetAttribute("GemStoreStockOwnerUserId")) == LP.UserId then return s end
    return nil
end

function FARM.shopOffer(store, itemId)
    local p = store:FindFirstChild("Pedestals")
    if not p then return nil end
    for _, d in ipairs(p:GetDescendants()) do
        if d.Name == "DailyStockDisplay" and d:GetAttribute("GemStoreStockItemId") == itemId
        and (tonumber(d:GetAttribute("GemStoreStockRemaining")) or 0) > 0 then
            return d
        end
    end
    return nil
end

-- One step towards `n` more of the shop item `itemId`: a purchase, or a reroll
-- when it is out of stock. Returns what it did ("bought" / "rerolled"), or nil
-- and why not. With `dry`, only says whether a step is possible.
function FARM.shopStep(ty, itemId, n, dry)
    if not FARM.shop then return nil, "diamond shop off" end
    local cfg = sharedModule("GemStoreStockConfig")
    if not (cfg and cfg.GetItem(itemId)) then return nil, "not sold in the diamond shop" end
    local store = FARM.gemStore(ty)
    if not store then return nil, "no diamond shop" end
    local price = cfg.GetPrice(itemId)
    local have = FARM.diamonds()
    local offer = FARM.shopOffer(store, itemId)
    if offer then
        if have - price < FARM.shopReserve then return nil, ("needs %d diamonds (reserve %d)"):format(price, FARM.shopReserve) end
        if dry then return "buy" end
        local rem = FARM.remote(cfg.Remotes.Purchase)
        if not (rem and rem:IsA("RemoteFunction")) then return nil, "purchase remote not found" end
        FARM.goTo(offer:GetPivot().Position, 6)
        local bought = 0
        for _ = 1, math.max(1, n) do
            if FARM.diamonds() - price < FARM.shopReserve then break end
            local left = tonumber(offer:GetAttribute("GemStoreStockRemaining")) or 0
            if left <= 0 then break end
            local rev = offer:GetAttribute("GemStoreStockRevision")
            FARM.invoke(rem, {
                Slot = tonumber(offer:GetAttribute("GemStoreStockSlot")),
                ItemId = itemId,
                PeriodIndex = tonumber(offer:GetAttribute("GemStoreStockPeriod")),
            })
            local t0 = os.clock()
            while (tonumber(offer:GetAttribute("GemStoreStockRemaining")) or 0) == left
            and offer:GetAttribute("GemStoreStockRevision") == rev and os.clock() - t0 < 2 do task.wait(0.1) end
            if (tonumber(offer:GetAttribute("GemStoreStockRemaining")) or 0) >= left then break end
            bought += 1
            FARM.stats.bought += 1
            if bought >= n then break end
        end
        if bought == 0 then return nil, "the shop refused the purchase" end
        return "bought", bought
    end
    local cost = cfg.GetRefreshCosts(store:GetAttribute(cfg.RefreshCountAttribute),
        store:GetAttribute(cfg.RefreshCostResetAtAttribute), os.time())
    if have - cost - price < FARM.shopReserve then
        return nil, ("not in stock; a reroll costs %d diamonds (reserve %d)"):format(cost, FARM.shopReserve)
    end
    if dry then return "reroll" end
    local rem = FARM.remote(cfg.Remotes.Refresh)
    local btn = store:FindFirstChild("RerollStockButton")
    local red = btn and btn:FindFirstChild("RedPart")
    if not (rem and rem:IsA("RemoteFunction") and red) then return nil, "reroll button / remote not found" end
    FARM.goTo(red.Position, 5)
    local roll = store:GetAttribute(cfg.RollIndexAttribute)
    FARM.invoke(rem, {
        PeriodIndex = tonumber(store:GetAttribute(cfg.PeriodIndexAttribute)),
        RollIndex = tonumber(roll),
        ExpectedCost = cost,
    })
    local t0 = os.clock()
    while store:GetAttribute(cfg.RollIndexAttribute) == roll and os.clock() - t0 < 3 do task.wait(0.1) end
    if store:GetAttribute(cfg.RollIndexAttribute) == roll then return nil, "the reroll was refused" end
    FARM.stats.rerolls += 1
    return "rerolled", cost
end

--- gem store: auto buy ----------------------------------------------------------------
-- Auto Buy: keeps buying the picked Gem Store ("Moon Gem Store") items and rerolls
-- the stock whenever none of them is left in it. It switches itself off when
--   * every picked item has reached its max for this run (counts start at zero
--     each time it is switched on from the menu; Pause All keeps them), or
--   * the Diamonds above "Keep at least" no longer cover a reroll plus the
--     cheapest picked item (or the picked item in stock), or
--   * a reroll would cost more than "Max reroll cost" (100 * 1.25^paid rerolls,
--     the count resetting 6h after the first - GemStoreStockConfig.GetRefreshCosts).
-- Same shop and remotes as shopStep above: PurchaseGemStoreStock {Slot, ItemId,
-- PeriodIndex} within 20 studs of the pedestal (one per call) and
-- RefreshGemStoreStockWithGems {PeriodIndex, RollIndex, ExpectedCost} at the
-- reroll button. The game's new "confirm purchase" popup is client-side only.
-- A pass is capped at BUY_SLICE seconds so the rest of the farm keeps its turns.
FARM.buy          = false
FARM.buySel       = {}      -- item Id -> true
FARM.buyMax       = {}      -- item Id -> how many to buy this run
FARM.buyCount     = {}      -- item Id -> bought this run
FARM.buyReserve   = 0
FARM.buyMaxReroll = 100000
FARM.buySpent, FARM.buyRerolls, FARM.buyBackoff = 0, 0, 0
FARM.status.buy   = "Off"
FARM.BUY_DEFAULT_MAX = 10
local BUY_SLICE = 20

local function commas(n)
    local s = tostring(math.floor(tonumber(n) or 0))
    return (s:reverse():gsub("(%d%d%d)", "%1,"):reverse():gsub("^,", ""))
end
FARM.commas = commas    -- the menu code further down is outside this block

-- The shop's catalogue in the game's order, and its config.
function FARM.buyCatalogue()
    local cfg = sharedModule("GemStoreStockConfig")
    return cfg and cfg.Items or {}, cfg
end

-- Picked items still under their max: {id, name, left, price}.
function FARM.buyLeft()
    local out = {}
    local items, cfg = FARM.buyCatalogue()
    for _, it in ipairs(items) do
        if FARM.buySel[it.Id] then
            local left = (FARM.buyMax[it.Id] or FARM.BUY_DEFAULT_MAX) - (FARM.buyCount[it.Id] or 0)
            if left > 0 then
                table.insert(out, { id = it.Id, name = it.DisplayName or it.Id, left = left, price = cfg.GetPrice(it.Id) })
            end
        end
    end
    return out
end

function FARM.buyProgress()
    local parts = {}
    for _, it in ipairs((FARM.buyCatalogue())) do
        if FARM.buySel[it.Id] then
            table.insert(parts, ("%s %d/%d"):format(it.DisplayName or it.Id, FARM.buyCount[it.Id] or 0, FARM.buyMax[it.Id] or FARM.BUY_DEFAULT_MAX))
        end
    end
    return #parts > 0 and table.concat(parts, "\n") or "No items picked."
end

function FARM.buyStatusText()
    local head = FARM.buy and FARM.status.buy or ("Off" .. (FARM.status.buy ~= "Off" and (" - " .. FARM.status.buy) or ""))
    return ("%s\n%s\nThis run: %d rerolls, %s Diamonds spent. You have %s."):format(
        head, FARM.buyProgress(), FARM.buyRerolls, commas(FARM.buySpent), commas(FARM.diamonds()))
end

-- Switches Auto Buy on or off and keeps the menu toggle in step. `fresh` starts a
-- new run (counts back to zero); `why` is shown and announced when it stops itself.
function FARM.setBuy(on, why, fresh)
    on = on == true
    if on == FARM.buy then return end
    if on and fresh then
        FARM.buyCount, FARM.buySpent, FARM.buyRerolls = {}, 0, 0
    end
    FARM.buyBackoff = 0
    FARM.buy = on
    FARM.status.buy = on and "Starting" or (why or "Off")
    if FARM.ui.buy and FARM.ui.buy.Value ~= on then pcall(function() FARM.ui.buy:Set(on) end) end
    if why then
        pcall(function() WindUI:Notify({ Title = "Gem Store", Content = why, Duration = 8, Icon = "gem" }) end)
    end
end

function FARM.buyWants()
    return FARM.buy and os.clock() >= FARM.buyBackoff
end

function FARM.buyPass(ty)
    local _, cfg = FARM.buyCatalogue()
    local store = FARM.gemStore(ty)
    if not (cfg and store) then FARM.status.buy = "Gem Store not built" FARM.buyBackoff = os.clock() + 30 return false end
    if next(FARM.buySel) == nil then FARM.status.buy = "Pick items to buy first" FARM.buyBackoff = os.clock() + 5 return false end
    local buyRem, rollRem = FARM.remote(cfg.Remotes.Purchase), FARM.remote(cfg.Remotes.Refresh)
    local btn = store:FindFirstChild("RerollStockButton")
    local red = btn and btn:FindFirstChild("RedPart")
    if not (buyRem and rollRem and red) then
        FARM.status.buy = "Gem Store remotes / reroll button not found"
        FARM.buyBackoff = os.clock() + 30
        return false
    end

    local moved, t0 = false, os.clock()
    while FARM.buy and mine() and os.clock() - t0 < BUY_SLICE do
        local left = FARM.buyLeft()
        if #left == 0 then
            FARM.setBuy(false, "Done: every picked item reached its max.")
            break
        end

        -- 1. buy whatever picked item is in stock, as many as the stock and max allow
        local bought, blocked = false, nil
        for _, w in ipairs(left) do
            local offer = FARM.shopOffer(store, w.id)
            if offer and FARM.diamonds() - w.price < FARM.buyReserve then
                blocked = blocked or w
            elseif offer then
                FARM.goTo(offer:GetPivot().Position, 6)
                moved = true
                FARM.status.buy = ("Buying %s"):format(w.name)
                while FARM.buy and mine() and (FARM.buyCount[w.id] or 0) < (FARM.buyMax[w.id] or FARM.BUY_DEFAULT_MAX)
                and FARM.diamonds() - w.price >= FARM.buyReserve do
                    local stock = tonumber(offer:GetAttribute("GemStoreStockRemaining")) or 0
                    if stock <= 0 or offer:GetAttribute("GemStoreStockItemId") ~= w.id then break end
                    local rev = offer:GetAttribute("GemStoreStockRevision")
                    local done, res = FARM.invoke(buyRem, {
                        Slot = tonumber(offer:GetAttribute("GemStoreStockSlot")),
                        ItemId = w.id,
                        PeriodIndex = tonumber(offer:GetAttribute("GemStoreStockPeriod")),
                    }, 6)
                    local t1 = os.clock()
                    while (tonumber(offer:GetAttribute("GemStoreStockRemaining")) or 0) == stock
                    and offer:GetAttribute("GemStoreStockRevision") == rev and os.clock() - t1 < 2 do task.wait(0.1) end
                    if (tonumber(offer:GetAttribute("GemStoreStockRemaining")) or 0) >= stock then
                        local err = type(res) == "table" and (res.Error or res.Message) or (done and "no change" or "no reply")
                        FARM.status.buy = ("The shop refused %s: %s"):format(w.name, tostring(err))
                        FARM.buyBackoff = os.clock() + 10
                        return moved
                    end
                    FARM.buyCount[w.id] = (FARM.buyCount[w.id] or 0) + 1
                    FARM.buySpent += w.price
                    FARM.stats.bought += 1
                    bought = true
                    FARM.status.buy = ("Bought %s (%d/%d)"):format(w.name, FARM.buyCount[w.id], FARM.buyMax[w.id] or FARM.BUY_DEFAULT_MAX)
                end
            end
        end

        if not bought then
            -- 2. nothing picked left in stock that we can pay for: reroll, if that still leaves enough
            local cost = cfg.GetRefreshCosts(store:GetAttribute(cfg.RefreshCountAttribute),
                store:GetAttribute(cfg.RefreshCostResetAtAttribute), os.time())
            local need = math.huge
            for _, w in ipairs(left) do need = math.min(need, w.price) end
            if cost > FARM.buyMaxReroll then
                FARM.setBuy(false, ("Stopped: the next reroll costs %s, over your max of %s."):format(commas(cost), commas(FARM.buyMaxReroll)))
                break
            end
            if FARM.diamonds() - cost - need < FARM.buyReserve then
                FARM.setBuy(false, ("Stopped: out of Diamonds (%sa reroll is %s, you have %s%s)."):format(
                    blocked and (blocked.name .. " in stock costs " .. commas(blocked.price) .. ", ") or "",
                    commas(cost), commas(FARM.diamonds()),
                    FARM.buyReserve > 0 and (", keeping " .. commas(FARM.buyReserve)) or ""))
                break
            end
            FARM.goTo(red.Position, 5)
            moved = true
            FARM.status.buy = ("Rerolling for %s Diamonds"):format(commas(cost))
            local roll = store:GetAttribute(cfg.RollIndexAttribute)
            local rev = store:GetAttribute(cfg.StockRevisionAttribute)
            local done, res = FARM.invoke(rollRem, {
                PeriodIndex = tonumber(store:GetAttribute(cfg.PeriodIndexAttribute)),
                RollIndex = tonumber(roll),
                ExpectedCost = cost,
            }, 6)
            local t1 = os.clock()
            while store:GetAttribute(cfg.RollIndexAttribute) == roll and os.clock() - t1 < 3 do task.wait(0.1) end
            if store:GetAttribute(cfg.RollIndexAttribute) == roll then
                local err = type(res) == "table" and (res.Error or res.Message) or (done and "no change" or "no reply")
                FARM.status.buy = "The reroll was refused: " .. tostring(err)
                FARM.buyBackoff = os.clock() + 10
                break
            end
            FARM.buyRerolls += 1
            FARM.buySpent += cost
            FARM.stats.rerolls += 1
            -- give the pedestals a moment to show the new stock
            t1 = os.clock()
            while store:GetAttribute(cfg.StockRevisionAttribute) == rev and os.clock() - t1 < 2 do task.wait(0.1) end
            task.wait(0.3)
        end
    end
    if FARM.buy and not FARM.status.buy:find("refused") then
        FARM.status.buy = ("Running: %d rerolls, %s Diamonds spent"):format(FARM.buyRerolls, commas(FARM.buySpent))
    end
    return moved
end

-- Seconds until the Compost Bin reaches `stage`, or nil if it is past it.
local function binEta(bin, stage)
    local cur = tonumber(bin:GetAttribute("CompostBinFertilizerStageIndex")) or 0
    if cur > stage then return nil end
    if cur == stage then return 0 end
    local eta = math.max(0, (tonumber(bin:GetAttribute("CompostBinFertilizerNextStageAt")) or os.time()) - os.time())
    for s = cur + 2, stage do eta += FARM.FERT_WAIT[s] or 0 end
    return eta
end

-- The next thing to do for the missing fertilizer / cans, as an action table,
-- or nil plus a note per item for the status line.
function FARM.sourcePlan(ty)
    local notes = {}
    for id, n in pairs(FARM.D.getFert or {}) do
        local stage = FARM.fertStage(id)
        local bin = FARM.producers("CompostBinFertilizerProducer", "CompostBinFertilizerOwnerUserId")[1]
        if bin and stage then
            local pp = bin:FindFirstChild("CollectCompostFertilizerPrompt", true)
            local cur = tonumber(bin:GetAttribute("CompostBinFertilizerStageIndex")) or 0
            if cur == stage and bin:GetAttribute("CompostBinFertilizerReady") == true and pp and pp.Enabled then
                return { kind = "take", inst = bin, prompt = pp, rev = "CompostBinFertilizerStageRevision", label = id }
            end
            local eta = binEta(bin, stage)
            if eta and eta <= 900 then
                table.insert(notes, ("%s: Compost Bin there in %dm"):format(id, math.ceil(eta / 60)))
                continue
            end
        end
        local can, why = FARM.shopStep(ty, id, n, true)
        if can then return { kind = "shop", item = id, n = n } end
        table.insert(notes, ("%s: %s"):format(id, why or "waiting"))
    end
    for stage, n in pairs(FARM.D.getCan or {}) do
        local mult = FARM.WATER_TIERS[stage]
        for _, c in ipairs(FARM.producers("WaterTowerLiveWateringCan", "WateringCanOwnerUserId")) do
            local pp = c:FindFirstChild("CollectWateringCanPrompt", true)
            if tonumber(c:GetAttribute("WateringCanMultiplier")) == mult and c:GetAttribute("WateringCanReady") == true
            and pp and pp.Enabled then
                return { kind = "take", inst = c, prompt = pp, rev = "WateringCanStageRevision", label = mult .. "x can" }
            end
        end
        local item = mult and ("WateringCan%dx"):format(mult)
        local can, why = item and FARM.shopStep(ty, item, n, true)
        if can then return { kind = "shop", item = item, n = n } end
        table.insert(notes, ("%sx can: %s"):format(tostring(mult), why or "waiting for the Water Tower"))
    end
    return nil, notes
end

function FARM.sourceWants(ty)
    if not FARM.deliver then return false end
    return (FARM.sourcePlan(ty)) ~= nil
end

-- Returns true if the character was moved.
function FARM.sourcePass(ty)
    local act, notes = FARM.sourcePlan(ty)
    if not act then
        FARM.status.source = (notes and #notes > 0) and table.concat(notes, "; ") or "Nothing to source"
        return false
    end
    if act.kind == "take" then
        FARM.status.source = "Taking " .. act.label .. " for the delivery"
        local anchor = act.prompt.Parent
        local at = (anchor:IsA("Attachment") and anchor.WorldPosition) or (anchor:IsA("BasePart") and anchor.Position) or act.inst:GetPivot().Position
        local rev = act.inst:GetAttribute(act.rev)
        FARM.goTo(at, 4)
        pcall(fireproximityprompt, act.prompt)
        local t0 = os.clock()
        while act.inst:GetAttribute(act.rev) == rev and os.clock() - t0 < 3 do task.wait(0.1) end
        FARM.status.source = act.inst:GetAttribute(act.rev) ~= rev and ("Took " .. act.label) or ("Could not take " .. act.label)
        return true
    end
    FARM.status.source = ("Diamond shop: %s x%d"):format(act.item, act.n)
    local did, info = FARM.shopStep(ty, act.item, act.n, false)
    if did == "bought" then
        FARM.status.source = ("Bought %d %s"):format(info, act.item)
    elseif did == "rerolled" then
        FARM.status.source = ("Rerolled the diamond shop (%d diamonds) for %s"):format(info, act.item)
    else
        FARM.status.source = "Diamond shop: " .. tostring(info)
    end
    return true
end

--- shipping: boxes, capsules, truck --------------------------------------------------
-- A finished request makes the machine put out boxes (LoosePackage) and now and
-- then an energy capsule (LooseEnergyCapsule) along its conveyor. Once off the
-- belt (not PackageInMachinePath / EnergyCapsuleInMachinePath) they are picked
-- up - fired through the item's own prompt or click detector - and a box then
-- sits in the backpack as a PackageTool. Each box is loaded by holding it within
-- 24 studs of a free truck slot (DeliveryTruck.PackageSlots, TruckPackageOccupied
-- false) and firing Remotes.LoadPackageIntoTruck(slot, PackageId). With nothing
-- left on the ground or in hand and at least one box aboard, the lever's
-- DepartTruckPrompt (hold 1s, 12 studs) sends the truck.
FARM.ship = true
FARM.status.ship = "Off"
FARM.stats.boxes, FARM.stats.trips = 0, 0

local LOOSE = {
    { tag = "LoosePackage",       path = "PackageInMachinePath",       busy = "PackageCollecting",       label = "box" },
    { tag = "LooseEnergyCapsule", path = "EnergyCapsuleInMachinePath", busy = "EnergyCapsuleCollecting", label = "energy capsule" },
    -- Paint Buckets turn up loose in the world with no owner (workspace.PaintBucket,
    -- PaintBucketPickupPrompt 20 studs); picked up they go to the inventory.
    { tag = "LoosePaintBucket",   path = "PaintBucketInMachinePath",   busy = "PaintBucketCollecting",   label = "paint bucket", anyone = true },
}

function FARM.looseItems(ty)
    local out = {}
    for _, kind in ipairs(LOOSE) do
        for _, m in ipairs(CS:GetTagged(kind.tag)) do
            local owner = tonumber(m:GetAttribute("PackageOwnerUserId") or m:GetAttribute("EnergyCapsuleOwnerUserId"))
            local ours = (owner == LP.UserId) or (owner == nil and (kind.anyone or m:IsDescendantOf(ty)))
            if ours and m.Parent and m:GetAttribute(kind.path) ~= true and m:GetAttribute(kind.busy) ~= true
            and (FARM.skip[m] or 0) < os.clock() and FARM.inPlayArea(m) then
                table.insert(out, { inst = m, kind = kind })
            end
        end
    end
    return out
end

function FARM.packageTools()
    local out = {}
    for _, t in ipairs(tools()) do
        if t:GetAttribute("PackageTool") == true and t:GetAttribute("PackageId") ~= nil then table.insert(out, t) end
    end
    return out
end

function FARM.truck(ty)
    local r = ty:FindFirstChild("TycoonRoot")
    local e = r and r:FindFirstChild("TycoonExpansion2")
    local f = e and e:FindFirstChild("Factory")
    local d = f and f:FindFirstChild("Delivery")
    return d and d:FindFirstChild("DeliveryTruck"), f
end

local function truckSlots(truck)
    local free, loaded = {}, 0
    local folder = truck and truck:FindFirstChild("PackageSlots")
    if not folder then return free, 0 end
    for _, s in ipairs(folder:GetChildren()) do
        if s:GetAttribute("TruckPackageSlot") == true then
            if s:GetAttribute("TruckPackageOccupied") == true then loaded += 1
            elseif s:GetAttribute("TruckPackageLoading") ~= true then table.insert(free, s) end
        end
    end
    table.sort(free, function(a, b) return (tonumber(a:GetAttribute("TruckPackageSlotOrder")) or 0) < (tonumber(b:GetAttribute("TruckPackageSlotOrder")) or 0) end)
    return free, loaded
end

local function departPrompt(factory)
    local d = factory and factory:FindFirstChild("DepartTruck", true)
    return d and d:FindFirstChild("DepartTruckPrompt", true)
end

function FARM.shipWants(ty)
    if not (FARM.ship and FARM.deliver) then return false end
    if #FARM.looseItems(ty) > 0 then return true end
    local truck, factory = FARM.truck(ty)
    if not truck or truck:GetAttribute("DeliveryTruckState") ~= "Parked" then return false end
    if #FARM.packageTools() > 0 then return true end
    local _, loaded = truckSlots(truck)
    local pp = departPrompt(factory)
    return loaded > 0 and pp ~= nil and pp.Enabled
end

local function trigger(inst)
    local pp = inst:FindFirstChildWhichIsA("ProximityPrompt", true)
    if pp then pcall(fireproximityprompt, pp) return true end
    local cd = inst:FindFirstChildWhichIsA("ClickDetector", true)
    if cd and fireclickdetector then pcall(fireclickdetector, cd) return true end
    return false
end

-- Returns true if the character was moved.
function FARM.shipPass(ty)
    local moved = false
    -- 1. everything on the ground
    for _ = 1, 12 do
        if not (FARM.ship and mine()) then break end
        local r = root()
        if not r then break end
        local best, bestD
        for _, it in ipairs(FARM.looseItems(ty)) do
            local d = (it.inst:GetPivot().Position - r.Position).Magnitude
            if not best or d < bestD then best, bestD = it, d end
        end
        if not best then break end
        FARM.status.ship = "Picking up a " .. best.kind.label
        FARM.goTo(best.inst:GetPivot().Position, 3)
        moved = true
        if not trigger(best.inst) then
            FARM.skipFor(best.inst, 60)
            FARM.status.ship = "No way to pick up the " .. best.kind.label
        else
            local t0 = os.clock()
            while best.inst.Parent and best.inst:GetAttribute(best.kind.path) ~= true
            and CS:HasTag(best.inst, best.kind.tag) and os.clock() - t0 < 2.5 do task.wait(0.1) end
            if best.inst.Parent and CS:HasTag(best.inst, best.kind.tag) then
                FARM.skipFor(best.inst, 20)      -- inventory full, or not ours after all
            end
        end
    end

    -- 2. every box in hand into the truck
    local truck, factory = FARM.truck(ty)
    local remote = game:GetService("ReplicatedStorage"):FindFirstChild("Remotes")
    remote = remote and remote:FindFirstChild("LoadPackageIntoTruck")
    if truck and remote and truck:GetAttribute("DeliveryTruckState") == "Parked" then
        local misses = 0
        for _ = 1, 40 do
            if not (FARM.ship and mine()) then break end
            local box = FARM.packageTools()[1]
            if not box then break end
            local free = truckSlots(truck)
            local slot = free[1]
            if not slot then FARM.status.ship = "The truck is full" break end
            FARM.status.ship = "Loading the truck"
            if not equip(box) then misses += 1 if misses >= 3 then break end continue end
            local sp = slot:IsA("BasePart") and slot.Position or slot:GetPivot().Position
            FARM.goTo(sp, 6)
            moved = true
            remote:FireServer(slot, box:GetAttribute("PackageId"))
            local t0 = os.clock()
            while box.Parent and slot:GetAttribute("TruckPackageOccupied") ~= true and os.clock() - t0 < 2 do task.wait(0.1) end
            if slot:GetAttribute("TruckPackageOccupied") == true or not box.Parent then
                FARM.stats.boxes += 1
                misses = 0
            else
                misses += 1
                if misses >= 3 then FARM.status.ship = "The truck would not take the box" break end
            end
        end
        pcall(function() local _, h = root() if h then h:UnequipTools() end end)

        -- 3. all aboard: send it
        local _, loaded = truckSlots(truck)
        local pp = departPrompt(factory)
        if loaded > 0 and #FARM.packageTools() == 0 and #FARM.looseItems(ty) == 0 and pp and pp.Enabled then
            FARM.status.ship = ("Sending the truck (%d boxes)"):format(loaded)
            local anchor = pp.Parent
            local at = (anchor:IsA("BasePart") and anchor.Position) or (anchor:IsA("Attachment") and anchor.WorldPosition) or truck:GetPivot().Position
            FARM.goTo(at, 4)
            moved = true
            local rev = truck:GetAttribute("DeliveryTruckRevision")
            pcall(fireproximityprompt, pp)
            local t0 = os.clock()
            while truck:GetAttribute("DeliveryTruckRevision") == rev and os.clock() - t0 < 4 do task.wait(0.1) end
            if truck:GetAttribute("DeliveryTruckRevision") ~= rev then
                FARM.stats.trips += 1
                FARM.status.ship = ("Truck sent with %d boxes"):format(loaded)
            else
                FARM.status.ship = "The truck did not leave"
            end
        elseif loaded > 0 and pp and not pp.Enabled then
            FARM.status.ship = ("%d boxes aboard, lever not ready yet"):format(loaded)
        elseif not moved then
            FARM.status.ship = "Nothing to ship"
        end
    elseif truck and truck:GetAttribute("DeliveryTruckState") ~= "Parked" then
        FARM.status.ship = "Truck is out on a delivery"
    end
    return moved
end

-- Auto Roll's hooks.
CW.extraWant = function(tree)
    return FARM.deliver and tree ~= nil and FARM.D.roll[tree] == true
end
CW.forceRoll = function()
    return FARM.deliver and next(FARM.D.roll) ~= nil
end
end -- deliver

--- carve -------------------------------------------------------------------------
function FARM.logStack(ty)
    local r = ty:FindFirstChild("TycoonRoot")
    r = r and r:FindFirstChild("Decoration")
    r = r and r:FindFirstChild("RobotLathe")
    local stack = r and r:FindFirstChild("LogWoodStack")
    local pp = stack and stack:FindFirstChild("StoreRawWoodPrompt", true)
    return stack, pp
end

local function stackFull(stack)
    if stack:GetAttribute("LogWoodStackFull") == true then return true end
    local n = tonumber(stack:GetAttribute("StoredCount")) or 0
    local cap = tonumber(stack:GetAttribute("EffectiveCapacity")) or tonumber(stack:GetAttribute("Capacity")) or 20
    return n >= cap
end

-- Selected raw-wood tools on hand with logs left, rarest first.
function FARM.carveLogs()
    local want = {}
    for tree in pairs(FARM.carveSel) do want[tree:lower()] = true end
    local out = {}
    for _, t in ipairs(tools()) do
        local id = t:GetAttribute("RawWoodId") or t:GetAttribute("WoodId")
        if t:GetAttribute("RawWoodTool") == true and id and want[tostring(id):lower()]
        -- Bubble logs feed the GIGA sprinkler while Auto Sprinkler is on
        and not (FARM.sprinkler and tostring(id):lower() == "bubble")
        -- a plain log a delivery still needs goes to the Packaging Machine first
        and not (FARM.D.carveBlock[tostring(id):lower()] and t:GetAttribute("MegaLog") ~= true)
        and (tonumber(t:GetAttribute("RawWoodCount")) or 0) > 0
        and (FARM.carveMega or t:GetAttribute("MegaLog") ~= true)
        and (FARM.carveMut or (t:GetAttribute("RawWoodMutation") or "") == "") then
            table.insert(out, t)
        end
    end
    local rank = CW.WE and CW.WE.RarityRank or {}
    table.sort(out, function(a, b)
        return (rank[a:GetAttribute("Rarity")] or 0) > (rank[b:GetAttribute("Rarity")] or 0)
    end)
    return out
end

function FARM.carvePass(ty)
    if ty:GetAttribute("RobotLatheUnlocked") ~= true then FARM.status.carve = "Robot lathe not unlocked" return false end
    local stack, prompt = FARM.logStack(ty)
    if not (stack and prompt) then FARM.status.carve = "Log stack not found" return false end
    if stackFull(stack) then FARM.status.carve = "Lathe stack full" return false end
    if next(FARM.carveSel) == nil then FARM.status.carve = "No logs selected" return false end
    if #FARM.carveLogs() == 0 then FARM.status.carve = "No selected logs on hand" return false end

    local anchor = prompt.Parent
    local at = (anchor:IsA("Attachment") and anchor.WorldPosition) or (anchor:IsA("BasePart") and anchor.Position) or stack:GetPivot().Position
    local r = root()
    if not r then return false end
    local flat = Vector3.new(r.Position.X - at.X, 0, r.Position.Z - at.Z)
    local dir = flat.Magnitude > 0.1 and flat.Unit or Vector3.new(0, 0, 1)
    moveTo(at + dir * 5 + Vector3.new(0, 1, 0), at)
    task.wait(0.2)

    local misses = 0
    while FARM.carve and mine() and not stackFull(stack) and misses < 3 do
        local logs = FARM.carveLogs()
        if #logs == 0 then break end
        local log = logs[1]
        if not equip(log) then misses += 1 continue end
        -- the game turns the prompt on once it sees the log in hand (0.1s poll)
        local t0 = os.clock()
        while not prompt.Enabled and os.clock() - t0 < 1.5 do task.wait(0.05) end
        if not prompt.Enabled then misses += 1 FARM.status.carve = "Stack prompt stayed off" task.wait(0.3) continue end

        local before = tonumber(stack:GetAttribute("StoredCount")) or 0
        FARM.status.carve = "Adding " .. log.Name
        pcall(fireproximityprompt, prompt)
        t0 = os.clock()
        while (tonumber(stack:GetAttribute("StoredCount")) or 0) == before and os.clock() - t0 < 1.5 do task.wait(0.05) end
        local after = tonumber(stack:GetAttribute("StoredCount")) or 0
        if after > before then
            FARM.stats.stored += after - before
            misses = 0
        else
            misses += 1
        end
        task.wait(0.15)
    end
    pcall(function() local _, h = root() if h then h:UnequipTools() end end)
    FARM.status.carve = stackFull(stack) and "Lathe stack full" or (misses >= 3 and "Stack did not take the log" or "Done")
    return true
end

--- paint -------------------------------------------------------------------------
-- Paint Carvings. The robot lathe puts its
-- carvings on the tycoon's WoodStack shelf; within seconds the Stocker worker
-- carries each one to a sale spot (TycoonRoot.SaleSpots, 20 of them), where it
-- waits for a customer. This takes the unpainted ones off the sale spots (and
-- off the shelf, when one is still there), paints them at the Paint Machine and
-- puts them back on a free sale spot, so they sell at
-- WoodEconomy.PaintedSaleMultiplier (x1.25). Verified live 2026-09-25.
--
-- Every take needs empty hands ("Put your tool away first").
-- Sale spot -> inventory: RemoveCarvedWoodFromSaleSpot {SpotName, TycoonName,
--   ExpectedWoodId = spot's PlacedWoodId}. A spot says PlacedWoodPainted. A spot
--   a customer is buying from answers "This item is being checked out".
-- Shelf -> inventory: RemoveCarvedWoodFromWoodStack {ItemId = visual's
--   CarvedWoodId} -> {Success, AddedIndex}.
-- Paint: OpenPaintMachine {TycoonName, Machine} -> {Success, SessionId,
--   PaintAmount, Carvings = {{Id, Index, Serialized, ...}}} (unpainted only;
--   needs you at the machine), then FinishPaintMachine {SessionId, ItemId} ->
--   {Success, Serialized, PaintAmount}. The brush minigame is client-only; the
--   server paints the carving itself. 25% paint each (tank PaintAmount, 1 = 100%).
-- Inventory -> sale spot: PlaceCarvedWoodOnSaleSpot {SpotName, TycoonName,
--   WoodId, Index}. Fallback, inventory -> shelf: SetCarvedWoodSlot {Action =
--   "activate", Id, Index} puts it in hand, then StoreCarvedWoodPrompt.
FARM.paint      = false
FARM.paintedIds = {}        -- carving id -> true: painted, or found already painted
FARM.paintSkip  = {}        -- carving id -> os.clock() before which it is left alone
FARM.paintHeld  = {}        -- carving id -> { Index, spot, tries } in the inventory, not back yet
FARM.status.paint = "Off"
FARM.stats.painted, FARM.stats.restocked = 0, 0
local PAINT_COST = 0.25
local paintSer
pcall(function() paintSer = require(game:GetService("ReplicatedStorage").Shared.WoodCarving.Serializer) end)

function FARM.paintMachine(ty)
    local r = ty:FindFirstChild("TycoonRoot")
    local pm = r and r:FindFirstChild("PaintMachine")
    if not (pm and pm:GetAttribute("PaintMachineUnlocked") == true) then return nil end
    return pm, pm:FindFirstChild("PaintMachinePrompt", true)
end

function FARM.paintLeft(pm)
    local v = pm:FindFirstChild("PaintAmount")
    return tonumber(v and v:IsA("ValueBase") and v.Value) or tonumber(pm:GetAttribute("PaintAmount")) or 0
end

function FARM.carvedShelf(ty)
    local r = ty:FindFirstChild("TycoonRoot")
    local s = r and r:FindFirstChild("WoodStack")
    return s, s and s:FindFirstChild("StoreCarvedWoodPrompt", true)
end

function FARM.saleSpots(ty)
    local r = ty:FindFirstChild("TycoonRoot")
    local f = r and r:FindFirstChild("SaleSpots")
    local out = {}
    if f then
        for _, s in ipairs(f:GetChildren()) do
            if s:IsA("BasePart") and s:GetAttribute("SaleSpot") == true then table.insert(out, s) end
        end
    end
    return out
end

-- Has this serialized carving any paint on it? nil when it cannot be read.
local function serPainted(s)
    if not paintSer or type(s) ~= "string" or #s < 16 then return nil end
    local ok, d = pcall(paintSer.DeserializeCarvedLog, s)
    if ok and type(d) == "table" and type(d.Paint) == "table" then return #d.Paint > 0 end
    return nil
end

local function wantId(id)
    return type(id) == "string" and id ~= "" and not FARM.paintedIds[id] and not FARM.paintHeld[id]
        and (FARM.paintSkip[id] or 0) < os.clock()
end

-- Unpainted carvings waiting on sale spots: { {spot, id} }.
function FARM.spotUnpainted(ty)
    local out = {}
    for _, s in ipairs(FARM.saleSpots(ty)) do
        local id = s:GetAttribute("PlacedWoodId")
        if s:GetAttribute("Occupied") == true and wantId(id) then
            if s:GetAttribute("PlacedWoodPainted") == true then
                FARM.paintedIds[id] = true
            else
                table.insert(out, { spot = s, id = id })
            end
        end
    end
    return out
end

-- Unpainted carvings still on the shelf (the Stocker usually beats us to them).
-- The shelf visual carries the carving's serialized copy, which says if it is painted.
local visualSeen = setmetatable({}, { __mode = "k" })   -- part -> painted?
function FARM.shelfUnpainted(shelf)
    local out = {}
    for _, d in ipairs(shelf:GetDescendants()) do
        if d:IsA("BasePart") and d:GetAttribute("WoodStackVisual") == true then
            local id = d:GetAttribute("CarvedWoodId")
            if wantId(id) then
                local p = visualSeen[d]
                if p == nil then
                    p = serPainted(d:GetAttribute("CarvedWoodRenderSerialized")) == true
                    visualSeen[d] = p
                end
                if p then FARM.paintedIds[id] = true else table.insert(out, id) end
            end
        end
    end
    return out
end

local function paintHeldCount()
    local n = 0
    for _ in pairs(FARM.paintHeld) do n += 1 end
    return n
end

-- Unpainted carvings already in the inventory (hand carvings, ones taken off a
-- spot by hand...). The Hotbar keeps a copy of the inventory the game fetched
-- (Hotbar.CachedData.Inventory.Carved, {Id, Serialized, WoodId, ...}); it can
-- lag a little, so the Paint Machine's own list stays the final word.
local invSeen = {}          -- id .. #Serialized -> painted?
function FARM.invUnpainted()
    local out = {}
    local ok, carved = pcall(function()
        local C = require(game:GetService("ReplicatedFirst"):FindFirstChild("Client"))
        return C.UI.MainComponent._Maid.PrimaryElements.Hotbar.CachedData.Inventory.Carved
    end)
    if not ok or type(carved) ~= "table" then return out end
    for _, e in pairs(carved) do
        local id = type(e) == "table" and e.Id ~= nil and tostring(e.Id)
        if id and wantId(id) and type(e.Serialized) == "string" then
            local key = id .. #e.Serialized
            local p = invSeen[key]
            if p == nil then
                p = serPainted(e.Serialized) == true
                invSeen[key] = p
            end
            if p then FARM.paintedIds[id] = true else table.insert(out, id) end
        end
    end
    return out
end

function FARM.paintWants(ty)
    if not FARM.paint then return false end
    if next(FARM.paintHeld) ~= nil then return true end
    local pm = FARM.paintMachine(ty)
    if not pm or FARM.paintLeft(pm) < PAINT_COST then return false end
    if #FARM.invUnpainted() > 0 then return true end
    if #FARM.spotUnpainted(ty) > 0 then return true end
    local shelf = FARM.carvedShelf(ty)
    return shelf ~= nil and #FARM.shelfUnpainted(shelf) > 0
end

function FARM.paintIdle(ty)
    local pm = FARM.paintMachine(ty)
    if not pm then return "Paint Machine not unlocked" end
    if FARM.paintLeft(pm) < PAINT_COST then return "Idle: out of paint (add a Paint Bucket)" end
    return ("Idle: nothing to paint (%d%% paint)"):format(math.floor(FARM.paintLeft(pm) * 100 + 0.5))
end

local function promptAt(pp, fallback)
    local a = pp and pp.Parent
    return (a and a:IsA("Attachment") and a.WorldPosition) or (a and a:IsA("BasePart") and a.Position) or fallback
end

local function standNear(at, dist)
    local r = root()
    if not r then return false end
    local flat = Vector3.new(r.Position.X - at.X, 0, r.Position.Z - at.Z)
    local dir = flat.Magnitude > 0.1 and flat.Unit or Vector3.new(0, 0, 1)
    moveTo(at + dir * dist + Vector3.new(0, 1, 0), at)
    task.wait(0.25)
    return true
end

-- The shelf and the sale spots refuse anything while a tool is out.
local function emptyHands()
    local _, h = root()
    if not h then return false end
    pcall(function() h:UnequipTools() end)
    local t0 = os.clock()
    while LP.Character and LP.Character:FindFirstChildOfClass("Tool") and os.clock() - t0 < 1 do task.wait(0.05) end
    task.wait(0.1)
    return true
end

local function heldCarving(id)
    local c = LP.Character
    if not c then return nil end
    for _, t in ipairs(c:GetChildren()) do
        if t:IsA("Tool") and t:GetAttribute("CarvedWoodTool") == true then
            local tid = t:GetAttribute("CarvedWoodId") or LP:GetAttribute("CarvedWoodId")
            if tid == nil or tostring(tid) == id then return t end
        end
    end
    return nil
end

-- 1. take up to `budget` unpainted carvings into the inventory
local function takeCarvings(ty, budget)
    if budget <= 0 then return false end
    local moved = false
    local fromSpot = FARM.remote("RemoveCarvedWoodFromSaleSpot")
    if fromSpot then
        for _, e in ipairs(FARM.spotUnpainted(ty)) do
            if budget <= 0 or not (FARM.paint and mine()) then break end
            if e.spot:GetAttribute("PlacedWoodId") == e.id then
                standNear(e.spot.Position, 3)
                if not moved then emptyHands() end
                moved = true
                FARM.status.paint = "Taking a carving off " .. e.spot.Name
                local done, res = FARM.invoke(fromSpot, { SpotName = e.spot.Name, TycoonName = ty.Name, ExpectedWoodId = e.id }, 6)
                if done and type(res) == "table" and res.Success == true then
                    FARM.paintHeld[e.id] = { Index = res.AddedIndex, spot = e.spot.Name }
                    budget -= 1
                else
                    -- being checked out by a customer, or gone: leave it for a while
                    FARM.paintSkip[e.id] = os.clock() + 90
                end
                task.wait(0.3)
            end
        end
    end
    local shelf, prompt = FARM.carvedShelf(ty)
    local fromShelf = FARM.remote("RemoveCarvedWoodFromWoodStack")
    if budget > 0 and shelf and fromShelf then
        local ids = FARM.shelfUnpainted(shelf)
        if #ids > 0 then
            standNear(promptAt(prompt, shelf:GetPivot().Position), 5)
            emptyHands()
            moved = true
            for i = 1, math.min(budget, #ids) do
                if not (FARM.paint and mine()) then break end
                FARM.status.paint = "Taking a carving off the lathe shelf"
                local done, res = FARM.invoke(fromShelf, { ItemId = ids[i] }, 6)
                if done and type(res) == "table" and res.Success == true then
                    FARM.paintHeld[ids[i]] = { Index = res.AddedIndex }
                else
                    FARM.paintSkip[ids[i]] = os.clock() + 60   -- the Stocker has it
                end
                task.wait(0.3)
            end
        end
    end
    return moved
end

-- 2. paint what we took, plus unpainted carvings already in the inventory
-- (those stay in the inventory; twelve of them per visit)
local function paintHeld(ty, pm, pmPrompt)
    if FARM.paintLeft(pm) < PAINT_COST then return false end
    local inv = FARM.invUnpainted()
    if next(FARM.paintHeld) == nil and #inv == 0 then return false end
    local invLeft = 12
    local open, fin = FARM.remote("OpenPaintMachine"), FARM.remote("FinishPaintMachine")
    if not (open and fin) then FARM.status.paint = "Paint Machine remotes not found" return false end
    standNear(promptAt(pmPrompt, pm:GetPivot().Position), 4)
    FARM.status.paint = "Opening the Paint Machine"
    local done, res = FARM.invoke(open, { TycoonName = ty.Name, Machine = pm }, 8)
    if done and type(res) == "table" and res.Success == true then
        local listed = {}
        for _, rec in ipairs(type(res.Carvings) == "table" and res.Carvings or {}) do
            local id = type(rec) == "table" and rec.Id ~= nil and tostring(rec.Id)
            local held = id and FARM.paintHeld[id]
            local fromInv = id and not held and invLeft > 0 and not FARM.paintedIds[id] and (FARM.paintSkip[id] or 0) < os.clock()
            if id then listed[id] = true end
            if held or fromInv then
                if held then
                    held.Index = rec.Index or held.Index
                else
                    invLeft -= 1
                end
                if serPainted(rec.Serialized) == true then
                    FARM.paintedIds[id] = true
                elseif FARM.paintLeft(pm) >= PAINT_COST then
                    FARM.status.paint = "Painting"
                    task.wait(0.9)      -- the server rate-limits saves ("Please wait a moment")
                    local d2, r2 = FARM.invoke(fin, { SessionId = res.SessionId, ItemId = rec.Id }, 10)
                    if d2 and type(r2) == "table" and r2.Success == true then
                        FARM.paintedIds[id] = true
                        FARM.stats.painted += 1
                    elseif type(r2) == "table" and r2.Code == "NotEnoughPaint" then
                        FARM.status.paint = "Out of paint (add a Paint Bucket)"
                        break
                    elseif type(r2) == "table" and tostring(r2.Error or ""):lower():find("wait a moment") then
                        -- too fast: nothing wrong with the carving, finish on the next visit
                        FARM.status.paint = "Painting (server asked to slow down)"
                        break
                    else
                        FARM.status.paint = "Paint did not save: " .. tostring(type(r2) == "table" and r2.Error or "no reply")
                        FARM.paintSkip[id] = os.clock() + 300
                    end
                end
            end
        end
        -- held or cached but not offered: the machine only offers unpainted ones
        for id in pairs(FARM.paintHeld) do
            if not listed[id] then FARM.paintedIds[id] = true end
        end
        for _, id in ipairs(inv) do
            if not listed[id] then FARM.paintedIds[id] = true end
        end
    elseif type(res) == "table" and tostring(res.Error or ""):find("No unpainted") then
        for id in pairs(FARM.paintHeld) do FARM.paintedIds[id] = true end
        for _, id in ipairs(inv) do FARM.paintedIds[id] = true end
    else
        FARM.status.paint = "Paint Machine: " .. tostring(type(res) == "table" and res.Error or "no reply")
    end
    return true
end

-- 3. everything we hold goes back on a free sale spot (its own first), or,
-- with every spot taken, on the lathe shelf for the Stocker.
local function putBack(ty)
    if next(FARM.paintHeld) == nil then return false end
    local place = FARM.remote("PlaceCarvedWoodOnSaleSpot")
    local order = {}
    for id, rec in pairs(FARM.paintHeld) do table.insert(order, { id = id, rec = rec }) end
    -- highest inventory slot first, so the slots still to go do not shift
    table.sort(order, function(a, b) return (a.rec.Index or 0) > (b.rec.Index or 0) end)
    emptyHands()
    for _, e in ipairs(order) do
        if not mine() then break end
        local spots = FARM.saleSpots(ty)
        table.sort(spots, function(a, b) return a.Name == e.rec.spot and b.Name ~= e.rec.spot end)
        local ok = false
        for _, s in ipairs(spots) do
            if place and s:GetAttribute("Occupied") ~= true then
                standNear(s.Position, 3)
                FARM.status.paint = "Putting a painted carving on " .. s.Name
                local done, res = FARM.invoke(place, { SpotName = s.Name, TycoonName = ty.Name, WoodId = e.id, Index = e.rec.Index }, 6)
                ok = done and type(res) == "table" and res.Success == true
                if ok or not (type(res) == "table" and tostring(res.Error or ""):lower():find("spot")) then break end
            end
        end
        if ok then
            FARM.paintHeld[e.id] = nil
            FARM.stats.restocked += 1
        end
        task.wait(0.2)
    end
    if next(FARM.paintHeld) == nil then return true end

    local shelf, prompt = FARM.carvedShelf(ty)
    local slot = FARM.remote("SetCarvedWoodSlot")
    if not (shelf and prompt and slot) then return true end
    standNear(promptAt(prompt, shelf:GetPivot().Position), 5)
    for id, rec in pairs(FARM.paintHeld) do
        if not mine() then break end
        if shelf:GetAttribute("WoodStackFull") == true then
            FARM.status.paint = "Spots and shelf full: painted carvings left in your inventory"
            break
        end
        FARM.status.paint = "Putting a painted carving on the lathe shelf"
        local before = tonumber(shelf:GetAttribute("StoredCount")) or 0
        local ok = false
        local done, res = FARM.invoke(slot, { Action = "activate", Id = id, Index = rec.Index }, 6)
        if done and type(res) == "table" and res.Success == true then
            local t0 = os.clock()
            while not (heldCarving(id) and prompt.Enabled) and os.clock() - t0 < 3 do task.wait(0.05) end
            if prompt.Enabled then
                pcall(fireproximityprompt, prompt)
                t0 = os.clock()
                while (tonumber(shelf:GetAttribute("StoredCount")) or 0) <= before and os.clock() - t0 < 2 do task.wait(0.05) end
                ok = (tonumber(shelf:GetAttribute("StoredCount")) or 0) > before
            end
        end
        if ok then
            FARM.paintHeld[id] = nil
            FARM.stats.restocked += 1
        else
            rec.tries = (rec.tries or 0) + 1
            if rec.tries >= 3 then
                FARM.paintHeld[id] = nil     -- stays in the inventory; do not loop on it
                FARM.status.paint = "A carving would not go back out (left in your inventory)"
            end
        end
        task.wait(0.2)
    end
    FARM.invoke(slot, { Action = "deactivate" }, 4)
    return true
end

function FARM.paintPass(ty)
    local pm, pmPrompt = FARM.paintMachine(ty)
    if not pm then FARM.status.paint = "Paint Machine not unlocked" return false end
    -- no more than the tank can paint, four at a time
    local budget = math.min(4, math.floor(FARM.paintLeft(pm) / PAINT_COST + 1e-6)) - paintHeldCount()
    local moved = takeCarvings(ty, budget)
    moved = paintHeld(ty, pm, pmPrompt) or moved
    moved = putBack(ty) or moved
    local s = FARM.status.paint
    if s:find("^Painting") or s:find("^Putting") or s:find("^Taking") or s:find("^Opening") then
        FARM.status.paint = ("Done (%d painted)"):format(FARM.stats.painted)
    end
    return moved
end

--- stock -------------------------------------------------------------------------
-- Auto Stock: every PAINTED carving in the inventory goes on an open sale spot.
-- PlaceCarvedWoodOnSaleSpot {SpotName, TycoonName, WoodId = carving Id, Index}
-- (verified live 2026-09-26) -> {Success, RemovedIndex, ReindexedAssignments}.
-- Index is the carving's position in Hotbar.CachedData.Inventory.Carved; the
-- ones after it shift down, so each pass places highest index first. The cache
-- can lag behind, so every placement is checked on the spot itself.
FARM.stock = false
FARM.stockPlaced = {}       -- carving id -> os.clock() it was placed (ignore stale cache rows)
FARM.status.stock = "Off"
FARM.stats.stocked = 0

local function carvedCache()
    local ok, carved = pcall(function()
        local C = require(game:GetService("ReplicatedFirst"):FindFirstChild("Client"))
        return C.UI.MainComponent._Maid.PrimaryElements.Hotbar.CachedData.Inventory.Carved
    end)
    return ok and type(carved) == "table" and carved or nil
end

-- Painted carvings in the inventory: { {id, index} }, highest index first.
function FARM.invPainted()
    local out, now = {}, os.clock()
    local carved = carvedCache()
    if not carved then return out end
    for i, e in ipairs(carved) do
        local id = type(e) == "table" and e.Id ~= nil and tostring(e.Id)
        -- Keep (Fall Update) protects a carving from being sold; the game's own
        -- UI refuses to put one on a sale spot, so never stock it either.
        if id and e.Keep ~= true and now - (FARM.stockPlaced[id] or -1e9) > 600 and (FARM.paintSkip[id] or 0) < now
        and type(e.Serialized) == "string" then
            local key = id .. #e.Serialized
            local p = invSeen[key]
            if p == nil then
                p = serPainted(e.Serialized) == true
                invSeen[key] = p
            end
            if p then table.insert(out, { id = id, index = i }) end
        end
    end
    table.sort(out, function(a, b) return a.index > b.index end)
    return out
end

local function freeSpots(ty)
    local out = {}
    for _, s in ipairs(FARM.saleSpots(ty)) do
        if s:GetAttribute("Occupied") ~= true then table.insert(out, s) end
    end
    return out
end

function FARM.stockWants(ty)
    return FARM.stock and #FARM.invPainted() > 0 and #freeSpots(ty) > 0
end

function FARM.stockIdle(ty)
    local n = #FARM.invPainted()
    if n == 0 then return "Idle: no painted carvings in your inventory" end
    if #freeSpots(ty) == 0 then return ("Idle: %d painted waiting, every sale spot is full"):format(n) end
    return ("Idle: %d painted waiting"):format(n)
end

function FARM.stockPass(ty)
    local place = FARM.remote("PlaceCarvedWoodOnSaleSpot")
    if not place then FARM.status.stock = "Sale spot remote not found" return false end
    local items = FARM.invPainted()
    if #items == 0 then FARM.status.stock = FARM.stockIdle(ty) return false end
    local moved, placed = false, 0
    for _, it in ipairs(items) do
        if not (FARM.stock and mine()) or placed >= 10 then break end
        local spot = freeSpots(ty)[1]
        if not spot then FARM.status.stock = "Every sale spot is full" break end
        standNear(spot.Position, 3)
        if not moved then emptyHands() end
        moved = true
        FARM.status.stock = "Stocking " .. spot.Name
        local done, res = FARM.invoke(place, { SpotName = spot.Name, TycoonName = ty.Name, WoodId = it.id, Index = it.index }, 6)
        if done and type(res) == "table" and res.Success == true then
            FARM.stockPlaced[it.id] = os.clock()
            if spot:GetAttribute("PlacedWoodId") ~= nil and tostring(spot:GetAttribute("PlacedWoodId")) ~= it.id then
                -- the slot numbers were out of date: stop until the inventory copy catches up
                FARM.status.stock = "Inventory list out of date; waiting for it to refresh"
                break
            end
            placed += 1
            FARM.stats.stocked += 1
        elseif type(res) == "table" and tostring(res.Error or ""):lower():find("wait a moment") then
            FARM.status.stock = "Stocking (server asked to slow down)"
            break
        else
            FARM.paintSkip[it.id] = os.clock() + 60
            FARM.status.stock = "Could not stock: " .. tostring(type(res) == "table" and res.Error or "no reply")
            break   -- slot numbers may have shifted; re-read next pass
        end
        task.wait(0.5)
    end
    if FARM.status.stock:find("^Stocking %S+$") then
        FARM.status.stock = ("Done (%d stocked)"):format(FARM.stats.stocked)
    end
    return moved
end

--- hand carve ----------------------------------------------------------------------
-- Auto Hand Carve: carves the selected logs at the hand lathe (TycoonRoot.Lathe,
-- WoodLathePrompt) instead of the robot, for the research quest "Manually carve
-- 200 pieces of wood with at least 90% accuracy".
--
-- The lathe's target shape is made on the client (TargetProfile.fromProfile,
-- preset "random", 5-8 features) and sent with the result, so the carving sent
-- here is the target itself: the game's own AccuracyCalculator scores that 100.
-- SetWoodCarvingSession {Active = true, SessionId = "", TycoonName} (near the
--   lathe, empty hands; "Chop a tree to get an uncut log first" with no logs)
--   -> {Success, SessionId, RawWoodVariants = {{Id, WoodId, Mutation,
--   VariantKey, IsMega, Count}}}.
-- SaveCarvedWood {Serialized, TargetSerialized, WoodId, Mutation = VariantKey,
--   VariantId = row Id, SessionId, WorkpieceId = SessionId .. ":" .. n} per log
--   -> {Success, Entry, RawWoodVariants}. Then {Active = false, SessionId}.
-- The lathe (CylinderOptions): Length 6.4, Radius 1, 180 slices.
FARM.handCarve = false
FARM.handGap   = 2          -- s between carvings, about what a quick hand takes
FARM.status.hand = "Off"
FARM.stats.handCarved, FARM.stats.handAcc = 0, nil
local HAND = {}
pcall(function()
    local WC = game:GetService("ReplicatedStorage").Shared.WoodCarving
    HAND.Profile = require(WC.Profile)
    HAND.Target  = require(WC.TargetProfile)
    HAND.Acc     = require(WC.AccuracyCalculator)
end)

function FARM.handLathe(ty)
    local r = ty:FindFirstChild("TycoonRoot")
    local l = r and r:FindFirstChild("Lathe")
    return l, l and l:FindFirstChild("WoodLathePrompt", true)
end

-- A target and a carving that matches it exactly, serialized for the save.
-- Returns serialized, targetSerialized, accuracy (by the game's own calculator).
function FARM.perfectCarving(woodId)
    if not (HAND.Profile and HAND.Target and paintSer) then return nil, nil, "carving modules not loaded" end
    local cur = HAND.Profile.new({ Length = 6.4, Radius = 1, BaseRadius = 1, SliceCount = 180, MinimumRadius = 0 })
    local tgt = HAND.Target.fromProfile(cur, { Preset = "random", MinFeatures = 5, MaxFeatures = 8 })
    cur:LoadRadii(tgt:GetRadii())
    local acc = 100
    if HAND.Acc then
        pcall(function()
            local calc = HAND.Acc.new({ CurrentProfile = cur, TargetProfile = tgt, ReferenceRadius = cur.InitialRadius,
                ProgressExponent = 1, OvercutMeanWeight = 1.4, OvercutSquaredWeight = 2.4,
                RuinedSliceWeight = 1.25, SevereOvercutFraction = 0.35 })
            calc:Calculate()
            acc = calc:GetAccuracy()
        end)
    end
    local s1, e1 = paintSer.SerializeCarvedLog(cur, { WoodId = woodId })
    local s2, e2 = paintSer.SerializeCarvedLog(tgt, { WoodId = woodId })
    if not (s1 and s2) then return nil, nil, tostring(e1 or e2) end
    return s1, s2, acc
end

-- Which lathe rows (log variants on hand) this may carve: the Logs to Carve
-- picks, the Mega / mutated switches, and never a log a delivery still needs.
local function handRowOk(row)
    if type(row) ~= "table" or (tonumber(row.Count) or 0) <= 0 or type(row.WoodId) ~= "string" then return false end
    local wood = row.WoodId:lower()
    if FARM.sprinkler and wood == "bubble" then return false end
    local picked = false
    for tree in pairs(FARM.carveSel) do if tree:lower() == wood then picked = true break end end
    if not picked then return false end
    if row.IsMega == true and not FARM.carveMega then return false end
    local mut = row.Mutation
    if mut ~= nil and mut ~= "None" and mut ~= "" and not FARM.carveMut then return false end
    if FARM.D.carveBlock[wood] and row.IsMega ~= true then return false end
    return true
end

-- The quest line's progress, read off the research board ("12 / 200").
function FARM.handQuest()
    local ok, txt = pcall(function()
        local board = LP.PlayerGui:FindFirstChild("ResearchQuestBoard")
        for _, g in ipairs(board and board:GetDescendants() or {}) do
            if g:IsA("TextLabel") and g.Name == "Title" and g.Text:lower():find("manually carve") then
                local p = g.Parent:FindFirstChild("Progress")
                return p and p.Text
            end
        end
    end)
    return ok and txt or nil
end

function FARM.handWants()
    return FARM.handCarve and next(FARM.carveSel) ~= nil and #FARM.carveLogs() > 0
end

function FARM.handCarvePass(ty)
    if next(FARM.carveSel) == nil then FARM.status.hand = "No logs selected (Logs to Carve)" return false end
    if #FARM.carveLogs() == 0 then FARM.status.hand = "Idle: no selected logs on hand" return false end
    local lathe, prompt = FARM.handLathe(ty)
    if not lathe then FARM.status.hand = "Hand lathe not found" return false end
    local sess, save = FARM.remote("SetWoodCarvingSession"), FARM.remote("SaveCarvedWood")
    if not (sess and save) then FARM.status.hand = "Lathe remotes not found" return false end

    standNear(promptAt(prompt, lathe:GetPivot().Position), 4)
    emptyHands()
    FARM.status.hand = "Opening the lathe"
    local done, res = FARM.invoke(sess, { Active = true, SessionId = "", TycoonName = ty.Name }, 8)
    if not (done and type(res) == "table" and res.Success == true and type(res.SessionId) == "string" and res.SessionId ~= "") then
        FARM.status.hand = "Lathe: " .. tostring(type(res) == "table" and res.Error or "no reply")
        return true
    end
    local sid, rows, n = res.SessionId, res.RawWoodVariants, 0
    local carvedNow = 0
    -- ten per visit, then let the rest of the farm have the character back
    while FARM.handCarve and mine() and carvedNow < 10 do
        local row
        for _, r in ipairs(type(rows) == "table" and rows or {}) do
            if handRowOk(r) then row = r break end
        end
        if not row then break end
        local ser, tser, acc = FARM.perfectCarving(row.WoodId)
        if not ser then FARM.status.hand = "Could not build a carving: " .. tostring(acc) break end
        n += 1
        FARM.status.hand = ("Carving %s (%d%%)"):format(row.WoodId, math.floor((tonumber(acc) or 0) + 0.5))
        task.wait(FARM.handGap)
        local d2, r2 = FARM.invoke(save, {
            Serialized = ser, TargetSerialized = tser,
            WoodId = row.WoodId, Mutation = row.VariantKey or row.Mutation or "None", VariantId = row.Id,
            SessionId = sid, WorkpieceId = sid .. ":" .. n,
        }, 10)
        if d2 and type(r2) == "table" and r2.Success == true then
            carvedNow += 1
            FARM.stats.handCarved += 1
            local e = type(r2.Entry) == "table" and r2.Entry or {}
            FARM.stats.handAcc = tonumber(e.Accuracy or e.Quality) or FARM.stats.handAcc
            if type(r2.RawWoodVariants) == "table" then
                rows = r2.RawWoodVariants
            else
                row.Count = (tonumber(row.Count) or 1) - 1
            end
        else
            FARM.status.hand = "Save refused: " .. tostring(type(r2) == "table" and r2.Error or "no reply")
            break
        end
    end
    FARM.invoke(sess, { Active = false, SessionId = sid, TycoonName = ty.Name }, 5)
    if FARM.status.hand:find("^Carving") or FARM.status.hand:find("^Opening") then
        FARM.status.hand = ("Done (%d carved)"):format(FARM.stats.handCarved)
    end
    return true
end

--- upgrade chips -------------------------------------------------------------------
-- Auto Chips (Fall Update, Shared.ChipSlotConfig): hand carving now and then turns
-- up an Upgrade Chip - at most 3, around the 6-12th, 90-150th and 210-350th hand
-- carving. The game pops a reveal the player has to click, which Auto Hand Carve
-- never does, so this claims it: CollectUpgradeChipDrop RF {} while
-- LocalPlayer.UpgradeChipDropsPending > 0 (not mid-carve, like the game), then
-- closes the game's reveal. A claimed chip is a Tool with GenericItemType
-- UpgradeChipT1..T3; it goes in an empty slot by holding it near
-- TycoonRoot.Decoration.ChipSlots.Pivots.Slot<N> and InvokeServer PlaceChipInSlot
-- {TycoonName, SlotIndex}. A filled slot carries ChipId, and the chip levels up
-- in place (ChipLevel / ChipXp) as the robot lathe works.
FARM.chips = false
FARM.chipBackoff = 0
FARM.status.chips = "Off"
FARM.stats.chipsClaimed, FARM.stats.chipsPlaced = 0, 0
local CHIP_LEVEL = { UpgradeChipT1 = 1, UpgradeChipT2 = 2, UpgradeChipT3 = 3 }

function FARM.chipTools()
    local out = {}
    for _, t in ipairs(tools()) do
        local lvl = CHIP_LEVEL[t:GetAttribute("GenericItemType")]
        if lvl then table.insert(out, { tool = t, level = lvl }) end
    end
    table.sort(out, function(a, b) return a.level > b.level end)
    return out
end

-- {index, part, chip = level or nil} per slot, or nil when the slots are not built.
function FARM.chipSlots(ty)
    local r = ty:FindFirstChild("TycoonRoot")
    local deco = r and r:FindFirstChild("Decoration")
    local model = deco and deco:FindFirstChild("ChipSlots")
    local pivots = model and model:FindFirstChild("Pivots")
    if not pivots or model:GetAttribute("ChipSlotsUnlocked") == false then return nil end
    local out = {}
    for i = 1, 3 do
        local p = pivots:FindFirstChild("Slot" .. i)
        if p and p:IsA("BasePart") then
            table.insert(out, { index = i, part = p, chip = CHIP_LEVEL[p:GetAttribute("ChipId")] })
        end
    end
    return out
end

local function chipPending() return (tonumber(LP:GetAttribute("UpgradeChipDropsPending")) or 0) > 0 end

function FARM.chipsWants(ty)
    if not FARM.chips or os.clock() < FARM.chipBackoff then return false end
    if chipPending() and LP:GetAttribute("WoodCarvingActive") ~= true then return true end
    local slots = FARM.chipSlots(ty)
    if not slots or #FARM.chipTools() == 0 then return false end
    for _, s in ipairs(slots) do
        if not s.chip then return true end
    end
    return false
end

function FARM.chipsIdle(ty)
    if os.clock() < FARM.chipBackoff then return FARM.status.chips end
    local slots = FARM.chipSlots(ty)
    if not slots then return "Idle: Chip Slots not built" end
    local filled = 0
    for _, s in ipairs(slots) do if s.chip then filled += 1 end end
    return ("Idle: %d/%d slots filled, %d of 3 chips found"):format(filled, #slots, tonumber(LP:GetAttribute("UpgradeChipsEarned")) or 0)
end

function FARM.chipsPass(ty)
    if os.clock() < FARM.chipBackoff then return false end
    if chipPending() and LP:GetAttribute("WoodCarvingActive") ~= true then
        local rem = FARM.remote("CollectUpgradeChipDrop")
        if rem and rem:IsA("RemoteFunction") then
            FARM.status.chips = "Claiming an Upgrade Chip"
            local done, res = FARM.invoke(rem, {}, 8)
            if done and type(res) == "table" and res.Success == true then
                FARM.stats.chipsClaimed += 1
                FARM.status.chips = "Claimed an Upgrade Chip"
                -- the game's own "chip found" reveal would otherwise sit on screen
                pcall(function()
                    local cd = require(game:GetService("ReplicatedFirst"):FindFirstChild("Client")).ActiveModules.ChipDrops
                    if cd and cd.Reveal then cd:DestroyReveal() end
                end)
                local t0 = os.clock()
                while #FARM.chipTools() == 0 and os.clock() - t0 < 3 do task.wait(0.1) end
            else
                FARM.status.chips = "Chip claim refused: " .. tostring(type(res) == "table" and (res.Error or res.Message) or "no reply")
                FARM.chipBackoff = os.clock() + 30
                return false
            end
        else
            FARM.status.chips = "Chip remote not found"
        end
    end

    local slots = FARM.chipSlots(ty)
    if not slots then FARM.status.chips = "Idle: Chip Slots not built" return false end
    local rem = FARM.remote("PlaceChipInSlot")
    local moved, held = false, false
    for _, s in ipairs(slots) do
        if not (FARM.chips and mine()) then break end
        if not s.chip then
            local c = FARM.chipTools()[1]
            if not c then break end
            if not (rem and rem:IsA("RemoteFunction")) then FARM.status.chips = "Chip slot remote not found" break end
            FARM.goTo(s.part.Position, 4)
            moved = true
            if not equip(c.tool) then FARM.status.chips = "Could not hold the chip" break end
            held = true
            task.wait(0.3)
            FARM.status.chips = ("Placing %s in slot %d"):format(c.tool.Name, s.index)
            local done, res = FARM.invoke(rem, { TycoonName = ty.Name, SlotIndex = s.index }, 8)
            local t0 = os.clock()
            while not CHIP_LEVEL[s.part:GetAttribute("ChipId")] and os.clock() - t0 < 2 do task.wait(0.1) end
            if CHIP_LEVEL[s.part:GetAttribute("ChipId")] then
                FARM.stats.chipsPlaced += 1
                FARM.status.chips = ("Placed a chip in slot %d"):format(s.index)
            else
                FARM.status.chips = "Chip slot refused: " .. tostring(type(res) == "table" and (res.Error or res.Message) or (done and "?" or "no reply"))
                FARM.chipBackoff = os.clock() + 60
                break
            end
        end
    end
    if held then pcall(function() local _, h = root() if h then h:UnequipTools() end end) end
    if FARM.status.chips:find("^Placed") or FARM.status.chips:find("^Claimed") or FARM.status.chips == "Off" then
        FARM.status.chips = FARM.chipsIdle(ty)
    end
    return moved
end

--- weather -------------------------------------------------------------------------
-- Auto Weather: starts a Weather Radar event whenever the radar is ready and the
-- wood chips allow it. WeatherRadarAction RF {Action = "Activate", EventType =
-- "Cosmic" | "HarvestMoon"} within 18 studs of WeatherRadarPrompt (verified live
-- 2026-09-27: "Cosmic started! Spent 35,000 Wood Chips."). Costs from
-- WeatherRadarConfig.Events. Ready when LocalPlayer WeatherRadarCooldownEndsAt
-- (30 min) has passed and ReplicatedStorage says no event is on, starting, or
-- cooling down server-wide.
FARM.weather        = false
FARM.weatherEvent   = "Best"      -- "Best" | "HarvestMoon" | "Cosmic"
FARM.weatherReserve = 0           -- never spend wood chips below this
FARM.status.weather = "Off"
FARM.stats.weathers = 0
local WEATHER = {}
pcall(function() WEATHER.cfg = require(game:GetService("ReplicatedStorage").Shared.WeatherRadarConfig) end)

local function woodChips()
    local ls = LP:FindFirstChild("leaderstats")
    local v = ls and ls:FindFirstChild("Wood Chips")
    return tonumber(v and v.Value) or 0
end

function FARM.weatherPrompt(ty)
    local c = WEATHER.prompt
    if c and c.Parent and c:IsDescendantOf(ty) then return c end
    WEATHER.prompt = ty:FindFirstChild("WeatherRadarPrompt", true)
    return WEATHER.prompt
end

-- The event to start now, or nil and why not.
function FARM.weatherPick(ty)
    local cfg = WEATHER.cfg
    if not cfg then return nil, "Weather config not found" end
    if LP:GetAttribute("WeatherRadarUnlocked") ~= true then return nil, "Weather Radar not unlocked" end
    local RS, now = game:GetService("ReplicatedStorage"), workspace:GetServerTimeNow()
    local ownCd = tonumber(LP:GetAttribute("WeatherRadarCooldownEndsAt")) or 0
    if ownCd > now then return nil, ("Radar cooling down (%s)"):format(FARM.hms(ownCd - now)) end
    if RS:GetAttribute("RadarWeatherEventActive") == true or RS:GetAttribute("RadarWeatherActivating") == true
    or RS:GetAttribute("RadarAdminEventActive") == true then return nil, "A weather event is already on" end
    local srv = tonumber(RS:GetAttribute("RadarWeatherCooldownEndsAt")) or 0
    if srv > now then return nil, ("Server weather cooldown (%s)"):format(FARM.hms(srv - now)) end
    local chips = woodChips() - (FARM.weatherReserve or 0)
    local function cost(id) local e = cfg.Events and cfg.Events[id] return e and tonumber(e.Cost) end
    local order = FARM.weatherEvent == "Best" and { "HarvestMoon", "Cosmic" } or { FARM.weatherEvent }
    for _, id in ipairs(order) do
        local c = cost(id)
        if c and chips >= c then return id end
    end
    local c = cost(order[#order]) or 0
    return nil, ("Waiting for wood chips (%d more)"):format(math.max(0, c - chips))
end

function FARM.weatherWants(ty)
    return FARM.weather and FARM.weatherPick(ty) ~= nil
end

function FARM.weatherPass(ty)
    local id, why = FARM.weatherPick(ty)
    if not id then FARM.status.weather = "Idle: " .. tostring(why) return false end
    local pp = FARM.weatherPrompt(ty)
    local rem = FARM.remote("WeatherRadarAction")
    if not (pp and rem) then FARM.status.weather = "Weather Radar not found" return false end
    standNear(promptAt(pp, pp.Parent:GetPivot().Position), 4)
    FARM.status.weather = "Starting " .. id
    local done, res = FARM.invoke(rem, { Action = "Activate", EventType = id }, 8)
    if done and type(res) == "table" and res.Success == true then
        FARM.stats.weathers += 1
        FARM.status.weather = tostring(res.Message or (id .. " started"))
    else
        FARM.status.weather = "Radar: " .. tostring(type(res) == "table" and (res.Message or res.Error) or "no reply")
    end
    return true
end

--- paint refill --------------------------------------------------------------------
-- Auto Refill Paint: tops the Paint Machine tank up from Paint Buckets in the
-- inventory. Hold the bucket within 12 studs of PaintMachine.PaintFillTarget and
-- DepositPaintBucket RF {Machine} -> {Success, PaintAmount}; +1 (100%) each,
-- 0.5s apart (PaintBucketConfig). Verified live 2026-09-27.
FARM.paintRefill      = false
FARM.paintRefillBelow = 1         -- refill while the tank is under this (1 = 100%)
FARM.status.refill = "Off"
FARM.stats.buckets = 0
local bucketCfg
pcall(function() bucketCfg = require(game:GetService("ReplicatedStorage").Shared.PaintBucketConfig) end)

function FARM.paintBuckets()
    local out = {}
    for _, t in ipairs(tools()) do
        local ok, b = pcall(function() return bucketCfg and bucketCfg.IsBucketTool(t) end)
        if (ok and b) or t:GetAttribute("GenericItemType") == "PaintBucket" then table.insert(out, t) end
    end
    return out
end

function FARM.refillWants(ty)
    if not FARM.paintRefill then return false end
    local pm = FARM.paintMachine(ty)
    return pm ~= nil and FARM.paintLeft(pm) < FARM.paintRefillBelow and #FARM.paintBuckets() > 0
end

function FARM.refillPass(ty)
    local pm = FARM.paintMachine(ty)
    if not pm then FARM.status.refill = "Paint Machine not unlocked" return false end
    local rem = FARM.remote("DepositPaintBucket")
    local tgt = pm:FindFirstChild("PaintFillTarget", true)
    if not (rem and tgt) then FARM.status.refill = "Paint tank not found" return false end
    local pct = math.floor(FARM.paintLeft(pm) * 100 + 0.5)
    if FARM.paintLeft(pm) >= FARM.paintRefillBelow then FARM.status.refill = ("Idle: tank %d%%"):format(pct) return false end
    if #FARM.paintBuckets() == 0 then FARM.status.refill = ("Idle: no Paint Buckets (tank %d%%)"):format(pct) return false end
    local moved = false
    while FARM.paintRefill and mine() and FARM.paintLeft(pm) < FARM.paintRefillBelow do
        local b = FARM.paintBuckets()[1]
        if not b then FARM.status.refill = "Out of Paint Buckets" break end
        if not moved then
            standNear(Vector3.new(tgt.Position.X, pm:GetPivot().Position.Y, tgt.Position.Z), 5)
            moved = true
        end
        if not equip(b) then FARM.status.refill = "Could not hold the bucket" break end
        FARM.status.refill = "Adding a Paint Bucket"
        -- Quantity is new in the Fall Update (the game asks GetPaintBucketDepositState
        -- first); a missing one still pours 1, but send it like the game does.
        local done, res = FARM.invoke(rem, { Machine = pm, Quantity = 1 }, 6)
        if done and type(res) == "table" and res.Success == true then
            FARM.stats.buckets += 1
        else
            FARM.status.refill = "Tank refused the bucket: " .. tostring(type(res) == "table" and (res.Error or res.Message) or "no reply")
            break
        end
        task.wait(0.6)
    end
    pcall(function() local _, h = root() if h then h:UnequipTools() end end)
    if FARM.status.refill == "Adding a Paint Bucket" then
        FARM.status.refill = ("Tank at %d%%"):format(math.floor(FARM.paintLeft(pm) * 100 + 0.5))
    end
    return moved
end

--- giga sprinkler --------------------------------------------------------------------
-- Auto Sprinkler: keeps one planter growing Bubble trees, fells them, and feeds
-- every Bubble log into the GIGA planter's sprinkler (TycoonExpansion2.
-- SprinklerUpgrade, 8x growth for 120s per log, 3600s per Mega Bubble log).
-- InsertGigaSprinklerLog RF {Model = SprinklerUpgrade, Input = DropHere.
-- SprinklerInput, Tool = the log tool, Quantity} within 22 studs (from
-- ReplicatedFirst.Client.GigaSprinklers; not yet verified live). While on, Bubble
-- logs are kept out of Auto Carve / Hand Carve and the chosen planter out of
-- Auto Plant.
FARM.sprinkler    = false
FARM.sprinklerIdx = nil         -- the dedicated planter's PlanterIndex (picked automatically)
FARM.status.sprinkler = "Off"
FARM.stats.sprinkled = 0

function FARM.sprinklerModel(ty)
    local r = ty:FindFirstChild("TycoonRoot")
    local e = r and r:FindFirstChild("TycoonExpansion2")
    local m = e and e:FindFirstChild("SprinklerUpgrade")
    local input = m and m:FindFirstChild("SprinklerInput", true)
    if not (m and input and m:GetAttribute("GigaPlanterSprinklerUnlocked") ~= false) then return nil end
    return m, input
end

function FARM.bubbleLogs()
    local out = {}
    for _, t in ipairs(tools()) do
        local id = t:GetAttribute("RawWoodId") or t:GetAttribute("WoodId")
        if t:GetAttribute("RawWoodTool") == true and tostring(id or ""):lower() == "bubble"
        and (tonumber(t:GetAttribute("RawWoodCount")) or 0) > 0 then table.insert(out, t) end
    end
    return out
end

local function bubbleSeed()
    for _, t in ipairs(tools()) do
        if t:GetAttribute("TreeSeed") == true and t:GetAttribute("TreeType") == "Bubble"
        and t:GetAttribute("MegaSeedId") == nil and not CW.isMega(t) then return t end
    end
    return nil
end

-- The dedicated planter: the one picked before if it still exists, else one
-- already growing Bubble, else the first empty one.
function FARM.sprinklerPlanter(ty)
    local r = ty:FindFirstChild("TycoonRoot")
    local folder = r and r:FindFirstChild("Planters")
    if not folder then return nil end
    local list = {}
    for _, m in ipairs(folder:GetChildren()) do
        if m:GetAttribute("TreePlanter") == true and m:GetAttribute("MegaPlanter") ~= true
        and tonumber(m:GetAttribute("PlanterIndex")) and m:GetAttribute("TreePlanterVisible") ~= false then
            table.insert(list, m)
        end
    end
    table.sort(list, function(a, b) return a:GetAttribute("PlanterIndex") < b:GetAttribute("PlanterIndex") end)
    for _, m in ipairs(list) do
        if m:GetAttribute("PlanterIndex") == FARM.sprinklerIdx then return m end
    end
    for _, m in ipairs(list) do
        if m:GetAttribute("TreeType") == "Bubble" and m:GetAttribute("TreePlanterStatus") ~= "Empty" then
            FARM.sprinklerIdx = m:GetAttribute("PlanterIndex") return m
        end
    end
    for _, m in ipairs(list) do
        if m:GetAttribute("TreePlanterStatus") == "Empty" then
            FARM.sprinklerIdx = m:GetAttribute("PlanterIndex") return m
        end
    end
    return nil
end

local function choppable(model)
    for _, d in ipairs(model:GetChildren()) do
        if d:IsA("Model") and CS:HasTag(d, "ChoppableTree") and d:GetAttribute("TreeFelling") ~= true then return d end
    end
    return nil
end

function FARM.sprinklerWants(ty)
    if not FARM.sprinkler then return false end
    if #FARM.bubbleLogs() > 0 and FARM.sprinklerModel(ty) then return true end
    local p = FARM.sprinklerPlanter(ty)
    if not p then return false end
    local st = p:GetAttribute("TreePlanterStatus")
    if st == "Mature" then return p:GetAttribute("TreeType") == "Bubble" or choppable(p) ~= nil end
    return st == "Empty" and bubbleSeed() ~= nil and (FARM.plantBackoff[p] or 0) < os.clock()
end

function FARM.sprinklerPass(ty)
    local moved = false
    local p = FARM.sprinklerPlanter(ty)
    -- 1. fell the Bubble tree once it is grown
    if p and p:GetAttribute("TreePlanterStatus") == "Mature" then
        local tree = choppable(p)
        local hitRem = FARM.remote("AxeHit")
        if tree and hitRem then
            FARM.status.sprinkler = "Chopping the Bubble tree"
            FARM.forceChop = true
            local ok = pcall(FARM.chopOne, ty, { planter = p, tree = tree }, hitRem)
            FARM.forceChop = false
            moved = true
            if not ok then FARM.status.sprinkler = "Could not chop the Bubble tree" end
        end
    end
    -- 2. every Bubble log into the sprinkler
    local model, input = FARM.sprinklerModel(ty)
    local rem = FARM.remote("InsertGigaSprinklerLog")
    if model and rem and #FARM.bubbleLogs() > 0 then
        standNear(input.Position, 5)
        moved = true
        for _ = 1, 20 do
            if not (FARM.sprinkler and mine()) then break end
            local log = FARM.bubbleLogs()[1]
            if not log then break end
            local n = tonumber(log:GetAttribute("RawWoodCount")) or 1
            if not equip(log) then FARM.status.sprinkler = "Could not hold the Bubble log" break end
            FARM.status.sprinkler = ("Feeding %d Bubble log%s to the sprinkler"):format(n, n == 1 and "" or "s")
            local done, res = FARM.invoke(rem, { Model = model, Input = input, Tool = log, Quantity = n }, 8)
            if done and type(res) == "table" and res.Success == true then
                FARM.stats.sprinkled += n
                task.wait(math.min(4, 0.5 + 0.3 * n))    -- the throw animation
            else
                FARM.status.sprinkler = "Sprinkler refused: " .. tostring(type(res) == "table" and (res.Message or res.Error) or "no reply")
                break
            end
        end
        pcall(function() local _, h = root() if h then h:UnequipTools() end end)
    elseif not model and #FARM.bubbleLogs() > 0 then
        FARM.status.sprinkler = "GIGA sprinkler not unlocked"
    end
    -- 3. replant Bubble
    p = FARM.sprinklerPlanter(ty)
    if p and p:GetAttribute("TreePlanterStatus") == "Empty" then
        local seed = bubbleSeed()
        local plantRem = FARM.remote("PlantSeedFromInventory")
        if not seed then
            FARM.status.sprinkler = "Waiting for a Bubble seed (planter " .. tostring(p:GetAttribute("PlanterIndex")) .. ")"
        elseif plantRem and (FARM.plantBackoff[p] or 0) < os.clock() then
            standNear(p:GetPivot().Position, 6)
            moved = true
            FARM.status.sprinkler = "Planting Bubble in planter " .. tostring(p:GetAttribute("PlanterIndex"))
            FARM.invoke(plantRem, { PlanterIndex = p:GetAttribute("PlanterIndex"), TreeType = "Bubble", TycoonName = ty.Name })
            local t0 = os.clock()
            while p:GetAttribute("TreePlanterStatus") == "Empty" and os.clock() - t0 < 2 do task.wait(0.1) end
            if p:GetAttribute("TreePlanterStatus") == "Empty" then
                FARM.plantBackoff[p] = os.clock() + 20
                FARM.status.sprinkler = "Planter refused the Bubble seed"
            end
        end
    end
    if FARM.status.sprinkler:find("^Feeding") or FARM.status.sprinkler:find("^Planting") or FARM.status.sprinkler:find("^Chopping") then
        FARM.status.sprinkler = ("Done (%d logs fed)"):format(FARM.stats.sprinkled)
    elseif not moved then
        local ok, why = pcall(FARM.sprinklerIdle, ty)
        FARM.status.sprinkler = ok and why or FARM.status.sprinkler
    end
    return moved
end

function FARM.sprinklerIdle(ty)
    local p = FARM.sprinklerPlanter(ty)
    local left = 0
    local m = FARM.sprinklerModel(ty)
    if m then left = (tonumber(m:GetAttribute("GigaSprinklerWaterEndsAt")) or 0) - workspace:GetServerTimeNow() end
    local water = left > 0 and ("water %s"):format(FARM.hms(left)) or "no water"
    if not p then return "Idle: waiting for a planter to free up for Bubble (" .. water .. ")" end
    local st = p:GetAttribute("TreePlanterStatus")
    if st == "Empty" then return ("Idle: planter %d waiting for a Bubble seed (%s)"):format(p:GetAttribute("PlanterIndex"), water) end
    return ("Idle: planter %d %s (%s)"):format(p:GetAttribute("PlanterIndex"), tostring(st):lower(), water)
end

--- giga energy ---------------------------------------------------------------------
-- Auto Energy Capsule: while the GIGA planter grows, installs a Charged Energy
-- Capsule on its Electrical Pedestal (hold the capsule, fire
-- EnergyCapsuleMountPrompt, 15 studs) and stands on the planter's Button.RedPart
-- until it is used up: 900x growth, 100% drains in 30s (about 8h of growth per
-- capsule; verified live 2026-09-27). Planter attributes: GigaEnergyCapsuleMounted,
-- GigaEnergyButtonState (Idle / Active / MissingCapsule / MissingSeed),
-- GigaEnergyPercentage. Grown tree: chop it and plant the best Mega seed again.
-- No capsules: waits.
FARM.energy = false
FARM.status.energy = "Off"
FARM.stats.capsules = 0

function FARM.energyCapsules()
    local out = {}
    for _, t in ipairs(tools()) do
        if t:GetAttribute("EnergyCapsuleTool") == true and (tonumber(t:GetAttribute("EnergyPercentage")) or 0) > 0 then
            table.insert(out, t)
        end
    end
    table.sort(out, function(a, b) return (tonumber(a:GetAttribute("EnergyPercentage")) or 0) > (tonumber(b:GetAttribute("EnergyPercentage")) or 0) end)
    return out
end

function FARM.energyWants(ty)
    if not FARM.energy then return false end
    local g = FARM.gigaPlanter(ty)
    if not g or g:GetAttribute("GigaPlanterUnlocked") == false then return false end
    local st = g:GetAttribute("TreePlanterStatus")
    if st == "Mature" then return choppable(g) ~= nil end
    if st == "Empty" then return #FARM.megaSeeds() > 0 and (FARM.plantBackoff[g] or 0) < os.clock() end
    return g:GetAttribute("GigaEnergyCapsuleMounted") == true or #FARM.energyCapsules() > 0
end

function FARM.energyPass(ty)
    local g = FARM.gigaPlanter(ty)
    if not g then FARM.status.energy = "GIGA planter not found" return false end
    local st = g:GetAttribute("TreePlanterStatus")
    if st == "Mature" then
        local tree, hitRem = choppable(g), FARM.remote("AxeHit")
        if not (tree and hitRem) then FARM.status.energy = "GIGA tree grown, nothing to chop" return false end
        FARM.status.energy = "Chopping the GIGA tree"
        FARM.forceChop = true
        pcall(FARM.chopOne, ty, { planter = g, tree = tree }, hitRem)
        FARM.forceChop = false
        st = g:GetAttribute("TreePlanterStatus")
        if st ~= "Empty" then return true end
    end
    if st == "Empty" then
        local was = FARM.plantMega
        FARM.plantMega = true
        local ok, moved = pcall(FARM.megaPass, ty)
        FARM.plantMega = was
        FARM.status.energy = g:GetAttribute("TreePlanterStatus") == "Empty" and "GIGA planter empty: no Mega seed planted" or "Planted a new GIGA tree"
        return ok and moved or false
    end

    -- growing: capsule in, then stand on the button until it is used up
    if g:GetAttribute("GigaEnergyCapsuleMounted") ~= true then
        local cap = FARM.energyCapsules()[1]
        if not cap then FARM.status.energy = "Idle: no energy capsules" return false end
        local pp = g:FindFirstChild("EnergyCapsuleMountPrompt", true)
        if not pp then FARM.status.energy = "Electrical pedestal not found" return false end
        standNear(promptAt(pp, g:GetPivot().Position), 4)
        emptyHands()
        if not equip(cap) then FARM.status.energy = "Could not hold the capsule" return true end
        task.wait(0.2)
        FARM.status.energy = "Installing a capsule"
        pcall(fireproximityprompt, pp)
        local t0 = os.clock()
        while g:GetAttribute("GigaEnergyCapsuleMounted") ~= true and os.clock() - t0 < 4 do task.wait(0.1) end
        if g:GetAttribute("GigaEnergyCapsuleMounted") ~= true then
            FARM.status.energy = "The pedestal did not take the capsule"
            pcall(function() local _, h = root() if h then h:UnequipTools() end end)
            return true
        end
        FARM.stats.capsules += 1
    end
    local btn = g:FindFirstChild("Button")
    local red = btn and btn:FindFirstChild("RedPart")
    if not red then FARM.status.energy = "GIGA button not found" return true end
    local spot = red.Position + Vector3.new(0, red.Size.Y / 2 + 3, 0)
    moveTo(spot, spot + Vector3.new(0, 0, -1))
    local t0 = os.clock()
    while FARM.energy and mine() and g:GetAttribute("GigaEnergyCapsuleMounted") == true
    and g:GetAttribute("TreePlanterStatus") == "Growing" and os.clock() - t0 < 45 do
        local r = root()
        if r and (r.Position - spot).Magnitude > 2 then moveTo(spot, spot + Vector3.new(0, 0, -1)) end
        FARM.status.energy = ("Boosting (%d%% left, tree %s)"):format(math.floor(tonumber(g:GetAttribute("GigaEnergyPercentage")) or 0),
            FARM.hms(tonumber(g:GetAttribute("TreeGrowthRemainingSeconds")) or 0))
        task.wait(0.25)
    end
    FARM.status.energy = ("Done (%d capsules, tree %s)"):format(FARM.stats.capsules, FARM.hms(tonumber(g:GetAttribute("TreeGrowthRemainingSeconds")) or 0))
    return true
end

function FARM.energyIdle(ty)
    local g = FARM.gigaPlanter(ty)
    if not g then return "GIGA planter not found" end
    local st = g:GetAttribute("TreePlanterStatus")
    if st == "Empty" then return "Idle: GIGA planter empty, no Mega seeds" end
    if #FARM.energyCapsules() == 0 then return ("Idle: no energy capsules (tree %s)"):format(FARM.hms(tonumber(g:GetAttribute("TreeGrowthRemainingSeconds")) or 0)) end
    return "Idle"
end

--- collect drops ---------------------------------------------------------------------
-- Two kinds of loose pickups, both collected by the game's own client code
-- once you are close enough - so this only has to take you there:
--   Tree drops (wood chips, logs; from a felled tree, the lathe, the chipper):
--     client models in workspace.ClientTreeDropEffects_<UserId>, each marked
--     with a TreeDropClaimId attribute. Chips claim within 13 studs (XZ), logs
--     within 8.5, and only once the server's CollectAfter time has passed; a
--     log that landed on you also wants you to leave its radius and come back.
--   Luck orbs (event bursts that fly out around a character): parts in
--     workspace._ClientLuckOrbEventOrbs, claimed within 9 studs (XZ). They are
--     first come, first served between players, which is why this runs in its
--     own fast loop instead of waiting behind a chop.
-- No remote is sent from here; standing there is enough.
--
-- Priority: chop and replant first, then carve, then collect. Collecting only
-- starts while the farm has nothing to do, and a run gives the character back
-- the moment a tree is ready, a planter can be filled or the lathe has room.
FARM.collect = false
FARM.collectRange = 250         -- studs; ignore anything further than this
FARM.status.collect = "Off"
FARM.stats.collected = 0
FARM.skip = setmetatable({}, { __mode = "k" })  -- inst -> retry after (os.clock)
FARM.fails = setmetatable({}, { __mode = "k" }) -- inst -> failed claims in a row

-- Leave `inst` alone for `secs`. One that keeps failing (3 times) is left for 30
-- minutes, so something that can never be claimed is not chased forever.
function FARM.skipFor(inst, secs)
    local n = (FARM.fails[inst] or 0) + 1
    FARM.fails[inst] = n
    FARM.skip[inst] = os.clock() + (n >= 3 and math.max(secs, 1800) or secs)
end

-- The playable map: workspace.Map.Border (the box inside the mountain ring, about
-- X -174..610, Z -178..697) plus a 40-stud margin; without it, the plots' box
-- plus 300. The devs park test props far outside it (a loose Paint Bucket,
-- crate pedestals, axes, a helicopter... around X -500..-1000), and chasing
-- those kept teleporting the character off the map. Takes a position or an Instance.
local playArea
function FARM.inPlayArea(at)
    if typeof(at) == "Instance" then
        local ok, pos = pcall(function()
            if at:IsA("BasePart") then return at.Position end
            return at:GetPivot().Position
        end)
        at = ok and pos or nil
    end
    if typeof(at) ~= "Vector3" then return false end
    if not playArea then
        local map = workspace:FindFirstChild("Map")
        local border = map and map:FindFirstChild("Border")
        local ok, cf, size = pcall(function() return border:GetBoundingBox() end)
        if ok and cf and size.X > 100 and size.Z > 100 then
            local pad = Vector3.new(40, 0, 40)
            playArea = { lo = cf.Position - size / 2 - pad, hi = cf.Position + size / 2 + pad }
        else
            local lo, hi
            local tys = workspace:FindFirstChild("Tycoons")
            for _, t in ipairs(tys and tys:GetChildren() or {}) do
                local p = t:GetPivot().Position
                lo = lo and lo:Min(p) or p
                hi = hi and hi:Max(p) or p
            end
            if not lo then return true end      -- nothing to measure against yet
            local pad = Vector3.new(300, 0, 300)
            playArea = { lo = lo - pad, hi = hi + pad }
        end
    end
    return at.X >= playArea.lo.X and at.X <= playArea.hi.X and at.Z >= playArea.lo.Z and at.Z <= playArea.hi.Z
        and at.Y > -60 and at.Y < 600
end

-- One mover at a time. The farm worker and the collector both teleport the
-- character; whoever holds this owns it.
FARM.lockOwner = nil
function FARM.acquire(who, timeout)
    local t0 = os.clock()
    while FARM.lockOwner ~= nil and FARM.lockOwner ~= who do
        if os.clock() - t0 > (timeout or 0) then return false end
        task.wait(0.05)
    end
    FARM.lockOwner = who
    return true
end
function FARM.release(who)
    if FARM.lockOwner == who then FARM.lockOwner = nil end
end

local function posOf(inst)
    if inst:IsA("BasePart") then return inst.Position end
    if inst:IsA("Model") then
        local ok, cf = pcall(inst.GetPivot, inst)
        if ok then return cf.Position end
    end
    return nil
end

-- The game's own controllers, read-only. require(ReplicatedFirst.Client) is the
-- same table the game runs on (its CachedRemotes lookup above works off it).
local function gameModule(name)
    local ok, C = pcall(require, game:GetService("ReplicatedFirst"):FindFirstChild("Client"))
    local mods = ok and type(C) == "table" and C.ActiveModules
    return type(mods) == "table" and mods[name] or nil
end

-- Only our own tycoon's ground counts. Other players' trees can land drops in
-- our folder too, hidden and unclaimable, and walking to them is pointless.
local tyBox = { at = 0 }
local function inOwnTycoon(pos)
    if os.clock() - tyBox.at > 10 then
        local ty = CW.tycoon()
        tyBox.at = os.clock()
        tyBox.cf, tyBox.size = nil, nil
        if ty then
            local ok, cf, size = pcall(ty.GetBoundingBox, ty)
            if ok then tyBox.cf, tyBox.size = cf, size end
        end
    end
    if not tyBox.cf then return false end
    local l = tyBox.cf:PointToObjectSpace(pos)
    return math.abs(l.X) <= tyBox.size.X / 2 + 15
       and math.abs(l.Z) <= tyBox.size.Z / 2 + 15
       and math.abs(l.Y) <= tyBox.size.Y / 2 + 60
end

-- A drop the game would really hand us right now, judged the way its own
-- TreeDropEffects:StepDrops judges it: chips lying on the ground ("Physical"),
-- logs hovering, past CollectAfter, not locked by an active manual lathe, and
-- actually visible. Anything else in that folder - mid-homing, retiring, a
-- hidden proxy, someone else's - is not ours to fetch.
local function claimableState(st, now, carving)
    local r = st.Root
    if st.Destroyed or not r or not r.Parent then return false end
    if (tonumber(st.CollectAfter) or 0) > now + 0.3 then return false end
    if r.LocalTransparencyModifier >= 1 then return false end
    if st.Kind == "WoodChips" then
        if st.Mode ~= "Physical" then return false end
        if st.Source == "Lathe" and (not carving or carving.IsLatheActive == true) then return false end
        return true
    elseif st.Kind == "Log" then
        return st.Mode == "Hovering"
    end
    return false
end

-- Everything on the floor waiting for us, as { inst, pos, kind, state }.
function FARM.dropTargets()
    local out = {}
    local now = workspace:GetServerTimeNow()

    local T = gameModule("TreeDropEffects")
    if T and type(T.States) == "table" then
        local carving = gameModule("WoodCarving")
        for _, st in ipairs(T.States) do
            if type(st) == "table" and claimableState(st, now, carving)
            and (FARM.skip[st.Root] or 0) < os.clock() and inOwnTycoon(st.Root.Position) then
                table.insert(out, { inst = st.Root, pos = st.Root.Position, kind = "drop", state = st })
            end
        end
    end

    -- Luck orbs from the game's own list: only ones it would let us claim.
    local L = gameModule("LuckOrbEvents")
    if L and type(L.ActiveOrbs) == "table" then
        for _, v in pairs(L.ActiveOrbs) do
            local o = type(v) == "table" and v.Orb
            if o and o.Parent and not v.Pending and (tonumber(v.ReadyAt) or 0) <= os.clock()
            and o:GetAttribute("Collected") ~= true and (FARM.skip[o] or 0) < os.clock() and FARM.inPlayArea(o.Position) then
                table.insert(out, { inst = o, pos = o.Position, kind = "orb", entry = v })
            end
        end
    end

    -- Event crates (the game's "mystery box" lootboxes): the game's Lootboxes
    -- controller already keeps the ones we may open - an admin-spawned box meant
    -- for someone else's plot is left out of it.
    local LB = gameModule("Lootboxes")
    if LB and type(LB.TrackedLootboxes) == "table" then
        for box in pairs(LB.TrackedLootboxes) do
            if typeof(box) == "Instance" and box.Parent and box:GetAttribute("CarvewoodLootbox") == true
            and box:GetAttribute("Opened") ~= true and (FARM.skip[box] or 0) < os.clock() then
                local pp = box:FindFirstChildWhichIsA("ProximityPrompt", true)
                local pos = posOf(box)
                if pp and pos and FARM.inPlayArea(pos) then table.insert(out, { inst = box, pos = pos, kind = "crate", prompt = pp }) end
            end
        end
    end

    local r = root()
    if not r then return {} end
    local near = {}
    for _, t in ipairs(out) do
        if (t.pos - r.Position).Magnitude <= FARM.collectRange then table.insert(near, t) end
    end
    return near
end

local function gone(t)
    if not t.inst.Parent then return true end
    if t.kind == "orb" then
        return t.entry.Pending == true or t.inst:GetAttribute("Collected") == true
    end
    if t.kind == "crate" then return t.inst:GetAttribute("Opened") == true end
    -- homing / pending / retired: the game has taken it from here
    local st = t.state
    if st.Destroyed then return true end
    if st.Kind == "WoodChips" then return st.Mode ~= "Physical" end
    if st.Kind == "Log" then return st.Mode ~= "Hovering" end
    return true
end

CW.mover = {
    acquire = function(who, t) return FARM.acquire(who, t) end,
    release = function(who) FARM.release(who) end,
    moveTo  = function(pos, look) return moveTo(pos, look) end,
    -- anything that outranks rolling: farm work, or something on the floor
    othersWant = function()
        if FARM.lockOwner ~= nil and FARM.lockOwner ~= "roll" then return true end
        if FARM.farmWants() then return true end
        if FARM.collect and #FARM.dropTargets() > 0 then return true end
        if FARM.frenzyWantsMove then return true end
        return false
    end,
}

-- Is there farm work waiting that outranks collecting?
function FARM.farmWants()
    local ty = CW.tycoon()
    if not ty then return false end
    if FARM.chop and #FARM.readyTrees(ty) > 0 then return true end
    if FARM.plant and next(FARM.plantSel) ~= nil and #FARM.emptyPlanters(ty) > 0 and #FARM.plantableSeeds() > 0 then return true end
    if FARM.plant and FARM.plantMega and FARM.gigaReady(ty) and #FARM.megaSeeds() > 0 then return true end
    if FARM.waterWants(ty) then return true end
    if FARM.upkeepWants(ty) then return true end
    if FARM.deliverWants(ty) then return true end
    if FARM.sourceWants(ty) then return true end
    if FARM.shipWants(ty) then return true end
    if FARM.carve and next(FARM.carveSel) ~= nil and ty:GetAttribute("RobotLatheUnlocked") == true then
        local stack = FARM.logStack(ty)
        if stack and not stackFull(stack) and #FARM.carveLogs() > 0 then return true end
    end
    if FARM.paintWants(ty) then return true end
    if FARM.handWants() then return true end
    if FARM.chipsWants(ty) then return true end
    if FARM.buyWants() then return true end
    if FARM.stockWants(ty) then return true end
    if FARM.weatherWants(ty) or FARM.refillWants(ty) or FARM.sprinklerWants(ty) or FARM.energyWants(ty) then return true end
    return false
end

-- Crates: claim, then open. Firing the crate's prompt makes the server answer
-- with the ClientTell "LootboxPrompted" {Type, Owner, Lootbox} (that is what
-- pops the game's box menu); its free Open button then sends OpenLootbox with
-- that same table. Server-to-client tells all arrive on ReplicatedStorage.INF
-- as {Type = "ClientTell", Name, InformationSent}, so this listens there,
-- read-only, and sends OpenLootbox straight through the resolved remote - never
-- through the game's own TellServer (see the note on remotes above).
-- A box on someone else's plot only opens free if you are friends with its
-- owner; the server says so through "LootboxNotice" {Text, IsError}.
function FARM.openCrate(t)
    local box, pp = t.inst, t.prompt
    local r = root()
    if not r then return false, "no character" end
    local anchor = pp.Parent
    local at = (anchor and anchor:IsA("Attachment") and anchor.WorldPosition)
        or (anchor and anchor:IsA("BasePart") and anchor.Position) or t.pos
    local far = (r.Position - at).Magnitude
    local flat = Vector3.new(r.Position.X - at.X, 0, r.Position.Z - at.Z)
    local dir = flat.Magnitude > 0.1 and flat.Unit or Vector3.new(0, 0, 1)
    moveTo(at + dir * 3 + Vector3.new(0, 2.5, 0), at)
    task.wait(far > 60 and 0.8 or 0.3)

    local prompted, notice
    local inf = game:GetService("ReplicatedStorage"):FindFirstChild("INF")
    local conn = inf and inf.OnClientEvent:Connect(function(p)
        if type(p) ~= "table" or p.Type ~= "ClientTell" then return end
        local info = p.InformationSent
        if p.Name == "LootboxPrompted" and type(info) == "table" and info.Lootbox == box then
            prompted = info
        elseif p.Name == "LootboxNotice" and type(info) == "table" and info.IsError == true then
            notice = tostring(info.Text)
        end
    end)
    local function finish(ok, why)
        if conn then conn:Disconnect() end
        return ok, why
    end

    FARM.status.collect = "Claiming crate"
    pcall(fireproximityprompt, pp)
    local t0 = os.clock()
    while not (prompted or notice or gone(t)) and os.clock() - t0 < 3 and mine() do task.wait(0.05) end
    if gone(t) then return finish(true) end
    if not prompted then return finish(false, notice or "prompt got no answer") end

    local open = FARM.remote("OpenLootbox")
    if not (open and open:IsA("RemoteEvent")) then return finish(false, "open remote not found") end
    FARM.status.collect = "Opening crate"
    pcall(function()
        open:FireServer({ Type = prompted.Type, Owner = prompted.Owner, Lootbox = box })
    end)
    t0 = os.clock()
    while not (gone(t) or notice) and os.clock() - t0 < 4 and mine() do task.wait(0.05) end
    if gone(t) then return finish(true) end
    -- a refused open leaves the game's box menu up; put it away
    local LB = gameModule("Lootboxes")
    if LB and type(LB.BoxMenu) == "table" then pcall(function() LB.BoxMenu:Kill() LB.BoxMenu = nil end) end
    return finish(false, notice or "open got no answer")
end

function FARM.collectPass()
    local targets = FARM.dropTargets()
    if #targets == 0 then FARM.status.collect = "Nothing on the floor" return end
    if FARM.farmWants() then FARM.status.collect = "Waiting: farm first" return end
    if not FARM.acquire("collect", 0.5) then FARM.status.collect = "Waiting: farm first" return end

    local r = root()
    local home = r and r.CFrame
    local visited = 0
    while FARM.collect and mine() and visited < 40 and not FARM.farmWants() do
        -- nearest first, re-read every hop: orbs roll, new drops land
        r = root()
        if not r then break end
        local best, bestD
        for _, t in ipairs(FARM.dropTargets()) do
            if not gone(t) then
                local d = (t.pos - r.Position).Magnitude
                if not best or d < bestD then best, bestD = t, d end
            end
        end
        if not best then break end
        visited += 1
        FARM.status.collect = ("Collecting %s (%d left)"):format(best.kind, #FARM.dropTargets())

        if best.kind == "crate" then
            local ok, why = FARM.openCrate(best)
            if ok then
                FARM.stats.collected += 1
                FARM.stats.crates = (FARM.stats.crates or 0) + 1
            else
                -- refused (not friends with the plot's owner, already taken...):
                -- leave it alone for a good while
                FARM.skipFor(best.inst, 120)
                FARM.status.collect = "Crate: " .. tostring(why)
                task.wait(0.5)
            end
            continue
        end

        local stand = best.inst.Position + Vector3.new(0, 2.5, 0)
        moveTo(stand, stand + r.CFrame.LookVector)
        local t0, stepped = os.clock(), false
        while not gone(best) and os.clock() - t0 < 2 and mine() do
            if best.kind == "orb" and best.inst.Parent then
                -- orbs still roll after landing; stay on top of them
                moveTo(best.inst.Position + Vector3.new(0, 2.5, 0))
            elseif best.kind == "drop" and not stepped and os.clock() - t0 > 0.6 then
                -- a log that landed on us wants us to leave and come back
                stepped = true
                moveTo(stand + Vector3.new(12, 0, 0))
                task.wait(0.3)
                moveTo(stand)
            end
            task.wait(0.1)
        end
        if gone(best) then
            FARM.stats.collected += 1
        else
            -- not ready yet (CollectAfter), or it never will be (inventory
            -- full): leave it for a while instead of circling it forever
            FARM.skipFor(best.inst, 20)
        end
    end

    if home and mine() then moveTo(home.Position, home.Position + home.LookVector) end
    FARM.release("collect")
    FARM.status.collect = "Done"
end

--- loop --------------------------------------------------------------------------
-- One worker for every farm job: they share the character (position, tool in hand),
-- so they run one after another, never at once. Chop before plant so a felled
-- tree's planter is refilled on the same pass. After anything that moved the
-- character, it goes back where it was.
-- Only what is switched on, in the order of the menu's pages.
function FARM.statusText()
    local S, N, out = FARM.status, FARM.stats, {}
    local function add(on, name, status, count)
        -- a count is only shown once something has been done
        local c = count ~= nil and tostring(count):find("[1-9]") and ("  (" .. tostring(count) .. ")") or ""
        if on then table.insert(out, ("%s: %s%s"):format(name, tostring(status or "..."), c)) end
    end
    add(CW.on, "Roll", CW.status, CW.stats.rolls .. " rolls")
    add(FARM.plant, "Plant", S.plant, N.planted)
    add(FARM.chop, "Chop", S.chop, N.chopped)
    add(FARM.up("water"), "Water", S.water, N.watered)
    add(FARM.up("fert"), "Fertilize", S.fert, N.fertilized)
    add(FARM.up("canCollect") or FARM.up("fertCollect"), "Upkeep collect", S.gather, N.gathered)
    add(FARM.carve, "Robot lathe", S.carve, N.stored)
    local q = FARM.handQuest()
    add(FARM.handCarve, "Hand carve", S.hand, N.handCarved .. (q and (", quest " .. q) or ""))
    add(FARM.buy, "Gem Store", S.buy, FARM.buyRerolls > 0 and (FARM.buyRerolls .. " rerolls") or nil)
    add(FARM.chips, "Chips", S.chips, (N.chipsClaimed or 0) + (N.chipsPlaced or 0) > 0 and ("%d claimed, %d placed"):format(N.chipsClaimed or 0, N.chipsPlaced or 0) or nil)
    add(FARM.paint, "Paint", S.paint, N.painted)
    add(FARM.paintRefill, "Refill paint", S.refill, N.buckets)
    add(FARM.stock, "Stock", S.stock, N.stocked)
    add(FARM.deliver, "Deliver", S.deliver, ("%d items, %d orders"):format(N.delivered or 0, N.requests or 0))
    add(FARM.deliver, "Shop", S.source, N.bought)
    add(FARM.deliver and FARM.ship, "Truck", S.ship, ("%d boxes, %d trips"):format(N.boxes or 0, N.trips or 0))
    add(FARM.energy, "Energy", S.energy, N.capsules)
    add(FARM.sprinkler, "Sprinkler", S.sprinkler, N.sprinkled)
    add(FARM.collect, "Collect", S.collect, N.collected)
    add(FARM.frenzy, "Frenzy", S.frenzy, N.frenzies)
    add(FARM.weather, "Weather", S.weather, N.weathers)
    return #out > 0 and table.concat(out, "\n") or "Nothing is on."
end

if CW.IN then
    task.spawn(function()
        while STATE.alive() and mine() do
            local extra = FARM.weather or FARM.paintRefill or FARM.sprinkler or FARM.energy or FARM.chips or FARM.buy
            local ty = (FARM.plant or FARM.chop or FARM.carve or FARM.upkeep or FARM.deliver or FARM.handCarve or FARM.paint or FARM.stock or extra) and CW.tycoon()
            local moves = FARM.chop or FARM.carve or FARM.plant or FARM.upkeep or FARM.deliver or FARM.handCarve or FARM.paint or FARM.stock or extra
            -- Re-read the delivery request every tick, even when idle: it is what
