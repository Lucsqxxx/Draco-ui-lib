--=========================================================== Decay
-- Decay Server: a Rust-style survival game. Everything here was read off the
-- game itself (2026-09-24, place version 1019):
--
--   Guns are hitscan. GunShootModule casts from the centre of the screen and
--   sends GunSystem.RemoteEvents.Shot { CameraOrigin, CameraDirection,
--   MuzzleOrigin, ShotId, Slot, ClientTime }; the server re-casts from that
--   camera ray. So the camera ray IS the shot - aim the camera and the shot
--   follows, or rewrite CameraDirection on the way out and it lands elsewhere.
--   The bow is the exception: BowShoot sends the same shape, but the arrow is a
--   projectile (ArrowSpeed 110, gravity x0.25 after 0.35s of straight flight)
--   aimed from the muzzle at wherever the camera ray lands.
--
--   Recoil is purely client side: RecoilConfig.GetRecoil feeds a camera spring.
--   GunShootModule holds the module table itself, so replacing the function on
--   that table takes effect on the next shot.
--
--   The only client anti-cheat is PlayerScripts.Auto: it counts real
--   MouseButton1 presses and reports more than 10 in a second (autoclick). It
--   never looks at aim or movement. Nothing here clicks for you.
--
--   Players carry CustomTeam (0 = no team), IsInSafeZone and Using (the item in
--   hand) as values on the Player. Hunger / Water / Bleeding live in
--   Player.Stats. Loot spawns under "<Kind>Spawn" parts; ores are models
--   (Stone / Metal Ore / Sulfur Ore) under OreSpawns.OreSpawn. The map streams,
--   so only what is near you exists on the client at all.
--
-- All state lives in DK, and the body runs inside its own function: the main
-- chunk is already close to Luau's local register limit.
local DK = { IN = game.GameId == 5000084391, ui = {} }
if DK.IN then (function()
    local RS    = game:GetService("ReplicatedStorage")
    local Guns  = RS:WaitForChild("GunSystem")
    local ShotRemote = Guns.RemoteEvents:WaitForChild("Shot")
    local BowRemote  = Guns.RemoteEvents:WaitForChild("BowShoot")

    DK.on = {
        aimlock = false, rmbOnly = true, silent = false, noRecoil = false,
        showFov = true, visible = true, skipTeam = true, skipSafe = true, npcs = false,
        esp = false, sleepers = false, scientists = false,
        loot = false, ores = false, bags = false, drop = true, airdrop = true,
    }
    DK.fov      = 200      -- px from the crosshair
    DK.smooth   = 0.5      -- 0 = snap, 0.9 = gentle
    DK.aimPart  = "Head"
    DK.maxDist  = 1000     -- the game's own ray length
    DK.lootDist = 400
    DK.lootSel  = { Crate = true, Military = true, Food = true, Locked = true, Keycard = true, Barrel = false }
    DK.oreSel   = { Stone = false, Metal = true, Sulfur = true }

    local okID, ItemData = pcall(require, RS:WaitForChild("ItemData"))
    local function itemInfo(name)
        return okID and type(ItemData) == "table" and ItemData.Items and ItemData.Items[name] or nil
    end
    local function holding()
        local u = LP:FindFirstChild("Using")
        return u and u.Value or ""
    end

    --- folder for every marker we own ---------------------------------------
    function DK.folder()
        if not (DK._folder and DK._folder.Parent) then
            DK._folder = Instance.new("Folder")
            DK._folder.Name = "MonoDecay"
            DK._folder.Parent = (gethui and gethui()) or game:GetService("CoreGui")
        end
        return DK._folder
    end

    --- targets ----------------------------------------------------------------
    local function teamOf(p) local v = p:FindFirstChild("CustomTeam") return v and v.Value or 0 end
    function DK.isMate(p) local a = teamOf(LP) return a ~= 0 and a == teamOf(p) end
    function DK.inSafe(p) local v = p:FindFirstChild("IsInSafeZone") return v ~= nil and v.Value == true end
    local function alive(m)
        local h = m and m:FindFirstChildOfClass("Humanoid")
        return h ~= nil and h.Health > 0
    end
    local function aimPartOf(m)
        if DK.aimPart == "Head" then
            return m:FindFirstChild("Head") or m:FindFirstChild("HumanoidRootPart")
        end
        return m:FindFirstChild("UpperTorso") or m:FindFirstChild("Torso") or m:FindFirstChild("HumanoidRootPart")
    end

    -- Same exclusions the game's own shot uses (own character, camera children
    -- where the viewmodel lives, unplaced building previews), so "visible" here
    -- means "the server's ray reaches it".
    local rayParams = RaycastParams.new()
    rayParams.FilterType = Enum.RaycastFilterType.Exclude
    local function visible(part, model)
        local cam = workspace.CurrentCamera
        local ex = { cam, model }
        if LP.Character then table.insert(ex, LP.Character) end
        local pbs = workspace:FindFirstChild("PlayerBuiltStructures")
        local pre = pbs and pbs:FindFirstChild("PreBuilds")
        if pre then table.insert(ex, pre) end
        rayParams.FilterDescendantsInstances = ex
        local from = cam.CFrame.Position
        return workspace:Raycast(from, part.Position - from, rayParams) == nil
    end

    DK.scientists = {}   -- model -> true, kept by the registry below
    DK.sleepersSet = {}

    local function eachTarget(fn)
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LP and p.Character and alive(p.Character)
                and not (DK.on.skipTeam and DK.isMate(p))
                and not (DK.on.skipSafe and DK.inSafe(p)) then
                fn(p.Character, p)
            end
        end
        if DK.on.npcs then
            for m in pairs(DK.scientists) do
                if m.Parent and alive(m) then fn(m, nil) end
            end
        end
    end

    -- Where to put the crosshair so the shot lands on `part`. Hitscan guns need
    -- no lead; the bow gets travel-time lead and drop compensation using the
    -- game's own arrow numbers.
    function DK.aimPoint(part)
        local pos = part.Position
        local item = itemInfo(holding())
        if item and item.ArrowSpeed then
            local speed    = item.ArrowSpeed
            local g        = workspace.Gravity * (item.ArrowGravityMultiplier or 0.65)
            local straight = item.ArrowStraightTime or 0.2
            local from     = workspace.CurrentCamera.CFrame.Position
            local vel      = part.AssemblyLinearVelocity
            local t        = (pos - from).Magnitude / speed
            for _ = 1, 3 do
                local p2 = part.Position + vel * t
                t = (p2 - from).Magnitude / speed
                pos = p2
            end
            if t > straight then
                local fall = t - straight
                pos = pos + Vector3.new(0, 0.5 * g * fall * fall, 0)
            end
        end
        return pos
    end

    -- Closest target to the crosshair inside the FOV circle.
    function DK.target()
        local cam = workspace.CurrentCamera
        if not cam then return nil end
        local vp = cam.ViewportSize
        local centre = Vector2.new(vp.X / 2, vp.Y / 2)
        local camPos = cam.CFrame.Position
        local best, bestD, bestModel, bestPlayer
        eachTarget(function(m, p)
            local part = aimPartOf(m)
            if not part then return end
            if (part.Position - camPos).Magnitude > DK.maxDist then return end
            local sp, onScreen = cam:WorldToViewportPoint(part.Position)
            if not onScreen or sp.Z <= 0 then return end
            local d = (Vector2.new(sp.X, sp.Y) - centre).Magnitude
            if d > DK.fov or (bestD and d >= bestD) then return end
            if DK.on.visible and not visible(part, m) then return end
            best, bestD, bestModel, bestPlayer = part, d, m, p
        end)
        return best, bestModel, bestPlayer
    end

    --- aimlock ------------------------------------------------------------------
    -- Moves the real mouse. The game's camera is first person with the mouse
    -- locked to the centre, and it rebuilds the camera from its own angles each
    -- frame, so writing Camera.CFrame would be undone; a mouse delta goes
    -- through the same path your hand does.
    local fovCircle
    if Drawing then
        pcall(function()
            fovCircle = Drawing.new("Circle")
            fovCircle.Thickness = 1
            fovCircle.Filled = false
            fovCircle.Transparency = 0.6
            fovCircle.Color = Color3.fromRGB(255, 255, 255)
            fovCircle.Visible = false
        end)
    end
    STATE.onCleanup(function() if fovCircle then pcall(function() fovCircle:Remove() end) end end)

    STATE.connect(RunService.RenderStepped, function()
        if not mine() then return end
        local cam = workspace.CurrentCamera
        if not cam then return end
        local vp = cam.ViewportSize
        if fovCircle then
            fovCircle.Visible  = DK.on.showFov and (DK.on.aimlock or DK.on.silent)
            fovCircle.Position = Vector2.new(vp.X / 2, vp.Y / 2)
            fovCircle.Radius   = DK.fov
        end
        if not DK.on.aimlock or not mousemoverel then return end
        if DK.on.rmbOnly and not UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then return end
        if UIS.MouseBehavior ~= Enum.MouseBehavior.LockCenter then return end   -- menu / inventory open
        local part = DK.target()
        if not part then return end
        local sp = cam:WorldToViewportPoint(DK.aimPoint(part))
        -- the bow aims 7.5% of the screen below centre
        local cy = vp.Y / 2 + ((itemInfo(holding()) or {}).ArrowSpeed and vp.Y * 0.075 or 0)
        local k = 1 - math.clamp(DK.smooth, 0, 0.95)
        mousemoverel((sp.X - vp.X / 2) * k, (sp.Y - cy) * k)
    end)

    --- silent aim ---------------------------------------------------------------
    -- One __namecall hook per client, installed once and kept on getgenv; it
    -- calls whatever redirect the current Mono run has published there, so a
    -- reload swaps the behaviour instead of stacking a second hook, and unload
    -- just clears the redirect.
    local G = getgenv()
    G.__MonoDecayRemotes = { [ShotRemote] = true, [BowRemote] = true }
    G.__MonoDecayRedirect = function(data)
        if not (DK.on.silent and mine()) or type(data) ~= "table" then return end
        if typeof(data.CameraOrigin) ~= "Vector3" then return end
        local part = DK.target()
        if not part then return end
        local dir = DK.aimPoint(part) - data.CameraOrigin
        if dir.Magnitude > 0.01 then data.CameraDirection = dir.Unit end
    end
    if not G.__MonoDecayHooked and hookmetamethod and getnamecallmethod then
        G.__MonoDecayHooked = true
        local old
        local hook = function(self, ...)
            local redirect = G.__MonoDecayRedirect
            if redirect and not checkcaller() and G.__MonoDecayRemotes[self]
                and getnamecallmethod() == "FireServer" then
                pcall(redirect, (...))
            end
            return old(self, ...)
        end
        old = hookmetamethod(game, "__namecall", newcclosure and newcclosure(hook) or hook)
    end
    STATE.onCleanup(function() G.__MonoDecayRedirect = nil end)

    --- no recoil ------------------------------------------------------------------
    local okRC, Recoil = pcall(require, RS:WaitForChild("RecoilConfig"))
    if okRC and type(Recoil) == "table" and type(Recoil.GetRecoil) == "function" then
        G.__MonoDecayRecoil = G.__MonoDecayRecoil or Recoil.GetRecoil   -- the game's own, kept across reloads
        local original = G.__MonoDecayRecoil
        Recoil.GetRecoil = function(...)
            if DK.on.noRecoil and mine() then return Vector3.zero end
            return original(...)
        end
        STATE.onCleanup(function() Recoil.GetRecoil = original end)
    end

    --- registry: loot, ores, scientists, sleepers --------------------------------
    -- Keyed on the names the game spawns. Crate / keycard / barrel names are
    -- only trusted under a "...Spawn" part, where the loot system puts them;
    -- ore names only under an OreSpawn ("Stone" alone is far too common).
    local LOOT = {
        ["Crate"]          = { cat = "Crate",    label = "Crate",          color = Color3.fromRGB(210, 170, 110), spawned = true },
        ["Military Crate"] = { cat = "Military", label = "Military Crate", color = Color3.fromRGB(120, 200, 90),  spawned = true },
        ["Food Crate"]     = { cat = "Food",     label = "Food Crate",     color = Color3.fromRGB(240, 210, 90),  spawned = true },
        ["Locked Crate"]   = { cat = "Locked",   label = "Locked Crate",   color = Color3.fromRGB(255, 110, 60) },
        ["Blue Keycard"]   = { cat = "Keycard",  label = "Blue Keycard",   color = Color3.fromRGB(80, 150, 255),  spawned = true },
        ["Green Keycard"]  = { cat = "Keycard",  label = "Green Keycard",  color = Color3.fromRGB(80, 230, 120),  spawned = true },
        ["Red Keycard"]    = { cat = "Keycard",  label = "Red Keycard",    color = Color3.fromRGB(255, 80, 80),   spawned = true },
        ["Barrel"]         = { cat = "Barrel",   label = "Barrel",         color = Color3.fromRGB(150, 150, 155), spawned = true },
        ["Barrel1"]        = { cat = "Barrel",   label = "Barrel",         color = Color3.fromRGB(150, 150, 155), spawned = true },
        ["Barrel2"]        = { cat = "Barrel",   label = "Barrel",         color = Color3.fromRGB(150, 150, 155), spawned = true },
    }
    local ORE = {
        ["Stone"]      = { cat = "Stone",  label = "Stone",  color = Color3.fromRGB(190, 190, 190) },
        ["Metal Ore"]  = { cat = "Metal",  label = "Metal",  color = Color3.fromRGB(200, 120, 90) },
        ["Sulfur Ore"] = { cat = "Sulfur", label = "Sulfur", color = Color3.fromRGB(240, 220, 70) },
    }
    DK.items = {}   -- inst -> { kind = "loot"|"ore"|"bag"|"drop", def = ..., label = fn|string }

    local structures = workspace:FindFirstChild("PlayerBuiltStructures")

    local function classify(d)
        if not (d:IsA("Model") or d:IsA("BasePart")) then return end
        local name, parent = d.Name, d.Parent
        if not parent then return end
        local def = LOOT[name]
        if def then
            if not def.spawned or parent.Name:match("Spawn$") then
                DK.items[d] = { kind = "loot", def = def }
            end
            return
        end
        def = ORE[name]
        if def and parent.Name == "OreSpawn" then
            DK.items[d] = { kind = "ore", def = def }
            return
        end
        if name == "BodyBag" and parent == workspace then
            local pn = d:FindFirstChild("PlayerName")
            DK.items[d] = { kind = "bag", def = { color = Color3.fromRGB(255, 140, 200) },
                label = "Body bag" .. (pn and (": " .. pn.Value) or "") }
        elseif name == "Bag" and parent == workspace then
            local it = d:FindFirstChild("ItemName")
            DK.items[d] = { kind = "bag", def = { color = Color3.fromRGB(255, 190, 230) },
                label = "Bag" .. (it and (": " .. it.Value) or "") }
        elseif name == "Supply Drop" and d:IsA("Model") and parent == workspace then
            DK.items[d] = { kind = "drop", def = { color = Color3.fromRGB(255, 70, 70) }, label = "SUPPLY DROP" }
        elseif name == "Scientist" and d:IsA("Model") then
            DK.scientists[d] = true
        elseif name == "Sleeper" and parent.Name == "SleepingPlayers" then
            DK.sleepersSet[d] = true
        end
    end

    local marks = {}   -- inst -> { bb, label }
    local function unmark(inst)
        local m = marks[inst]
        if m then pcall(function() m.bb:Destroy() end) marks[inst] = nil end
    end
    local function forget(d)
        if DK.items[d] then DK.items[d] = nil end
        DK.scientists[d] = nil
        DK.sleepersSet[d] = nil
        unmark(d)
    end

    task.spawn(function()
        for _, child in ipairs(workspace:GetChildren()) do
            if not mine() then return end
            if child ~= structures and not child:IsA("Terrain") and not child:IsA("Camera")
                and not Players:GetPlayerFromCharacter(child) then
                classify(child)
                for i, d in ipairs(child:GetDescendants()) do
                    classify(d)
                    if i % 4000 == 0 then task.wait() end
                end
            end
        end
    end)
    STATE.connect(workspace.DescendantAdded, function(d)
        if not mine() then return end
        if LOOT[d.Name] or ORE[d.Name] or d.Name == "BodyBag" or d.Name == "Bag"
            or d.Name == "Supply Drop" or d.Name == "Scientist" or d.Name == "Sleeper" then
            -- let the parent chain settle before trusting it
            task.defer(function() if d.Parent then classify(d) end end)
        end
    end)
    STATE.connect(workspace.DescendantRemoving, function(d)
        if DK.items[d] or DK.scientists[d] or DK.sleepersSet[d] or marks[d] then forget(d) end
    end)

    --- markers ----------------------------------------------------------------------
    local function anchorOf(inst)
        if inst:IsA("BasePart") then return inst end
        return inst:FindFirstChild("Head") or inst:FindFirstChild("HumanoidRootPart") or inst.PrimaryPart
            or inst:FindFirstChild("Hitbox") or inst:FindFirstChildWhichIsA("BasePart", true)
    end

    local function mark(inst, anchor, text, color, offset, size)
        local m = marks[inst]
        if not (m and m.bb.Parent) then
            local bb = Instance.new("BillboardGui")
            bb.AlwaysOnTop    = true
            bb.Size           = UDim2.fromOffset(220, 30)
            bb.LightInfluence = 0
            bb.Parent         = DK.folder()
            local tl = Instance.new("TextLabel")
            tl.BackgroundTransparency = 1
            tl.Size                   = UDim2.fromScale(1, 1)
            tl.Font                   = Enum.Font.GothamBold
            tl.TextStrokeTransparency = 0.35
            tl.Parent                 = bb
            m = { bb = bb, label = tl }
            marks[inst] = m
        end
        m.bb.Adornee     = anchor
        m.bb.StudsOffset = Vector3.new(0, offset or 0, 0)
        m.label.TextSize = size or 12
        m.label.Text       = text
        m.label.TextColor3 = color
        m.bb.Enabled     = true
        m.seen           = DK.tick
    end

    -- Players get a Highlight too (there are never more than a couple of dozen;
    -- Roblox stops drawing past ~31, which is why loot only gets text).
    local highlights = {}
    local function clearHighlights()
        for p, hl in pairs(highlights) do pcall(function() hl:Destroy() end) highlights[p] = nil end
    end
    local function highlight(p, c, color)
        local hl = highlights[p]
        if not (hl and hl.Parent) then
            hl = Instance.new("Highlight")
            hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            hl.FillTransparency = 0.7
            hl.OutlineTransparency = 0.1
            hl.Parent = DK.folder()
            highlights[p] = hl
        end
        hl.Adornee = c
        hl.FillColor = color
        hl.OutlineColor = color
        hl.Enabled = true
    end

    local ENEMY = Color3.fromRGB(255, 70, 70)
    local MATE  = Color3.fromRGB(80, 220, 120)
    local SAFE  = Color3.fromRGB(160, 160, 165)
    local SLEEP = Color3.fromRGB(150, 170, 255)
    local NPC   = Color3.fromRGB(255, 150, 60)

    DK.tick = 0
    function DK.render()
        DK.tick += 1
        local myRoot = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
        local here = myRoot and myRoot.Position or workspace.CurrentCamera.CFrame.Position
        local function dist(part) return math.floor((part.Position - here).Magnitude) end

        if DK.on.esp then
            for _, p in ipairs(Players:GetPlayers()) do
                local c = p.Character
                if p ~= LP and c and alive(c) then
                    local a = anchorOf(c)
                    if a then
                        local col = DK.isMate(p) and MATE or (DK.inSafe(p) and SAFE or ENEMY)
                        local hum = c:FindFirstChildOfClass("Humanoid")
                        local held = p:FindFirstChild("Using")
                        held = held and held.Value ~= "" and ("  " .. held.Value) or ""
                        mark(p, a, ("%s  %dhp  %dm\n%s"):format(p.DisplayName, math.floor(hum.Health), dist(a), held), col, 2.6, 14)
                        highlight(p, c, col)
                    end
                end
            end
        else
            clearHighlights()
        end

        if DK.on.scientists then
            for m in pairs(DK.scientists) do
                local a = m.Parent and alive(m) and anchorOf(m)
                if a and dist(a) <= DK.lootDist * 2 then mark(m, a, ("Scientist  %dm"):format(dist(a)), NPC, 2.4, 13) end
            end
        end

        if DK.on.sleepers then
            for m in pairs(DK.sleepersSet) do
                local a = m.Parent and anchorOf(m)
                if a and dist(a) <= DK.lootDist * 2 then
                    local pn = m:FindFirstChild("PlayerName")
                    mark(m, a, ("Sleeper: %s  %dm"):format(pn and pn.Value or "?", dist(a)), SLEEP, 1.5, 12)
                end
            end
        end

        for inst, e in pairs(DK.items) do
            if not inst.Parent then
                DK.items[inst] = nil
            else
                local show =
                    (e.kind == "loot" and DK.on.loot and DK.lootSel[e.def.cat])
                    or (e.kind == "ore" and DK.on.ores and DK.oreSel[e.def.cat])
                    or (e.kind == "bag" and DK.on.bags)
                    or (e.kind == "drop" and DK.on.drop)
                local a = show and anchorOf(inst)
                if a then
                    local d = dist(a)
                    if e.kind == "drop" or d <= DK.lootDist then
                        mark(inst, a, ("%s  %dm"):format(e.label or e.def.label, d), e.def.color, 1.5, e.kind == "drop" and 16 or 13)
                    end
                end
            end
        end

        -- anything not refreshed this pass is off, out of range or gone
        for inst, m in pairs(marks) do
            if m.seen ~= DK.tick then unmark(inst) end
        end
        for p, hl in pairs(highlights) do
            if not (DK.on.esp and p.Parent and p.Character and alive(p.Character)) then
                pcall(function() hl:Destroy() end) highlights[p] = nil
            end
        end
    end

    task.spawn(function()
        while STATE.alive() and mine() do
            pcall(DK.render)
            task.wait(0.25)
        end
    end)

    --- airdrop ------------------------------------------------------------------------
    -- ReplicatedStorage.ActiveSupplyDrop holds where the next drop lands (zero
    -- when none is live). Pin a marker there, and say so.
    local dropValue = RS:FindFirstChild("ActiveSupplyDrop")
    local function dropWaypoint()
        local pos = dropValue and dropValue.Value or Vector3.zero
        if DK._dropAtt then pcall(function() DK._dropAtt:Destroy() end) DK._dropAtt = nil end
        if DK._dropBB then pcall(function() DK._dropBB:Destroy() end) DK._dropBB = nil end
        if not DK.on.airdrop or pos.Magnitude < 1 then return end
        local att = Instance.new("Attachment")
        att.WorldPosition = pos
        att.Parent = workspace.Terrain
        local bb = Instance.new("BillboardGui")
        bb.AlwaysOnTop = true
        bb.Size = UDim2.fromOffset(200, 34)
        bb.LightInfluence = 0
        bb.Adornee = att
        bb.Parent = DK.folder()
        local tl = Instance.new("TextLabel")
        tl.BackgroundTransparency = 1
        tl.Size = UDim2.fromScale(1, 1)
        tl.Font = Enum.Font.GothamBold
        tl.TextSize = 14
        tl.TextStrokeTransparency = 0.3
        tl.TextColor3 = Color3.fromRGB(255, 70, 70)
        tl.Text = "AIRDROP"
        tl.Parent = bb
        DK._dropAtt, DK._dropBB, DK._dropLabel = att, bb, tl
    end
    if dropValue then
        STATE.connect(dropValue.Changed, function(pos)
            if not mine() then return end
            dropWaypoint()
            if DK.on.airdrop and pos.Magnitude > 1 then
                local r = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
                local d = r and math.floor((pos - r.Position).Magnitude) or 0
                pcall(function() WindUI:Notify({ Title = "Airdrop", Content = ("Supply drop incoming, %dm away"):format(d), Duration = 6, Icon = "package" }) end)
            end
        end)
        task.spawn(function()
            while STATE.alive() and mine() do
                if DK._dropLabel and DK._dropAtt then
                    local r = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
                    if r then DK._dropLabel.Text = ("AIRDROP  %dm"):format(math.floor((DK._dropAtt.WorldPosition - r.Position).Magnitude)) end
                end
                task.wait(0.5)
            end
        end)
        dropWaypoint()
    end

    STATE.onCleanup(function()
        clearHighlights()
        for inst in pairs(marks) do unmark(inst) end
        if DK._dropAtt then pcall(function() DK._dropAtt:Destroy() end) end
        if DK._folder then pcall(function() DK._folder:Destroy() end) end
    end)

