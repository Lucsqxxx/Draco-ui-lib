    })

    -- WindUI hands a multi dropdown's pick back as a list of labels; accept a
    -- label -> true map too, in case a version does it the other way.
    local function pickToSet(v)
        local set = {}
        if type(v) == "table" then
            for k, x in pairs(v) do
                local label = type(k) == "string" and x == true and k or x
                local tree = FARM.labelType[label]
                if tree then set[tree] = true end
            end
        elseif type(v) == "string" and FARM.labelType[v] then
            set[FARM.labelType[v]] = true
        end
        return set
    end

    -- Multi-pick of "Nx ..." labels -> { [N] = true }, and of fertilizer labels -> ids.
    local function pickTiers(v)
        local set = {}
        local function add(label)
            local m = type(label) == "string" and tonumber(label:match("^(%d+)x"))
            if m then set[m] = true end
        end
        if type(v) == "table" then
            for k, x in pairs(v) do add(type(k) == "string" and x == true and k or x) end
        else
            add(v)
        end
        return set
    end

