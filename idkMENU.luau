--=========================================================== Knife VS Gun DUELS
-- Read off the game (2026-09-24, place version 2182):
--
--   The gun decides its own hit. Modules.ItemTypes.Gun:Shoot casts from your
--   character's pivot toward the mouse (500 studs, skipping near-invisible
--   parts and the lobby weapon displays) and sends
--   Remotes.Weapons.ShootGun:FireServer(serverTime, tool,
--   { HitPosition, Origin, humanoidShot }). Silent aim rewrites HitPosition
--   and humanoidShot on the way out, and only when the target is actually in
--   line of sight from Origin, so the claim is one the game could have made.
--
--   Duels: every player carries a CurrentDuel attribute; the people sharing
--   yours are your opponents.
--
--   Anti-cheat (Controllers.YouGuysAreCringeController): reports you over
--   Remotes.Player.Stop_Looking_Through_My_Game_Files the moment a BodyGyro,
--   BodyMover, BodyForce or BodyVelocity lands in your character. Mono's Fly
--   uses exactly those - do not fly here.
local KG = { IN = game.GameId == 7108384194, ui = {} }
if KG.IN then (function()
    local RS = game:GetService("ReplicatedStorage")
    local ShootGun = RS:WaitForChild("Remotes"):WaitForChild("Weapons"):WaitForChild("ShootGun")

    KG.on = { silent = false, aimlock = false, showFov = true, visible = true, duelOnly = true,
              esp = false, espAll = false }
    KG.fov     = 250
    KG.smooth  = 0.4
    KG.aimPart = "Head"

    local function myDuel() return LP:GetAttribute("CurrentDuel") end
    local function alive(c)
        local h = c and c:FindFirstChildOfClass("Humanoid")
        return h ~= nil and h.Health > 0, h
    end
    function KG.isOpponent(p)
        local d = myDuel()
        return d ~= nil and p:GetAttribute("CurrentDuel") == d
    end

    local function aimPartOf(c)
        if KG.aimPart == "Head" then return c:FindFirstChild("Head") or c:FindFirstChild("HumanoidRootPart") end
        return c:FindFirstChild("UpperTorso") or c:FindFirstChild("Torso") or c:FindFirstChild("HumanoidRootPart")
    end

    -- Same exclusions the gun's own ray makes: your character, near-invisible
    -- parts, and the lobby weapon displays.
    local rp = RaycastParams.new()
    rp.FilterType = Enum.RaycastFilterType.Exclude
    local function lineOfSight(from, part, model)
        local ex = { LP.Character }
        local disp = workspace:FindFirstChild("WeaponDisplays")
        if disp then table.insert(ex, disp) end
        for _ = 1, 8 do
            rp.FilterDescendantsInstances = ex
            local hit = workspace:Raycast(from, (part.Position - from).Unit * 500, rp)
            if not hit then return false end
            if hit.Instance:IsDescendantOf(model) then return true end
            if hit.Instance.Transparency >= 0.99 then
                table.insert(ex, hit.Instance)
            else
                return false
            end
        end
        return false
    end

    -- Closest target to the mouse inside the circle.
    function KG.target()
        local cam = workspace.CurrentCamera
        local mouse = UIS:GetMouseLocation()
        local myChar = LP.Character
        local origin = myChar and myChar:GetPivot().Position
        if not origin then return nil end
        local best, bestD, bestModel, bestHum
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LP and (not KG.on.duelOnly or KG.isOpponent(p)) then
                local c = p.Character
                local ok, hum = alive(c)
                local part = ok and aimPartOf(c)
                if part then
                    local sp, on = cam:WorldToViewportPoint(part.Position)
                    if on then
                        local d = (Vector2.new(sp.X, sp.Y) - mouse).Magnitude
                        if d <= KG.fov and (not bestD or d < bestD)
                            and (not KG.on.visible or lineOfSight(origin, part, c)) then
                            best, bestD, bestModel, bestHum = part, d, c, hum
                        end
                    end
                end
            end
        end
        return best, bestModel, bestHum
    end

    --- silent aim: one hook per client, behaviour published on getgenv -------
    local G = getgenv()
    G.__MonoKGRemote = ShootGun
    G.__MonoKGRedirect = function(data)
        if not (KG.on.silent and mine()) or type(data) ~= "table" then return end
        local part, model, hum = KG.target()
        if not part then return end
        local from = typeof(data.Origin) == "Vector3" and data.Origin or (LP.Character and LP.Character:GetPivot().Position)
        if not from or not lineOfSight(from, part, model) then return end
        data.HitPosition  = part.Position
        data.humanoidShot = hum
    end
    if not G.__MonoKGHooked and hookmetamethod and getnamecallmethod then
        G.__MonoKGHooked = true
        local old
        local hook = function(self, ...)
            local redirect = G.__MonoKGRedirect
            if redirect and self == G.__MonoKGRemote and not checkcaller()
                and getnamecallmethod() == "FireServer" then
                local args = table.pack(...)
                pcall(redirect, args[3])
                return old(self, table.unpack(args, 1, args.n))
            end
            return old(self, ...)
        end
        old = hookmetamethod(game, "__namecall", newcclosure and newcclosure(hook) or hook)
    end
    STATE.onCleanup(function() G.__MonoKGRedirect = nil end)

    --- aimlock + circle ---------------------------------------------------------
    local circle
    if Drawing then
        pcall(function()
            circle = Drawing.new("Circle")
            circle.Thickness = 1
            circle.Filled = false
            circle.Transparency = 0.6
            circle.Color = Color3.fromRGB(255, 255, 255)
            circle.Visible = false
        end)
    end
    STATE.onCleanup(function() if circle then pcall(function() circle:Remove() end) end end)

    STATE.connect(RunService.RenderStepped, function()
        if not mine() then return end
        local mouse = UIS:GetMouseLocation()
        if circle then
            circle.Visible  = KG.on.showFov and (KG.on.silent or KG.on.aimlock)
            circle.Position = mouse
            circle.Radius   = KG.fov
        end
        -- Aimlock drags your real cursor onto the target while you hold
        -- right mouse (the camera does not turn: this game leaves the mouse free).
        if KG.on.aimlock and mousemoverel and UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
            local part = KG.target()
            if part then
                local sp = workspace.CurrentCamera:WorldToViewportPoint(part.Position)
                local k = 1 - math.clamp(KG.smooth, 0, 0.95)
                mousemoverel((sp.X - mouse.X) * k, (sp.Y - mouse.Y) * k)
            end
        end
    end)

    --- ESP ------------------------------------------------------------------------
    local function folder()
        if not (KG._folder and KG._folder.Parent) then
            KG._folder = Instance.new("Folder")
            KG._folder.Name = "MonoKVG"
            KG._folder.Parent = (gethui and gethui()) or game:GetService("CoreGui")
        end
        return KG._folder
    end
    local marks = {}   -- player -> { hl, bb, label }
    local function unmark(p)
        local m = marks[p]
        if m then pcall(function() m.hl:Destroy() end) pcall(function() m.bb:Destroy() end) marks[p] = nil end
    end
    local FOE, OTHER = Color3.fromRGB(255, 70, 70), Color3.fromRGB(200, 200, 205)

    local function render()
        local myRoot = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
        local seen = {}
        if KG.on.esp then
            for _, p in ipairs(Players:GetPlayers()) do
                local foe = KG.isOpponent(p)
                local c = p.Character
                local ok, hum = alive(c)
                if p ~= LP and ok and (foe or KG.on.espAll) then
                    local head = c:FindFirstChild("Head") or c:FindFirstChild("HumanoidRootPart")
                    if head then
                        seen[p] = true
                        local m = marks[p]
                        if not (m and m.hl.Parent and m.bb.Parent) then
                            unmark(p)
                            local hl = Instance.new("Highlight")
                            hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                            hl.OutlineTransparency = 0
                            hl.Parent = folder()
                            local bb = Instance.new("BillboardGui")
                            bb.AlwaysOnTop = true
                            bb.Size = UDim2.fromOffset(220, 32)
                            bb.StudsOffset = Vector3.new(0, 2.8, 0)
                            bb.LightInfluence = 0
                            bb.Parent = folder()
                            local tl = Instance.new("TextLabel")
                            tl.BackgroundTransparency = 1
                            tl.Size = UDim2.fromScale(1, 1)
                            tl.Font = Enum.Font.GothamBold
                            tl.TextSize = 14
                            tl.TextStrokeTransparency = 0.35
                            tl.Parent = bb
                            m = { hl = hl, bb = bb, label = tl }
                            marks[p] = m
                        end
                        local col = foe and FOE or OTHER
                        m.hl.Adornee = c
                        m.hl.FillColor, m.hl.OutlineColor = col, col
                        m.hl.FillTransparency = foe and 0.5 or 0.85
                        m.bb.Adornee = head
                        local held = c:FindFirstChildOfClass("Tool")
                        m.label.Text = ("%s  %dhp  %dm%s"):format(p.DisplayName, math.floor(hum.Health),
                            myRoot and math.floor((head.Position - myRoot.Position).Magnitude) or 0,
                            held and ("\n" .. held.Name) or "")
                        m.label.TextColor3 = col
                    end
                end
            end
        end
        for p in pairs(marks) do if not seen[p] then unmark(p) end end
    end
    task.spawn(function()
        while STATE.alive() and mine() do pcall(render) task.wait(0.15) end
    end)
    STATE.onCleanup(function()
        for p in pairs(marks) do unmark(p) end
        if KG._folder then pcall(function() KG._folder:Destroy() end) end
    end)

    --- ui ---------------------------------------------------------------------------
    local Tab = gamesSection():Tab({ Title = "Knife vs Gun", Icon = "crosshair", IconColor = Color3.fromRGB(255, 255, 255) })
    KG.tab = Tab
    getgenv().__MonoKG = KG     -- handle for tooling / quick toggles
    local function tog(key, cfg)
        cfg.Value = KG.on[key]
        cfg.Callback = function(on) KG.on[key] = on end
        KG.ui[key] = Tab:Toggle(cfg)
    end

    Tab:Paragraph({
        Title = RISKY_TAG .. "  = the server can see it",
        Desc  = "This game's anti-cheat reports any BodyVelocity / BodyGyro / BodyForce in your character, "
             .. "so do NOT use Fly from the Player tab here. Silent Aim tells the server you hit someone "
             .. "you were not pointing at; it only does so when they are in clear line of sight.",
    })

    Tab:Section({ Title = "Aim" })
    tog("silent",  { Title = "Silent Aim  " .. RISKY_TAG, Desc = "Click anywhere: the shot lands on the target closest to your mouse inside the circle.", Icon = "target" })
    tog("aimlock", { Title = "Aimlock", Desc = "Hold right mouse to drag your cursor onto the target.", Icon = "crosshair" })
    KG.ui.smooth = Tab:Slider({
        Title = "Aimlock Smoothing", Value = { Min = 0, Max = 0.9, Default = KG.smooth }, Step = 0.05,
        Callback = function(v) KG.smooth = v end,
    })
    KG.ui.fov = Tab:Slider({
        Title = "Aim Circle", Desc = "Pixels around your mouse.",
        Value = { Min = 30, Max = 800, Default = KG.fov }, Step = 10,
        Callback = function(v) KG.fov = v end,
    })
    tog("showFov",  { Title = "Show Circle", Icon = "circle" })
    KG.ui.aimPart = Tab:Dropdown({ Title = "Aim At", Values = { "Head", "Body" }, Value = KG.aimPart, Callback = function(v) KG.aimPart = v end })
    tog("visible",  { Title = "Visible Only", Desc = "Skip anyone behind a wall.", Icon = "eye" })
    tog("duelOnly", { Title = "Duel Opponents Only", Desc = "Only target people in your current duel.", Icon = "shield" })

    Tab:Section({ Title = "ESP" })
    tog("esp",    { Title = "Opponent ESP", Desc = "Red outline, name, health, distance and weapon for everyone in your duel.", Icon = "scan-eye" })
    tog("espAll", { Title = "Show Everyone", Desc = "Everyone else too, in grey.", Icon = "users" })
end)() end

--=========================================================== Chaos Canyon
-- Workspace.AuthorityMode = Server: the server simulates the character from
-- replicated input, so fly / noclip / speed / teleport are rolled back, and
-- even a half-strength move input comes out at full WalkSpeed. What the client
-- still owns is its own animations, which replicate. An avatar animation pack
-- can use a run for both WalkAnim and RunAnim (this one does), so the character
-- can never look like it is walking. Hold to Walk plays Roblox's standard R15
-- walk (507777826) at Action priority while the key is held - in place when
-- standing still - and mutes the pack's WalkAnim / RunAnim underneath it.
local CC = { IN = game.GameId == 295594, ui = {} }
if CC.IN then (function()
    CC.on = true
    CC.key = "C"
    local holding = false
    local track

    local function animator()
        local c = LP.Character
        local h = c and c:FindFirstChildOfClass("Humanoid")
        return h and h:FindFirstChildOfClass("Animator")
    end
    local function stopWalk()
        if track then pcall(function() track:Stop(0.2) end) track = nil end
    end
    local function startWalk()
        local a = animator()
        if not a then return end
        if track and track.IsPlaying then return end
        local anim = Instance.new("Animation")
        anim.AnimationId = "rbxassetid://507777826"
        track = a:LoadAnimation(anim)
        track.Priority = Enum.AnimationPriority.Action
        track.Looped = true
        track:Play(0.15, 1, 1)
    end

    STATE.connect(UIS.InputBegan, function(input, processed)
        if not mine() or processed or not CC.on then return end
        if UIS:GetFocusedTextBox() or (CC.ui.key and CC.ui.key.Picking) then return end
        if input.KeyCode.Name == CC.key then holding = true startWalk() end
    end)
    STATE.connect(UIS.InputEnded, function(input)
        if input.KeyCode.Name == CC.key then holding = false stopWalk() end
    end)
    STATE.connect(RunService.RenderStepped, function()
        if not (mine() and holding and CC.on) then return end
        local a = animator()
        if not a then return end
        if not (track and track.IsPlaying) then startWalk() end
        for _, t in ipairs(a:GetPlayingAnimationTracks()) do
            if t ~= track and (t.Name == "WalkAnim" or t.Name == "RunAnim") then t:AdjustWeight(0.001, 0.1) end
        end
    end)
    STATE.connect(LP.CharacterAdded, function() holding = false track = nil end)
    STATE.onCleanup(stopWalk)

    local Tab = gamesSection():Tab({ Title = "Chaos Canyon", Icon = "footprints", IconColor = Color3.fromRGB(255, 255, 255) })
    CC.tab = Tab
    Tab:Paragraph({
        Title = "Server-run movement",
        Desc  = "This game runs your character's physics on the server, so fly, noclip, speed and teleport cannot work here. Animations are still yours.",
    })
    Tab:Section({ Title = "Walk" })
    CC.ui.on = Tab:Toggle({
        Title = "Hold to Walk",
        Desc  = "While the key below is held, your character walks instead of runs (in place when standing still), even if your animation pack only has a run.",
        Icon  = "footprints",
        Value = CC.on,
        Callback = function(v) CC.on = v if not v then holding = false stopWalk() end end,
    })
    CC.ui.key = Tab:Keybind({
        Title = "Walk Key",
        Desc  = "Hold it to walk.",
        Value = CC.key,
        Callback = function(k) if k then CC.key = k end end,
    })
end)() end

