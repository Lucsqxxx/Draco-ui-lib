local launchOn   = false
local launching  = false
local flinging   = false
local flingOn    = true
local launchSpeed  = LAUNCH.speed
local flingPower   = FLING.power
local flingLift    = FLING.lift
local flingContact = FLING.contact
local lbv        = nil
local tgtFolder, tgtHighlight

local function clearTargetVis()
    if tgtHighlight then pcall(function() tgtHighlight:Destroy() end) tgtHighlight = nil end
    if tgtFolder   then pcall(function() tgtFolder:Destroy()   end) tgtFolder   = nil end
    setTargetHud(nil)
end

local function showTarget(p)
    if not (p and p.Character) then clearTargetVis() return end
    setTargetHud(p)
    if not (tgtFolder and tgtFolder.Parent) then
        tgtFolder = Instance.new("Folder")
        tgtFolder.Name   = "MonoTarget"
        tgtFolder.Parent = (gethui and gethui()) or game:GetService("CoreGui")
        tgtHighlight = nil
    end
    if not (tgtHighlight and tgtHighlight.Parent) then
        tgtHighlight = Instance.new("Highlight")
        tgtHighlight.DepthMode           = Enum.HighlightDepthMode.AlwaysOnTop
        tgtHighlight.FillTransparency    = 0.4
        tgtHighlight.FillColor           = Color3.fromRGB(255, 255, 255)
        tgtHighlight.OutlineColor        = Color3.fromRGB(255, 255, 255)
        tgtHighlight.OutlineTransparency = 0
        tgtHighlight.Parent              = tgtFolder
    end
    tgtHighlight.Adornee = p.Character
end

-- Nearest living player to the crosshair in screen space. Kinder than a strict
-- camera raycast: you do not have to be pixel-accurate, and it still works when
-- they are behind cover.
local function pickTarget()
    local cam = workspace.CurrentCamera
    if not cam then return nil end
    local centre = cam.ViewportSize / 2
    local best, bestDist

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP and p.Character then
            local thrp = p.Character:FindFirstChild("HumanoidRootPart")
            local hum  = p.Character:FindFirstChildOfClass("Humanoid")
            if thrp and hum and hum.Health > 0 then
                local sp, onScreen = cam:WorldToViewportPoint(thrp.Position)
                if onScreen and sp.Z > 0 then
                    local d = (Vector2.new(sp.X, sp.Y) - centre).Magnitude
                    if d <= LAUNCH.maxPix and (not bestDist or d < bestDist) then
                        best, bestDist = p, d
                    end
                end
            end
        end
    end
    return best
end

local function endLaunch()
    launching = false
    if lbv then pcall(function() lbv:Destroy() end) lbv = nil end
    if hrp and hrp.Parent then
        pcall(function() hrp.AssemblyLinearVelocity = Vector3.zero end)
    end
    -- only undo the rig changes if fly is not also using them
    if not wanted then
        if hum and hum.Parent then pcall(function() hum.PlatformStand = false end) end
        restoreCollision()
    end
    task.delay(0.35, clearTargetVis)
end

-- Phase two. Everything it changes is put back before it returns, because
-- every lever that makes this hit hard also makes US the thing that gets
-- launched if it is left set.
local function doFling(p)
    local c    = p.Character
    local thrp = c and c:FindFirstChild("HumanoidRootPart")
    if not (thrp and hrp and hrp.Parent) then return false end

    -- The approach mover has to go first. A BodyVelocity re-asserts its own
    -- Velocity on the assembly every step, so it would eat the spike written
    -- below before physics ever saw it. Fly's mover gets its MaxForce zeroed
    -- for the same reason rather than being left running: two movers and a
    -- direct velocity write on one assembly just cancel each other out.
    if lbv then pcall(function() lbv:Destroy() end) lbv = nil end
    local savedForce = nil
    if bv and bv.Parent then
        savedForce = bv.MaxForce
        pcall(function() bv.MaxForce = Vector3.zero end)
    end

    flinging = true                     -- stops the fly loop re-noclipping us
    local home       = hrp.CFrame       -- where to put ourselves back after
    local savedProps = hrp.CustomPhysicalProperties

    restoreCollision()                  -- contact is the whole point now
    pcall(function()
        hrp.CustomPhysicalProperties =
            PhysicalProperties.new(FLING.density, 0.3, 0.5, 1, 1)
    end)

    -- Stepped, not Heartbeat: this has to be the state physics integrates, and
    -- on Heartbeat we would be writing it just after the step that needed it.
    local t0 = os.clock()
    while flinging and launching and mine() and STATE.alive() do
        if not (hrp.Parent and thrp.Parent) then break end
        if os.clock() - t0 >= flingContact then break end

        -- Re-seated every step for two reasons: they are usually still moving,
        -- and the CFrame write pins us in place so the velocity set just below
        -- does not carry us straight back out of the overlap we need.
        hrp.CFrame = CFrame.new(thrp.Position - Vector3.new(0, FLING.lowOffset, 0))
        hrp.AssemblyLinearVelocity  = Vector3.new(0, flingLift, 0)
        hrp.AssemblyAngularVelocity = Vector3.one * flingPower

        RunService.Stepped:Wait()
    end

    flinging = false
    pcall(function()
        hrp.AssemblyAngularVelocity  = Vector3.zero
        hrp.AssemblyLinearVelocity   = Vector3.zero
        hrp.CFrame                   = home
        hrp.CustomPhysicalProperties = savedProps
    end)
    if savedForce and bv and bv.Parent then
        pcall(function() bv.MaxForce = savedForce end)
    end
    return true
end

local function startLaunch(p)
    if launching then return false end
    if not grab() then return false end

    launching = true
    showTarget(p)

    if lbv then pcall(function() lbv:Destroy() end) end
    lbv = Instance.new("BodyVelocity")
    lbv.Name     = "LaunchVelocity"
    lbv.MaxForce = Vector3.one * 9e9
    lbv.Velocity = Vector3.zero
    lbv.Parent   = hrp
    hum.PlatformStand = true

    local t0 = os.clock()
    task.spawn(function()
        local arrived = false
        while launching and mine() and STATE.alive() do
            local c    = p.Character
            local thrp = c and c:FindFirstChild("HumanoidRootPart")
            if not (thrp and hrp and hrp.Parent and lbv and lbv.Parent) then break end

            applyNoclip()           -- pass through the scenery on the way in

            local delta = thrp.Position - hrp.Position
            if delta.Magnitude <= LAUNCH.arrive then arrived = true break end
            if os.clock() - t0 > LAUNCH.timeout then break end

            lbv.Velocity = delta.Unit * launchSpeed
            task.wait()
        end
        -- `launching` is still true on a clean arrival and false if they hit Q,
        -- so testing it here doubles as the cancel check: nothing gets flung on
        -- a cancel, and nothing on a timeout either.
        if arrived and flingOn and launching then
            pcall(doFling, p)
        end
        endLaunch()
    end)
    return true
end

-- Live preview of whoever E would hit. Without this the readout only appears
-- once the fling is already under way, which is too late to be worth reading;
-- with it, the panel answers "who am I about to hit" while you are still aiming.
-- 10 Hz, and showTarget reuses its Highlight rather than rebuilding it.
task.spawn(function()
    while STATE.alive() and mine() do
        if launchOn and not launching then
            local ok, pick = pcall(pickTarget)
            if ok then
                if pick then showTarget(pick) else clearTargetVis() end
            end
        end
        task.wait(0.1)
    end
end)

STATE.onCleanup(function()
    launching = false
    flinging  = false
    killHud()
    if lbv then pcall(function() lbv:Destroy() end) lbv = nil end
    -- an unload mid-fling would otherwise leave the rig spinning at 1200 rad/s
    -- with a density-100 torso, which is its own kind of unplayable
    if hrp and hrp.Parent then
        pcall(function()
            hrp.AssemblyAngularVelocity  = Vector3.zero
            hrp.CustomPhysicalProperties = nil
        end)
    end
    clearTargetVis()
end)

-- Declared up here so the Settings tab can read the current bind when it
-- checks for a clash; both are assigned when the UI is built below.
local MasterToggle
local Bind

local function boundKey()
    local v = Bind and Bind.Value
    return typeof(v) == "EnumItem" and v.Name or tostring(v or "")
end

local function setActive(on, fromUI)
    if on == wanted then return end
    wanted = on
    if on then
        attached = attach()       -- may fail; the loop retries every frame
    else
        attached = false
        detach()
    end
    if MasterToggle and not fromUI then
        pcall(function() MasterToggle:Set(wanted) end)
    end
end

--=========================================================== loop
local function direction()
    local cam = workspace.CurrentCamera
    if not cam then return Vector3.zero end
    local cf, d = cam.CFrame, Vector3.zero
    if UIS:IsKeyDown(Enum.KeyCode.W) then d += cf.LookVector  end
    if UIS:IsKeyDown(Enum.KeyCode.S) then d -= cf.LookVector  end
    if UIS:IsKeyDown(Enum.KeyCode.D) then d += cf.RightVector end
    if UIS:IsKeyDown(Enum.KeyCode.A) then d -= cf.RightVector end
    if UIS:IsKeyDown(CFG.upKey)      then d += Vector3.yAxis  end
    if UIS:IsKeyDown(CFG.downKey)    then d -= Vector3.yAxis  end
    return d.Magnitude > 0 and d.Unit or Vector3.zero
end

-- Stepped runs BEFORE the physics step, so the velocity written here is the
-- one physics integrates. On Heartbeat gravity gets a step in first and the
-- character sinks while hovering.
local retired = false

STATE.connect(RunService.Stepped, function(_, dt)
    -- superseded by a newer run: undo our own effects once, then go quiet
    if not mine() then
        if not retired then
            retired = true
            wanted, attached = false, false
            pcall(detach)
        end
        return
    end

    if not wanted then return end

    -- (re)attach whenever the rig is missing or was swapped out from under us
    if not attached or not (bv and bv.Parent and hrp and hrp.Parent and hum and hum.Parent) then
        attached = attach()
        if not attached then return end   -- no rig yet, try again next frame
    end

    -- A fling has just spent real effort turning collision back ON. Re-applying
    -- noclip here every frame would quietly undo that and the fling would land
    -- on nobody.
    if not flinging then applyNoclip() end

    -- a launch is driving the rig with its own mover; two BodyVelocities on one
    -- assembly just fight, so fly holds off until it finishes
    if launching then return end

    local want = speed
    if UIS:IsKeyDown(CFG.boostKey) then want *= CFG.boostMul end

    vel = vel:Lerp(direction() * want, math.clamp(CFG.accel * dt, 0, 1))
    bv.Velocity = vel

    if not hum.PlatformStand then hum.PlatformStand = true end

    local look = workspace.CurrentCamera.CFrame.LookVector
    local flat = Vector3.new(look.X, 0, look.Z)
    if flat.Magnitude > 1e-3 then
        bg.CFrame = CFrame.lookAt(hrp.Position, hrp.Position + flat.Unit)
    end
end)

-- The old character and its movers are gone. Just drop the stale references:
-- the Stepped loop reattaches on its own once the new rig is ready.
STATE.connect(LP.CharacterAdded, function()
    if not mine() then return end
    bv, bg, hrp, hum = nil, nil, nil, nil
    attached = false
    table.clear(collided)
end)

