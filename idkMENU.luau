--- ui ----------------------------------------------------------------------------
-- The frontend's preset sheet: a name box with Save, then one row per saved
-- preset with a star (load on start), Load and Delete. Overwrite and delete
-- ask first. It calls straight into PRESET above.
if PRESET.provider() then
    SettingsTab:Section({ Title = "Presets" })

    PRESET.ui.info = SettingsTab:Paragraph({
        Title = "Game presets",
        Desc  = "Save this game's settings under a name and load them back later.",
    })

    local function report(ok, err, msg)
        notify(ok and msg or err, ok and "check" or "alert-triangle")
    end
    local sheet = WindUI:PresetSheet(SettingsTab, {
        names    = function() return PRESET.names() end,
        autoload = function() return PRESET.read().autoload end,
        exists   = function(n) return PRESET.read().presets[n] ~= nil end,
        save     = function(n) local ok, err = PRESET.save(n) report(ok, err, "Saved " .. tostring(n)) end,
        load     = function(n) local ok, err = PRESET.load(n) report(ok, err, "Loaded " .. tostring(n)) end,
        delete   = function(n) local ok, err = PRESET.delete(n) report(ok, err, "Deleted " .. tostring(n)) end,
        setAutoload = function(n)
            local ok, err = PRESET.setAutoload(n)
            report(ok, err, n and (tostring(n) .. " loads on start") or "Nothing loads on start")
        end,
    })
    PRESET.ui.rebuild = function() sheet.rebuild() end
    PRESET.refreshList()

    -- load on start, once the menu is built
    local auto = PRESET.read().autoload
    if auto then
        task.delay(1, function()
            if not mine() then return end
            local ok, err = PRESET.load(auto)
            notify(ok and ("Loaded " .. auto) or err, ok and "check" or "alert-triangle")
        end)
    end
end

