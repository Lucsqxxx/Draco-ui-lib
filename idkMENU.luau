local sliderQueue, sliderBusy = {}, false
local sliderFinal = {}      -- slider -> last move, re-applied once the queue drains
local function moveSlider(slider, value, apply)
    apply(value)
    if not slider then return end
    local move = { slider = slider, value = value, apply = apply }
    table.insert(sliderQueue, move)
    sliderFinal[slider] = move
    if sliderBusy then return end
    sliderBusy = true
    task.spawn(function()
        while #sliderQueue > 0 do
            local m = table.remove(sliderQueue, 1)
            -- a Set that stalls must not hold up the rest of the queue
            local done = false
            task.spawn(function()
                pcall(function() m.slider:Set(m.value) end)
                done = true
            end)
            local t = os.clock()
            while not done and os.clock() - t < 0.5 do task.wait() end
            m.apply(m.value)
            task.wait(0.1)
        end
        task.wait(0.3)
        for _, m in pairs(sliderFinal) do m.apply(m.value) end
        table.clear(sliderFinal)
        sliderBusy = false
    end)
end

local function flingByName(name)
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Name == name then return startLaunch(p) end
    end
    return false
end

