local MenuKeyBind

local function applyMenuKey(name)
    -- indexing Enum.KeyCode with an unknown name throws, so probe it
    local okCode, code = pcall(function() return Enum.KeyCode[name] end)
    if not okCode or not code then return false end

    menuKeyName = name
    pcall(function() Window:SetToggleKey(code) end)

    -- Two binds on one key would fire both actions on every press.
    if name == boundKey() then
        WindUI:Notify({
            Title    = "Key clash",
            Content  = name .. " is also the No-clip bind. Change one of them.",
            Duration = 6,
            Icon     = "triangle-alert",
        })
    end
    return true
end

MenuKeyBind = SettingsTab:Keybind({
    Title = "Menu Key",
    Desc  = "Click, then press a key to show / hide the menu.",
    Value = DEFAULT_MENU_KEY,
    Callback = function() end,   -- see the watcher below
})

task.spawn(function()
    while STATE.alive() and mine() do
        local v    = MenuKeyBind and MenuKeyBind.Value
        local name = typeof(v) == "EnumItem" and v.Name or tostring(v or "")
        if name ~= "" and name ~= menuKeyName then
            applyMenuKey(name)
        end
        task.wait(0.25)
    end
end)

--=========================================================== hotkey
local function isBind(input)
    if input.UserInputType ~= Enum.UserInputType.Keyboard then return false end
    if Bind and Bind.Picking then return false end        -- they are rebinding
    if UIS:GetFocusedTextBox() then return false end
    return input.KeyCode.Name == boundKey()
end

local DBG = { began = 0, ended = 0, rejected = 0, lastBusy = nil, lastKey = "", lastMode = "" }

STATE.connect(UIS.InputBegan, function(input, busy)
    if not mine() then return end
    if input.UserInputType == Enum.UserInputType.Keyboard
       and input.KeyCode.Name == boundKey() then
        DBG.lastBusy = busy
        DBG.lastKey  = input.KeyCode.Name
        DBG.lastMode = bindMode
    end
    if busy or not isBind(input) then
        if input.UserInputType == Enum.UserInputType.Keyboard
           and input.KeyCode.Name == boundKey() then DBG.rejected += 1 end
        return
    end
    DBG.began += 1
    if bindMode == "Hold" then setActive(true) else setActive(not wanted) end
end)

STATE.connect(UIS.InputEnded, function(input)
    if not mine() then return end
    if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
    if input.KeyCode.Name ~= boundKey() then return end
    DBG.ended += 1
    if bindMode ~= "Hold" then return end
    setActive(false)
end)

--=========================================================== launch keys
STATE.connect(UIS.InputBegan, function(input, busy)
    if not mine() or busy or not launchOn then return end
    if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
    if UIS:GetFocusedTextBox() then return end
    -- never steal a keypress meant for a keybind picker
    if (Bind and Bind.Picking) or (MenuKeyBind and MenuKeyBind.Picking) then return end

    local k = input.KeyCode
    if k == LAUNCH.selectKey then
        if launching then return end
        local p = pickTarget()
        if p then
            startLaunch(p)
        else
            WindUI:Notify({
                Title = "Target Fling", Content = "Nobody in view",
                Duration = 2, Icon = "crosshair",
            })
        end
    elseif k == LAUNCH.cancelKey then
        if launching then
            launching = false          -- the flight loop sees this and stops
        else
            clearTargetVis()
        end
    end
end)

--=========================================================== teardown
local function killGuis()
    local roots = { game:GetService("CoreGui"), LP:FindFirstChild("PlayerGui") }
    if gethui then table.insert(roots, gethui()) end
    for _, root in ipairs(roots) do
        if root then
            for _, g in ipairs(root:GetChildren()) do
                if g.Name == "WindUI" or g.Name == "MonoUI" then pcall(function() g:Destroy() end) end
            end
        end
    end
end

local function unload()
    setActive(false)
    if STATE.teardown then
        STATE.teardown()          -- standalone: runs our cleanups, drops connections
    else
        -- under live-reload the harness owns teardown, so just clear the UI
        pcall(function() Window:Destroy() end)
        killGuis()
    end
end

