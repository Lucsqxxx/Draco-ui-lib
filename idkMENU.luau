-- roleOf is only meaningful in MM2; everywhere else this is just a name.
local function setTargetHud(pl)
    if not pl then
        if hudGui then hudGui.Enabled = false end
        return
    end
    buildHud()

    local role = (game.GameId == MM2_UNIVERSE) and roleOf(pl) or nil
    local col  = (role and (ROLE_COLOR[role] or ROLE_FALLBACK)) or Color3.fromRGB(255, 255, 255)

