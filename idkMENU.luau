    --- Events & pickups ----------------------------------------------------------------------
    CWTab:Section({ Title = "Events" })

    CWTab:Group("Boosts")
    FARM.ui.frenzy = CWTab:Toggle({
        Title = "Auto Frenzy",
        Desc  = "Gold or Rainbow as soon as the clock is ready.",
        Icon  = "zap",
        Value = false,
        Callback = function(on) FARM.frenzy = on if not on then FARM.status.frenzy = "Off" end end,
